// Indexing a NULL pointer is NULL_POINTER_ACCESS on both backends.
FUNCTION Start() AS INTEGER
    LET value AS POINTER TO INTEGER OR NULL = NULL
    value[0] = 1
    RETURN 0
END FUNCTION
