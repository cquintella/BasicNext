IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    LET file AS FS.File OR Error = FS.Open("Cargo.toml", FS.READ)
    IF file IS Error THEN
        PRINT file.Code
    ELSE
        LET line AS STRING OR EOF OR Error = file.ReadLine()
        PRINT line
        file.Close()
        DELETE file
    END IF
END FUNCTION
