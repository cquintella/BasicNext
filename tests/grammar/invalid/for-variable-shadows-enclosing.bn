// A FOR nested inside a FOR of the same variable redeclares a name of an
// enclosing block: DUPLICATE_NAME (0.6.md, "Scopes and bindings").
FUNCTION Start() AS VOID
    FOR j AS INTEGER = 1 TO 2
        FOR j AS INTEGER = 1 TO 2
            PRINT j
        END FOR
    END FOR
END FUNCTION
