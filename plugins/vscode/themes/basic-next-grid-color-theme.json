{
  "name": "Basic Next Grid",
  "type": "dark",
  "colors": {
    "editor.background": "#0B1E24",
    "editor.foreground": "#D6F3F0",
    "editorLineNumber.foreground": "#3A6B73",
    "editorLineNumber.activeForeground": "#5EEAD4",
    "editorCursor.foreground": "#2DD4BF",
    "editor.selectionBackground": "#134E4A88",
    "editor.lineHighlightBackground": "#0F2A3180",
    "editorIndentGuide.background1": "#1F4A52",
    "editorIndentGuide.activeBackground1": "#2DD4BF66",
    "editorWidget.background": "#0F2A31",
    "editorWidget.border": "#134E4A",
    "sideBar.background": "#07161A",
    "sideBar.foreground": "#A7D8D4",
    "activityBar.background": "#061217",
    "activityBar.foreground": "#5EEAD4",
    "statusBar.background": "#0F766E",
    "statusBar.foreground": "#ECFEFF",
    "tab.activeBackground": "#0B1E24",
    "tab.inactiveBackground": "#07161A",
    "tab.activeBorderTop": "#2DD4BF",
    "titleBar.activeBackground": "#061217",
    "panel.background": "#07161A",
    "terminal.background": "#07161A",
    "terminal.foreground": "#D6F3F0",
    "focusBorder": "#2DD4BF",
    "button.background": "#0F766E",
    "button.foreground": "#ECFEFF",
    "list.activeSelectionBackground": "#134E4A",
    "list.hoverBackground": "#0F2A31"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#5B8A8A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FDE68A"
      }
    },
    {
      "scope": [
        "storage.type.function.bn"
      ],
      "settings": {
        "foreground": "#C586C0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.loop.while.bn"
      ],
      "settings": {
        "foreground": "#D7BA7D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.loop.for.bn"
      ],
      "settings": {
        "foreground": "#CE9178",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.loop.repeat.bn"
      ],
      "settings": {
        "foreground": "#DCDCAA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.conditional.bn"
      ],
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.flow.bn"
      ],
      "settings": {
        "foreground": "#F44747"
      }
    },
    {
      "scope": [
        "keyword.control.await.bn"
      ],
      "settings": {
        "foreground": "#B267E6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type.class.bn",
        "storage.type.struct.bn",
        "storage.type.interface.bn"
      ],
      "settings": {
        "foreground": "#4EC9B0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.declaration.bn"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "scope": [
        "support.function.bn"
      ],
      "settings": {
        "foreground": "#A5F3FC"
      }
    },
    {
      "scope": [
        "invalid.illegal.deprecated.delete.bn"
      ],
      "settings": {
        "foreground": "#F44747",
        "fontStyle": "strikethrough bold"
      }
    }
  ]
}
