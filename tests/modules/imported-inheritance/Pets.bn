EXPORT CLASS Animal
    PUBLIC name AS STRING = "animal"

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Speak() AS STRING
        RETURN "animal"
    END FUNCTION
END CLASS
