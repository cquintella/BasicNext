IMPORT BNData AS Data
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    LET frame AS Data.DataFrame = NEW Data.DataFrame()
    LET names AS STRING[2] = ["Ana", "Carlos"]
    frame.AddStringColumn("name", names)
    LET file AS FS.File OR Error = FS.Open("/tmp/basicnext-sprint6-write.csv", FS.WRITE)
    IF file IS Error THEN
        PRINT file.Code
    ELSE
        LET result AS VOID OR Error = Data.WriteCSV(file, frame, TRUE, ",")
        IF result IS Error THEN
            PRINT result.Code
        END IF
        file.Close()
        DELETE file
    END IF
    DELETE frame
END FUNCTION
