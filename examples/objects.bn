

STRUCT 	Location
    X AS INTEGER
    Y AS INTEGER
END STRUCT

END STUCT

CLASS Alien

    LET id AS NUMBER
    LET pos AS Location
    FUNCTION CONSTRUCTOR()


    END FUNCTION
