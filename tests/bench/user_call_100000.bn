// bni benchmark (bucket 0.6.10 F.0): 100000 user-function calls.
FUNCTION Inc(n AS INTEGER) AS INTEGER
    RETURN n + 1
END FUNCTION

FUNCTION Start() AS VOID
    LET s AS INTEGER = 0
    FOR i AS INTEGER = 1 TO 100000
        s = Inc(s)
    END FOR
    PRINT s
END FUNCTION
