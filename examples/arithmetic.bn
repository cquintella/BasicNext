// Arithmetic operators, including 0.5.2 S1 statement forms ++ / --
// (exact sugar for += 1 / -= 1 on integer targets; not expressions —
// PRINT n++ is illegal).

FUNCTION Start() AS VOID
    LET n AS INTEGER = 10
    PRINT "n =", n

    n += 3
    PRINT "n += 3 ->", n
    n -= 2
    PRINT "n -= 2 ->", n
    n *= 2
    PRINT "n *= 2 ->", n
    n = n DIV 2
    PRINT "n = n DIV 2 ->", n
    n %= 3
    PRINT "n %= 3 ->", n

    n = 5
    n++
    PRINT "n++ ->", n
    n--
    PRINT "n-- ->", n

    LET a AS INTEGER[3]
    a[0] = 1
    a[1] = 2
    a[2] = 3
    a[1]++
    PRINT "a[1]++ ->", a[1]
    a[1]--
    PRINT "a[1]-- ->", a[1]

    LET x AS FLOAT = 2.0
    LET y AS FLOAT = 0.5
    PRINT "x / y =", x / y
    PRINT "x ** 3 =", x ** 3.0
END FUNCTION
