INTERFACE Named
    FUNCTION Name() AS STRING
END INTERFACE

CLASS Dog IMPLEMENTS Named, Named
    PUBLIC FUNCTION Name() AS STRING
        RETURN "Puck"
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
END FUNCTION
