INTERFACE Shape
    FUNCTION Name() AS STRING
END INTERFACE

CLASS Base IMPLEMENTS Shape
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Name() AS STRING
        RETURN "base"
    END FUNCTION
END CLASS

CLASS Sub EXTENDS Base
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET s AS Shape = NEW Sub()
    PRINT s.Name()
END FUNCTION
