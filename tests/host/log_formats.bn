// BNLog formats (bnlog.md, "Formats"): the same record as JSON, SYSLOG and
// APACHE on the console, a sensitive field never written, and an unknown
// format refused without changing the current one.
IMPORT HOST.Console AS Console
IMPORT BNLog AS Log

FUNCTION Start() AS INTEGER
    LET fields AS Log.Fields = NEW Log.Fields()
    LET logger AS Log.Logger = NEW Log.Logger()
    LET a AS VOID OR Error = fields.SetString("http.method", "GET")
    LET b AS VOID OR Error = fields.SetString("http.path", "/items?token=1")
    LET c AS VOID OR Error = fields.SetString("http.status", "200")
    LET d AS VOID OR Error = fields.SetString("http.user_agent", "agent \"x\"")
    LET e AS VOID OR Error = fields.SetString("api_key", "s3cret")
    IF a IS Error OR b IS Error OR c IS Error OR d IS Error OR e IS Error THEN
        RETURN 1
    END IF
    LET console AS VOID OR Error = logger.AddConsole(2)
    LET json AS VOID OR Error = logger.Log(2, "as json", fields)
    LET text AS VOID OR Error = logger.SetFormat("SYSLOG")
    LET logged_text AS VOID OR Error = logger.Log(2, "as text", fields)
    LET apache AS VOID OR Error = logger.SetFormat("APACHE")
    LET logged_apache AS VOID OR Error = logger.Log(3, "as apache", fields)
    LET unknown AS VOID OR Error = logger.SetFormat("text")
    IF unknown IS Error THEN
        PRINT unknown.Code = Log.INVALID_ARGUMENT, unknown.Message
    END IF
    LET still AS VOID OR Error = logger.Log(2, "still apache", fields)
    PRINT console IS Error, json IS Error, text IS Error, logged_text IS Error
    PRINT apache IS Error, logged_apache IS Error, still IS Error
    RETURN 0
END FUNCTION
