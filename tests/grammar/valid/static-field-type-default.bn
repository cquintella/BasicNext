CLASS Library
    PUBLIC STATIC shared AS INTEGER
    PUBLIC STATIC anotherShared AS STRING
    PUBLIC STATIC flag AS BOOLEAN
END CLASS

FUNCTION Start() AS VOID
    PRINT Library.shared
    PRINT Library.anotherShared
    PRINT Library.flag
    Library.shared = 10
    PRINT Library.shared
END FUNCTION
