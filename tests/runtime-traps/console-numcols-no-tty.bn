// Runtime trap: Console.NumCols without a terminal. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6). Tests run with
// standard output piped, never a terminal.
IMPORT HOST.Console AS Console
FUNCTION Start() AS INTEGER
    PRINT Console.NumCols()
    PRINT "after"
    RETURN 0
END FUNCTION
