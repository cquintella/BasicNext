IMPORT Pets AS Pets
IMPORT Other AS Other

CLASS Dog IMPLEMENTS Pets.Named
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Name() AS STRING
        RETURN "Puck"
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET named AS Other.Named = NEW Dog()
END FUNCTION
