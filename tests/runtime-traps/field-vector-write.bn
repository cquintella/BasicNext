// Runtime trap: vector field write out of bounds. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
CLASS Holder
    PUBLIC items AS INTEGER[2]
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION Start() AS INTEGER
    LET holder AS Holder = NEW Holder()
    LET at AS INTEGER = 6
    holder.items[at] = 1
    RETURN 0
END FUNCTION
