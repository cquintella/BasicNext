EXPORT CLASS Box
    PRIVATE value AS INTEGER = 0

    PUBLIC FUNCTION CONSTRUCTOR(value AS INTEGER)
        SELF.value = value
    END FUNCTION

    PUBLIC FUNCTION Value() AS INTEGER
        RETURN SELF.value
    END FUNCTION

    PUBLIC STATIC FUNCTION Count() AS INTEGER
        RETURN 1
    END FUNCTION
END CLASS
