// IS of the declared pointer member. The value is NULL, so the pointer
// test is false. The name stays `POINTER TO Log.Logger` (a dot in the
// element must not rewrite the pointer words).
IMPORT BNLog AS Log

FUNCTION Start() AS VOID
    LET pointer AS POINTER TO Log.Logger OR NULL = NULL
    PRINT pointer IS NULL
    PRINT pointer IS POINTER TO Log.Logger
END FUNCTION
