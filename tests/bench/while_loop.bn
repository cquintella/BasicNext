// bni benchmark (bucket 0.6.10 F.0): the WHILE form of for_counted.bn.
FUNCTION Start() AS VOID
    LET s AS INTEGER = 0
    LET i AS INTEGER = 1
    WHILE i <= 2000000
        s = s + 1
        i = i + 1
    END WHILE
    PRINT s
END FUNCTION
