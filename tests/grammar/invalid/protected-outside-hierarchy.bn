CLASS Animal
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PROTECTED FUNCTION Breath() AS STRING
        RETURN "breathing"
    END FUNCTION
END CLASS

CLASS Vet
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION Listen(a AS Animal) AS STRING
        RETURN a.Breath()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET v AS Vet = NEW Vet()
    PRINT v.Listen(NEW Animal())
END FUNCTION
