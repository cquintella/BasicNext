// HOST.Exec failures carry Code, Operation, Message, and Cause from the one
// shared implementation (bn_host_exec), identical on both backends.
IMPORT HOST.Exec AS Exec

FUNCTION Start() AS INTEGER
    LET args AS STRING[0]
    LET missing AS Exec.Result OR Error = Exec.Run("bn-exec-errors-no-such-program", args)
    IF missing IS Error THEN
        PRINT missing.Code, missing.Operation, missing.Message
    END IF
    LET empty AS Exec.Result OR Error = Exec.Run("", args)
    IF empty IS Error THEN
        PRINT empty
    END IF
    RETURN 0
END FUNCTION
