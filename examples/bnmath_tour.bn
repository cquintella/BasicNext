// bnmath_tour.bn — exercise every public BNMath API the runtime supports.
// Run from repo root: bn run examples/bnmath_tour.bn

IMPORT BNMath AS Math

FUNCTION CheckInteger(label AS STRING, expected AS INTEGER, got AS INTEGER) AS VOID
    IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION CheckInt64(label AS STRING, expected AS INT64, got AS INT64) AS VOID
    IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION CheckByte(label AS STRING, expected AS BYTE, got AS BYTE) AS VOID
    IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION CheckU32(label AS STRING, expected AS UINT32, got AS UINT32) AS VOID
    IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION CheckU64(label AS STRING, expected AS UINT64, got AS UINT64) AS VOID
    IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION CheckFloat(label AS STRING, expected AS FLOAT, got AS FLOAT) AS VOID
    IF expected IS NAN AND got IS NAN THEN
        PRINT "PASS  ", label, "  expected=NAN  got=NAN"
    ELSE IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION CheckBoolean(label AS STRING, expected AS BOOLEAN, got AS BOOLEAN) AS VOID
    IF expected = got THEN
        PRINT "PASS  ", label, "  expected=", expected, "  got=", got
    ELSE
        PRINT "FAIL  ", label, "  expected=", expected, "  got=", got
    END IF
END FUNCTION

FUNCTION Start() AS VOID
    PRINT "=== BNMath tour: Limits (namespace members) ==="
    CheckInteger("MAX_INT8", 127, Math.MAX_INT8 AS INTEGER)
    CheckInteger("MIN_INT8", -128, Math.MIN_INT8 AS INTEGER)
    CheckInteger("MAX_INT16", 32767, Math.MAX_INT16 AS INTEGER)
    CheckInteger("MIN_INT16", -32768, Math.MIN_INT16 AS INTEGER)
    CheckInteger("MAX_INTEGER", 2147483647, Math.MAX_INTEGER)
    CheckInteger("MIN_INTEGER", -2147483648, Math.MIN_INTEGER)
    CheckInteger("MAX_INT32 alias", Math.MAX_INTEGER, Math.MAX_INT32)
    CheckInteger("MIN_INT32 alias", Math.MIN_INTEGER, Math.MIN_INT32)
    CheckInt64("MAX_INT64", 9223372036854775807, Math.MAX_INT64)
    CheckInt64("MIN_INT64", (0 AS INT64) - Math.MAX_INT64 - (1 AS INT64), Math.MIN_INT64)
    CheckInt64("MAX_TIMESTAMP alias", Math.MAX_INT64, Math.MAX_TIMESTAMP)
    CheckInt64("MIN_TIMESTAMP alias", Math.MIN_INT64, Math.MIN_TIMESTAMP)
    CheckByte("MAX_BYTE", 255, Math.MAX_BYTE)
    CheckByte("MIN_BYTE", 0, Math.MIN_BYTE)
    CheckInteger("MAX_UINT16", 65535, Math.MAX_UINT16 AS INTEGER)
    CheckInteger("MIN_UINT16", 0, Math.MIN_UINT16 AS INTEGER)
    CheckU32("MAX_UINT32", 4294967295, Math.MAX_UINT32)
    CheckU32("MIN_UINT32", 0, Math.MIN_UINT32)
    CheckU64("MAX_UINT64", Math.MAX_UINT64, Math.MAX_UINT64)
    CheckBoolean("MAX_UINT64 > 0", TRUE, Math.MAX_UINT64 > (0 AS UINT64))
    CheckU64("MIN_UINT64", 0, Math.MIN_UINT64)
    CheckFloat("MAX_FLOAT32 self", Math.MAX_FLOAT32 AS FLOAT, Math.MAX_FLOAT32 AS FLOAT)
    CheckFloat("MIN_FLOAT32 = -MAX_FLOAT32", 0.0 - (Math.MAX_FLOAT32 AS FLOAT), Math.MIN_FLOAT32 AS FLOAT)
    CheckFloat("MAX_FLOAT alias MAX_FLOAT64", Math.MAX_FLOAT, Math.MAX_FLOAT64)
    CheckFloat("MIN_FLOAT alias MIN_FLOAT64", Math.MIN_FLOAT, Math.MIN_FLOAT64)
    CheckFloat("MIN_POSITIVE_FLOAT alias", Math.MIN_POSITIVE_FLOAT, Math.MIN_POSITIVE_FLOAT64)
    PRINT "INFO  MAX_FLOAT32=", Math.MAX_FLOAT32, "  MIN_POSITIVE_FLOAT32=", Math.MIN_POSITIVE_FLOAT32
    PRINT "INFO  MAX_FLOAT=", Math.MAX_FLOAT, "  MIN_POSITIVE_FLOAT=", Math.MIN_POSITIVE_FLOAT

    PRINT "=== BNMath tour: integer / general numeric ==="
    CheckInteger("ABS(-5)", 5, Math.ABS(-5))
    CheckInteger("ABS(5)", 5, Math.ABS(5))
    CheckFloat("ABS(-INF)", INF, Math.ABS(-INF))
    CheckInteger("MIN(2, 9)", 2, Math.MIN(2, 9))
    CheckInteger("MAX(2, 9)", 9, Math.MAX(2, 9))
    CheckInteger("SIGN(-3)", -1, Math.SIGN(-3))
    CheckInteger("SIGN(0)", 0, Math.SIGN(0))
    CheckInteger("SIGN(5)", 1, Math.SIGN(5))
    CheckFloat("SIGN(NAN)", NAN, Math.SIGN(NAN))

    PRINT "=== BNMath tour: rounding ==="
    CheckFloat("FLOOR(1.9)", 1.0, Math.FLOOR(1.9))
    CheckFloat("FLOOR(-1.2)", -2.0, Math.FLOOR(-1.2))
    CheckFloat("CEIL(1.1)", 2.0, Math.CEIL(1.1))
    CheckFloat("CEIL(-1.2)", -1.0, Math.CEIL(-1.2))
    CheckFloat("TRUNC(1.9)", 1.0, Math.TRUNC(1.9))
    CheckFloat("TRUNC(-1.2)", -1.0, Math.TRUNC(-1.2))
    CheckFloat("ROUND(2.5, 0) ties-to-even", 2.0, Math.ROUND(2.5, 0))
    CheckFloat("ROUND(1.5, 0) ties-to-even", 2.0, Math.ROUND(1.5, 0))
    CheckFloat("ROUND(3.14159, 2)", 3.14, Math.ROUND(3.14159, 2))

    PRINT "=== BNMath tour: exp / log / power ==="
    CheckFloat("EXP(0)", 1.0, Math.EXP(0.0))
    CheckFloat("EXP(-INF)", 0.0, Math.EXP(-INF))
    CheckFloat("EXP(INF)", INF, Math.EXP(INF))
    CheckFloat("LOG(1)", 0.0, Math.LOG(1.0))
    CheckFloat("LOG(0)", -INF, Math.LOG(0.0))
    CheckFloat("LOG(-1)", NAN, Math.LOG(-1.0))
    CheckFloat("LOG10(1000)", 3.0, Math.LOG10(1000.0))
    CheckFloat("LOG2(8)", 3.0, Math.LOG2(8.0))
    CheckFloat("POW(2, 3)", 8.0, Math.POW(2.0, 3.0))
    CheckFloat("POW(-2, 0.5) undefined", NAN, Math.POW(-2.0, 0.5))

    PRINT "=== BNMath tour: trig ==="
    CheckFloat("SIN(0)", 0.0, Math.SIN(0.0))
    CheckFloat("COS(0)", 1.0, Math.COS(0.0))
    CheckFloat("TAN(0)", 0.0, Math.TAN(0.0))
    CheckFloat("SIN(INF)", NAN, Math.SIN(INF))
    CheckFloat("ASIN(0)", 0.0, Math.ASIN(0.0))
    CheckFloat("ACOS(1)", 0.0, Math.ACOS(1.0))
    CheckFloat("ATAN(0)", 0.0, Math.ATAN(0.0))
    CheckFloat("ASIN(2)", NAN, Math.ASIN(2.0))
    CheckFloat("ATAN2(0, 1)", 0.0, Math.ATAN2(0.0, 1.0))

    PRINT "=== BNMath tour: stable compound ==="
    CheckFloat("SQRT(9)", 3.0, Math.SQRT(9.0))
    CheckFloat("SQRT(-1)", NAN, Math.SQRT(-1.0))
    CheckFloat("HYPOT(3, 4)", 5.0, Math.HYPOT(3.0, 4.0))
    CheckFloat("FMA(2, 3, 4)", 10.0, Math.FMA(2.0, 3.0, 4.0))

    PRINT "=== BNMath tour: VAL ==="
    CheckFloat("VAL(\"  12abc\")", 12.0, Math.VAL("  12abc"))
    CheckFloat("VAL(\"3,14\")", 3.0, Math.VAL("3,14"))
    CheckFloat("VAL(\"1e10\")", 1.0, Math.VAL("1e10"))
    CheckFloat("VAL(\"INF\")", 0.0, Math.VAL("INF"))
    CheckFloat("VAL(\"\")", 0.0, Math.VAL(""))
    CheckFloat("VAL(\"-2.5\")", -2.5, Math.VAL("-2.5"))

    PRINT "=== BNMath tour: descriptive statistics ==="
    LET samples AS INTEGER[4] = [1, 2, 2, 5]
    LET triple AS INTEGER[3] = [1, 2, 3]
    CheckInteger("MIN(vector)", 1, Math.MIN(samples))
    CheckInteger("MAX(vector)", 5, Math.MAX(samples))
    CheckFloat("MEAN([1,2,2,5])", 2.5, Math.MEAN(samples))
    CheckFloat("MEDIAN([1,2,2,5])", 2.0, Math.MEDIAN(samples))
    CheckFloat("QUARTILE1([1,2,2,5]) Tukey", 1.5, Math.QUARTILE1(samples))
    CheckFloat("QUARTILE3([1,2,2,5]) Tukey", 3.5, Math.QUARTILE3(samples))
    CheckFloat("RANGE([1,2,2,5])", 4.0, Math.RANGE(samples))
    CheckFloat("STDEV([1,2,3]) sample", 1.0, Math.STDEV(triple))
    CheckFloat("VARIANCE([1,2,3]) sample", 1.0, Math.VARIANCE(triple))
    LET mode AS FLOAT OR NA = Math.MODE(samples)
    IF mode IS NA THEN
        PRINT "FAIL  MODE([1,2,2,5])  expected=2.0  got=NA"
    ELSE
        CheckFloat("MODE([1,2,2,5])", 2.0, mode)
    END IF
    LET tied AS INTEGER[2] = [1, 2]
    LET tiedMode AS FLOAT OR NA = Math.MODE(tied)
    IF tiedMode IS NA THEN
        PRINT "PASS  MODE tie [1,2]  expected=NA  got=NA"
    ELSE
        PRINT "FAIL  MODE tie [1,2]  expected=NA  got=", tiedMode
    END IF

    PRINT "=== BNMath tour: UTC temporal ==="
    CheckInteger("TOHOUR(0)", 0, Math.TOHOUR(0 AS TIMESTAMP))
    CheckInteger("TOWEEKDAY(0) Thursday=4", 4, Math.TOWEEKDAY(0 AS TIMESTAMP))
    CheckInteger("TOHOUR(-1) previous day 23", 23, Math.TOHOUR(-1 AS TIMESTAMP))
    CheckInteger("TOWEEKDAY(-1) Wednesday=3", 3, Math.TOWEEKDAY(-1 AS TIMESTAMP))
    LET epochDate AS DATE = Math.TODATE(0 AS TIMESTAMP)
    LET epochTime AS TIME = Math.TOTIME(0 AS TIMESTAMP)
    CheckInt64("TOTIMESTAMP round-trip 0", 0, Math.TOTIMESTAMP(epochDate, epochTime))
    PRINT "INFO  TODATE(0)=", epochDate, "  TOTIME(0)=", epochTime

    PRINT "=== bnmath_tour complete ==="
END FUNCTION
