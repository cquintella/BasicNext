// HOST.Console, HOST.Args and HOST.NumProcs are used without IMPORT (0.6.md,
// "Which capabilities need IMPORT"). A compiled program must grant them
// without an IMPORT as the interpreter does.

FUNCTION Start() AS VOID
    HOST.Console.Beep()
    PRINT LEN(HOST.Args) > 0
    LET procs AS INTEGER OR Error = HOST.NumProcs()
    PRINT procs IS INTEGER
END FUNCTION
