CLASS Animal
    PRIVATE secret AS STRING = "hidden"
END CLASS

CLASS Dog EXTENDS Animal
    PUBLIC FUNCTION Speak() AS STRING
        RETURN SELF.secret
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
END FUNCTION
