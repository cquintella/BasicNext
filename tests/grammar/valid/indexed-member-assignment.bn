STRUCT Item
    data AS INTEGER[2] = [0, 0]
END STRUCT

CLASS Holder
    PUBLIC STATIC data AS INTEGER[2] = [0, 0]
END CLASS

FUNCTION Start() AS VOID
    LET item AS Item
    item.data[0] = 7
    Holder.data[1] = 9
    PRINT item.data[0]
    PRINT Holder.data[1]
END FUNCTION
