// Runtime trap: a store into a vector field at an INT64 index above the
// INT32 range (known issue K71).
CLASS Box
    PUBLIC items AS INTEGER[3]

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION Start() AS INTEGER
    LET box AS Box = NEW Box()
    LET at AS INT64 = 4294967297
    box.items[at] = 5
    PRINT box.items[1]
    RETURN 0
END FUNCTION
