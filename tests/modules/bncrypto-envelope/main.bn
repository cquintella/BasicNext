IMPORT BNCrypto AS Crypto

FUNCTION Start() AS VOID
    // 1. Generate SecretKey
    LET key AS Crypto.SecretKey = Crypto.NewSecretKey()

    // 2. Encrypt bytes payload
    LET plain AS Crypto.Bytes = Crypto.FromText("Hello authenticated envelope world!")
    LET sealed AS Crypto.Bytes OR Error = Crypto.Encrypt(key, plain)
    IF sealed IS Error THEN
        PRINT "encrypt-failed"
        RETURN
    END IF

    IF sealed IS Crypto.Bytes THEN
        // Header (31) + plaintext (35) + tag (16) = 82
        IF sealed.Length() = 82 THEN
            PRINT "sealed-len-82-ok"
        END IF

        // First 4 bytes are "BNC1" (hex 42 4e 43 31)
        LET magicSlice AS Crypto.Bytes OR Error = Crypto.Slice(sealed, 0, 4)
        IF magicSlice IS Crypto.Bytes THEN
            IF magicSlice.ToHex() = "424e4331" THEN
                PRINT "magic-bnc1-ok"
            END IF
        END IF

        // 3. Decrypt bytes payload
        LET unsealed AS Crypto.Bytes OR Error = Crypto.Decrypt(key, sealed)
        IF unsealed IS Crypto.Bytes THEN
            IF Crypto.ConstantTimeEquals(unsealed, plain) = TRUE THEN
                PRINT "unsealed-matches-plain-ok"
            END IF
        END IF
    END IF

    // 4. EncryptText / DecryptText string helpers
    LET token AS STRING OR Error = Crypto.EncryptText(key, "Secret string payload")
    IF token IS STRING THEN
        LET recovered AS STRING OR Error = Crypto.DecryptText(key, token)
        IF recovered IS STRING THEN
            IF recovered = "Secret string payload" THEN
                PRINT "decrypt-text-ok"
            END IF
        END IF
    END IF
END FUNCTION
