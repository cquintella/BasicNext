// HMAC-SHA-256 and Argon2id. The MAC value comes from Python's hmac module,
// independent of the Rust crate under test; Argon2id is verified against the
// RFC 9106 vector in the bn_rt unit tests, so here we assert its shape and its
// refusal of out-of-range parameters.

IMPORT BNCrypto AS Crypto

FUNCTION Start() AS VOID
    LET key AS Crypto.Bytes = Crypto.FromText("0123456789abcdef0123456789abcdef")
    LET data AS Crypto.Bytes = Crypto.FromText("abc")

    LET tag AS Crypto.Bytes = Crypto.HmacSha256(key, data)
    PRINT tag.ToHex()
    PRINT Crypto.VerifyHmacSha256(key, data, tag)

    LET other AS Crypto.Bytes = Crypto.FromText("abd")
    PRINT Crypto.VerifyHmacSha256(key, other, tag)

    LET salt AS Crypto.Bytes = Crypto.FromText("0123456789abcdef")
    LET derived AS Crypto.Bytes OR Error = Crypto.Argon2id(data, salt, 32, 3, 4)
    IF derived IS Error THEN
        PRINT "argon-failed"
    ELSE
        PRINT derived.Length()
    END IF

    LET weak AS Crypto.Bytes OR Error = Crypto.Argon2id(data, salt, 1, 3, 4)
    IF weak IS Error THEN
        PRINT "argon-params-rejected"
    ELSE
        PRINT "argon-params-accepted"
    END IF
END FUNCTION
