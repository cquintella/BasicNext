// Runtime trap: shift count out of range. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET n AS INTEGER = 40
    PRINT 1 SHL n
    RETURN 0
END FUNCTION
