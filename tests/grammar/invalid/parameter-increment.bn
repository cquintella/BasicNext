// `++` assigns to its operand, so it cannot target a parameter (0.6.md,
// "Memory model (ARC)", "Parameter").
FUNCTION Next(n AS INTEGER) AS INTEGER
    n++
    RETURN n
END FUNCTION

FUNCTION Start() AS VOID
    PRINT Next(3)
END FUNCTION
