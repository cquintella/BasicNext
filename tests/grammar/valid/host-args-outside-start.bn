FUNCTION GetArgCount() AS INTEGER
    RETURN LEN(HOST.Args)
END FUNCTION

FUNCTION GetArg(index AS INTEGER) AS STRING
    RETURN HOST.Args[index]
END FUNCTION

FUNCTION Start() AS VOID
    PRINT GetArgCount() > 0
    PRINT LEN(GetArg(0)) > 0
END FUNCTION
