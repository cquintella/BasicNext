// Imports used only in type positions are used: no UNUSED_IMPORT warning.
IMPORT HOST.FileSystem AS FS
IMPORT HOST.Net AS Net
IMPORT BNJson AS Json

FUNCTION Describe(address AS Net.Address) AS STRING
    RETURN "address"
END FUNCTION

FUNCTION Keep(doc AS Json.Json) AS Json.Json
    RETURN doc
END FUNCTION

FUNCTION Start() AS VOID
    LET file AS FS.File = NEW FS.File()
    RELEASE file
END FUNCTION
