CLASS Counter
    PUBLIC STATIC instances AS INTEGER = 0

    PUBLIC STATIC FUNCTION Tick() AS INTEGER
        Counter.instances += 1
        RETURN Counter.instances
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    PRINT Counter.Tick()
    PRINT Counter.Tick()
END FUNCTION
