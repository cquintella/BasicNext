FUNCTION Start() AS VOID
    LET typed AS POINTER TO INTEGER = NEW INTEGER
    typed[0] = 42
    LET opaque AS POINTER TO VOID = typed
    IF opaque IS POINTER TO VOID THEN
        LET restored AS POINTER TO INTEGER = opaque
        PRINT restored[0]
    END IF
    DELETE opaque
END FUNCTION
