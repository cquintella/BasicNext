// Runtime trap: BNMath.TODATE past year 9999. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
IMPORT BNMath AS Math
FUNCTION Start() AS INTEGER
    LET far AS INT64 = 400000000000000
    PRINT Math.TODATE(far)
    RETURN 0
END FUNCTION
