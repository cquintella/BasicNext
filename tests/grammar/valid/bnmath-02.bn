IMPORT BNMath AS Math
FUNCTION Start() AS VOID
    LET values AS INTEGER[4] = [1, 2, 2, 5]
    PRINT Math.VAL("3,14"), Math.MEAN(values), Math.MAX_INTEGER
END FUNCTION
