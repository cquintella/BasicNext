FUNCTION Start() AS VOID
    LET n AS INTEGER = LEN(HOST.Args)
    LET min AS INTEGER = -2147483648 + n - n
    LET neg AS INTEGER = -1 + n - n
    PRINT min DIV neg
END FUNCTION
