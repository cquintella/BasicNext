CLASS Animal
    PROTECTED legs AS INTEGER = 4
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PROTECTED FUNCTION Breath() AS STRING
        RETURN "breathing"
    END FUNCTION
    PROTECTED STATIC FUNCTION Kingdom() AS STRING
        RETURN "Animalia"
    END FUNCTION
END CLASS

CLASS Dog EXTENDS Animal
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
    PUBLIC FUNCTION Run() AS STRING
        RETURN SELF.Breath() + " on " + Animal.Kingdom()
    END FUNCTION
    PUBLIC FUNCTION Legs() AS INTEGER
        RETURN SELF.legs
    END FUNCTION
END CLASS

CLASS Puppy EXTENDS Dog
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
    PUBLIC FUNCTION Nap() AS STRING
        RETURN SELF.Breath()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET d AS Dog = NEW Dog()
    PRINT d.Run()
    PRINT d.Legs()
    LET p AS Puppy = NEW Puppy()
    PRINT p.Nap()
END FUNCTION
