// Thin tour of official BNString (modules/bn/BNString.bn).

IMPORT BNString AS S

FUNCTION Start() AS VOID
    LET s AS S.String = NEW S.String("  hello,world,bn  ")
    PRINT "Len=", s.Len()
    PRINT "Length=", s.Length()
    PRINT "LowCaps=", s.LowCaps().ToString()
    PRINT "HiCaps=", s.HiCaps().ToString()

    LET acao AS S.String = NEW S.String("AÇÃO")
    PRINT "Unicode LowCaps=", acao.LowCaps().ToString()
    LET acaoLow AS S.String = NEW S.String("ação")
    PRINT "Unicode HiCaps=", acaoLow.HiCaps().ToString()

    PRINT "Contains world? ", s.Contains("world")
    LET trimmed AS S.String = s.Trim()
    PRINT "Trimmed=", trimmed.ToString()

    LET tok AS S.Tokenizer OR NULL = trimmed.Tokenizer(",")
    IF tok IS NULL THEN
        PRINT "Tokenizer failed"
        STOP 1
    END IF
    PRINT "Tokens:"
    REPEAT
        LET part AS STRING OR EOF = tok.Next()
        IF part IS EOF THEN
            EXIT REPEAT
        END IF
        PRINT "  [", part, "]"
    UNTIL FALSE
    END REPEAT

    LET emptyTok AS S.Tokenizer OR NULL = S.Tokenizer.New("a,b", "")
    IF emptyTok IS NULL THEN
        PRINT "empty sep -> NULL (ok)"
    END IF
END FUNCTION
