// A parameter is a constant binding (0.6.md, "Memory model (ARC)",
// "Parameter"; Swift SE-0003): assigning to it is a TYPE_MISMATCH.
FUNCTION Twice(n AS INTEGER) AS INTEGER
    n = n * 2
    RETURN n
END FUNCTION

FUNCTION Start() AS VOID
    PRINT Twice(3)
END FUNCTION
