// Run with BN_FS_POLICY=deny or read-only: a log file the policy denies is
// Error(Log.IO_FAILED) from Logger.New on both backends and the program goes
// on (bnlog.md "Making a logger"; D2 of bucket 0.6.5c).
IMPORT HOST.FileSystem AS FS
IMPORT BNLog AS Log

FUNCTION Start() AS INTEGER
    LET logger AS Log.Logger OR Error = Log.Logger.New("app", "JSON", "bn-log-denied.log")
    IF logger IS Error THEN
        PRINT logger.Code = Log.IO_FAILED, logger.Operation
    END IF
    PRINT "went on"
    RETURN 0
END FUNCTION
