// A closed HOST.Net handle stays closed when a later socket is opened
// (value-memory-abi.md: a stale handle returns a status, never another
// object). Each case closes a handle, opens another of the same kind, and
// uses the old one: both backends answer Net.CLOSED.
IMPORT HOST.Net AS Net

FUNCTION Start() AS INTEGER
    LET loopback AS Net.Address OR Error = Net.Address.Parse("127.0.0.1")
    IF loopback IS Error THEN
        RETURN 1
    END IF
    LET anyPort AS Net.Endpoint OR Error = Net.Endpoint.Create(loopback, 0)
    IF anyPort IS Error THEN
        RETURN 1
    END IF

    LET first AS Net.UDPSocket OR Error = Net.UDPBind(anyPort)
    IF first IS Error THEN
        RETURN 1
    END IF
    LET firstClosed AS VOID OR Error = first.Close()
    IF firstClosed IS Error THEN
        RETURN 1
    END IF
    LET second AS Net.UDPSocket OR Error = Net.UDPBind(anyPort)
    IF second IS Error THEN
        RETURN 1
    END IF
    LET staleSocket AS Net.Endpoint OR Error = first.LocalEndpoint()
    IF staleSocket IS Error THEN
        PRINT "udp", staleSocket.Code = Net.CLOSED
    ELSE
        PRINT "udp reached another socket"
    END IF
    LET liveSocket AS Net.Endpoint OR Error = second.LocalEndpoint()
    PRINT "udp live", liveSocket IS Net.Endpoint
    // Closing the stale id again must not close the socket now in its slot.
    LET staleClose AS VOID OR Error = first.Close()
    IF staleClose IS Error THEN
        RETURN 1
    END IF
    LET stillLive AS Net.Endpoint OR Error = second.LocalEndpoint()
    PRINT "udp stale close keeps the live socket", stillLive IS Net.Endpoint

    LET endpoints AS Net.Endpoint[1] = [anyPort]
    LET oldListener AS Net.TCPListener OR Error = Net.TCPListen(endpoints, 4)
    IF oldListener IS Error THEN
        RETURN 1
    END IF
    LET oldClosed AS VOID OR Error = oldListener.Close()
    IF oldClosed IS Error THEN
        RETURN 1
    END IF
    LET newListener AS Net.TCPListener OR Error = Net.TCPListen(endpoints, 4)
    IF newListener IS Error THEN
        RETURN 1
    END IF
    LET staleListener AS Net.Endpoint OR Error = oldListener.LocalEndpoint()
    IF staleListener IS Error THEN
        PRINT "tcp", staleListener.Code = Net.CLOSED
    ELSE
        PRINT "tcp reached another listener"
    END IF
    LET liveListener AS Net.Endpoint OR Error = newListener.LocalEndpoint()
    PRINT "tcp live", liveListener IS Net.Endpoint
    RETURN 0
END FUNCTION
