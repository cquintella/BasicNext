CLASS Base
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Name() AS STRING
        RETURN "base"
    END FUNCTION
END CLASS

CLASS Mid EXTENDS Base
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION

    PUBLIC OVERRIDE FUNCTION Name() AS STRING
        RETURN "mid"
    END FUNCTION
END CLASS

CLASS Sub EXTENDS Mid
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
END CLASS

FUNCTION CallBase(b AS Base) AS STRING
    RETURN b.Name()
END FUNCTION

FUNCTION Start() AS VOID
    LET b AS Base = NEW Sub()
    LET m AS Mid = NEW Sub()
    LET s AS Sub = NEW Sub()
    PRINT b.Name()
    PRINT m.Name()
    PRINT s.Name()
    PRINT CallBase(s)
END FUNCTION
