// An element of a vector literal whose element type is a STRUCT may itself be
// a STRUCT literal (0.6.md, "STRUCT literals"): one and two dimensions, and
// inside a STRUCT field.
STRUCT Point
    X AS INTEGER = 0
    Y AS INTEGER = 0
END STRUCT

STRUCT Path
    name AS STRING
    stops AS Point[2]
END STRUCT

FUNCTION Start() AS VOID
    LET corners AS Point[2] = [[0, 0], [3, 4]]
    LET grid AS Point[2][2] = [[[1, 1], [1, 2]], [[2, 1], [2, 2]]]
    LET path AS Path = ["route", [[0, 0], [5, 5]]]
    PRINT corners[1].X, corners[1].Y
    PRINT grid[1][0].X, grid[1][0].Y
    PRINT path.name, path.stops[1].X
END FUNCTION
