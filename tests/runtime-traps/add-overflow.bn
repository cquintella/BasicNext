// Runtime trap: INT32 addition overflow. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET big AS INTEGER = 2147483647
    LET more AS INTEGER = big + 1
    PRINT more
    RETURN 0
END FUNCTION
