# Accepted duplications between the interpreter and native sides (tests/shared_logic.rs).
# kind<TAB>key<TAB>reason. The list only shrinks: each entry leaves with the migration step it names.
literal	BNCrypto.EcdsaP256PublicKey	BNCrypto type name in bn_lib_crypto and bn_rt; leaves with the crypto core
literal	BNCrypto.Ed25519PublicKey	BNCrypto type name in bn_lib_crypto and bn_rt; leaves with the crypto core
literal	BNData.DataFrame.{method}	BNData operation-name format in bn_lib_data and bn_rt; leaves with the DataFrame core
literal	HOST.Net.Address.ToString	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.Addresses.Count	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.Endpoint.Address	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.Endpoint.Create	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.PingReply.Address	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.PingReply.RoundTripMicroseconds	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPListener.Accept	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPListener.Close	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPListener.LocalEndpoint	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPStream.Close	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPStream.LocalEndpoint	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPStream.RemoteEndpoint	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.TCPStream.Write	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.UDPPacket.CopyTo	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.UDPPacket.Source	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
literal	HOST.Net.UDPPacket.WasTruncated	Net operation name or message in bn_host_net and bn_llvm/bn_rt; leaves with the Net core
