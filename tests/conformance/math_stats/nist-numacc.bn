// NIST StRD univariate NumAcc1-NumAcc4 (bucket 0.6.10 B.1, G-11):
// https://www.itl.nist.gov/div898/strd/univ/data/NumAcc1.dat (to NumAcc4),
// SHA-256 ce7c7a0fc6d7cedd0d5e1f9911afb9337544be6836730beb9968ca0a4571d375,
// 5be29522dfbe299541f0ec98ec1c22a51a5587bf06561ba21a92c209fb7ef0f9,
// 66df1b96596735936f37fd889e7c1c6ce998eb2b523bfc46c98ec1737e992aec,
// ca310dc767f5130f980f8280bbe69e26ba414a4d85a89fc11b6c767b828e5fe4.
// NumAcc1 is three values; NumAcc2-4 are a centre then 500 (low, high)
// pairs, built here by Fill. Expected output: nist-numacc.expected:
//   - STDEV is the exact standard deviation of the binary64 data, computed
//     with bc at 60 digits and rounded to binary64 (the certified 0.1 is the
//     decimal value; the data's own decimal-to-binary error moves it);
//   - MEAN of NumAcc1 and NumAcc2 is the correctly rounded exact mean;
//   - MEAN of NumAcc3 and NumAcc4 is within one unit in the last place of
//     the exact mean, which itself is within 1.2e-11 and 1.9e-10 of the
//     certified value: the bounds 2e-10 and 3e-9 hold.

IMPORT BNMath AS Math

FUNCTION Fill(centre AS FLOAT, low AS FLOAT, high AS FLOAT) AS FLOAT[1001]
    LET values AS FLOAT[1001]
    values[0] = centre
    FOR pair AS INTEGER = 0 TO 499
        values[2 * pair + 1] = low
        values[2 * pair + 2] = high
    END FOR
    RETURN values
END FUNCTION

FUNCTION Start() AS VOID
    LET one AS FLOAT[3] = [10000001.0, 10000003.0, 10000002.0]
    LET two AS FLOAT[1001] = Fill(1.2, 1.1, 1.3)
    LET three AS FLOAT[1001] = Fill(1000000.2, 1000000.1, 1000000.3)
    LET four AS FLOAT[1001] = Fill(10000000.2, 10000000.1, 10000000.3)
    PRINT "NumAcc1", Math.MEAN(one), Math.STDEV(one)
    PRINT "NumAcc2", Math.MEAN(two), Math.STDEV(two)
    PRINT "NumAcc3", Math.ABS(Math.MEAN(three) - 1000000.2) <= 0.0000000002, Math.STDEV(three)
    PRINT "NumAcc4", Math.ABS(Math.MEAN(four) - 10000000.2) <= 0.000000003, Math.STDEV(four)
END FUNCTION
