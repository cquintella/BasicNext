// BNSqlite 0.6 external-module interface.
// Native SQLite3 C driver provides embedded database operations.
IMPORT BNData AS Data

// Error codes (language/0.6/bnsqlite.md "Errors").
EXPORT CONST FILE_NOT_FOUND AS INTEGER = 1
EXPORT CONST ACCESS_DENIED AS INTEGER = 2
EXPORT CONST POLICY_DENIED AS INTEGER = 3
EXPORT CONST CORRUPT AS INTEGER = 4
EXPORT CONST BUSY AS INTEGER = 5
EXPORT CONST LOCKED AS INTEGER = 6
EXPORT CONST READ_ONLY AS INTEGER = 7
EXPORT CONST SYNTAX_ERROR AS INTEGER = 8
EXPORT CONST SCHEMA_ERROR AS INTEGER = 9
EXPORT CONST CONSTRAINT_VIOLATION AS INTEGER = 10
EXPORT CONST TYPE_MISMATCH AS INTEGER = 11
EXPORT CONST MISUSE AS INTEGER = 12
EXPORT CONST CLOSED AS INTEGER = 13
EXPORT CONST LIMIT_EXCEEDED AS INTEGER = 14
EXPORT CONST IO_FAILED AS INTEGER = 15
EXPORT CONST INTERNAL_ERROR AS INTEGER = 16

EXPORT CLASS Connection
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Exec(sql AS STRING) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION Query(sql AS STRING) AS Data.DataFrame OR Error
        RETURN NEW Data.DataFrame()
    END FUNCTION

    PUBLIC FUNCTION Begin() AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION Commit() AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION Rollback() AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION Changes() AS INTEGER
        RETURN 0
    END FUNCTION

    PUBLIC FUNCTION LastInsertRowId() AS INTEGER
        RETURN 0
    END FUNCTION

    PUBLIC FUNCTION Close() AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT FUNCTION Open(path AS STRING) AS Connection OR Error
    RETURN NEW Connection()
END FUNCTION

EXPORT FUNCTION OpenReadOnly(path AS STRING) AS Connection OR Error
    RETURN NEW Connection()
END FUNCTION

EXPORT FUNCTION OpenExisting(path AS STRING) AS Connection OR Error
    RETURN NEW Connection()
END FUNCTION
