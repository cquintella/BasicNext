// sqlite.bn — comprehensive verbose demonstration of the BNSqlite embedded database driver.
// Exercises: Open, OpenReadOnly, OpenExisting, Exec, Query, Begin, Commit,
// Rollback, Changes, LastInsertRowId, Close, structured Error handling,
// and secure password hashing into a 'secret' table with Salt, Pepper, and Argon2id.
// Explains each planned action before execution, then displays and describes the result.
// Run: bni run examples/sqlite.bn

IMPORT BNCrypto AS Crypto
IMPORT BNData AS Data
IMPORT BNSqlite AS Sqlite
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    PRINT "=== Basic Next BNSqlite Driver Tour ==="
    PRINT "Demonstrating SQLite database operations with step-by-step narration."

    // -------------------------------------------------------------
    // Section 1: In-memory database lifecycle
    // -------------------------------------------------------------
    PRINT ""
    PRINT "--- Section 1: In-Memory Database Lifecycle (:memory:) ---"

    PRINT "-> Action: Opening an in-memory SQLite database using Sqlite.Open(':memory:')..."
    LET memDb AS Sqlite.Connection OR Error = Sqlite.Open(":memory:")
    IF memDb IS Error THEN
        PRINT "<- Result: FAILED to open in-memory database: Code =", memDb.Code, " Message =", memDb.Message
        RETURN
    END IF
    PRINT "<- Result: Successfully opened in-memory database connection."

    PRINT "-> Action: Creating table 'products' (id INTEGER PRIMARY KEY, name TEXT, price REAL, in_stock INT)..."
    LET res AS VOID OR Error = memDb.Exec("CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, price REAL, in_stock INT);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to create table: Code =", res.Code, " Message =", res.Message
        RETURN
    END IF
    PRINT "<- Result: Table 'products' created successfully."

    PRINT "-> Action: Inserting 3 product records using memDb.Exec(INSERT)..."
    res = memDb.Exec("INSERT INTO products VALUES (1, 'Notebook Pro', 1299.99, 10);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to insert product 1"
        RETURN
    END IF
    res = memDb.Exec("INSERT INTO products VALUES (2, 'Mechanical Keyboard', 149.50, 25);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to insert product 2"
        RETURN
    END IF
    res = memDb.Exec("INSERT INTO products VALUES (3, 'Wireless Mouse', 49.90, 0);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to insert product 3"
        RETURN
    END IF
    PRINT "<- Result: Inserted 3 records successfully."
    PRINT "   Statistics: Changes =", memDb.Changes(), "| LastInsertRowId =", memDb.LastInsertRowId()

    PRINT "-> Action: Querying products via memDb.Query('SELECT id, name, price, in_stock FROM products ORDER BY id;')..."
    LET df AS Data.DataFrame OR Error = memDb.Query("SELECT id, name, price, in_stock FROM products ORDER BY id;")
    IF df IS Error THEN
        PRINT "<- Result: FAILED to query products: Code =", df.Code, " Message =", df.Message
        RETURN
    END IF
    PRINT "<- Result: Query executed successfully, loaded into BNData.DataFrame."
    PRINT "   DataFrame dimensions:", df.RowCount(), "rows x", df.ColumnCount(), "columns"

    LET p1_id AS INTEGER OR NA OR Error = df.GetInteger(0, "id")
    LET p1_name AS STRING OR NA OR Error = df.GetString(0, "name")
    LET p1_price AS FLOAT OR NA OR Error = df.GetFloat(0, "price")
    LET p1_stock AS INTEGER OR NA OR Error = df.GetInteger(0, "in_stock")
    PRINT "   Row 0 -> ID:", p1_id, "| Name:", p1_name, "| Price: $", p1_price, "| In Stock:", p1_stock

    LET p2_id AS INTEGER OR NA OR Error = df.GetInteger(1, "id")
    LET p2_name AS STRING OR NA OR Error = df.GetString(1, "name")
    LET p2_price AS FLOAT OR NA OR Error = df.GetFloat(1, "price")
    LET p2_stock AS INTEGER OR NA OR Error = df.GetInteger(1, "in_stock")
    PRINT "   Row 1 -> ID:", p2_id, "| Name:", p2_name, "| Price: $", p2_price, "| In Stock:", p2_stock

    LET p3_id AS INTEGER OR NA OR Error = df.GetInteger(2, "id")
    LET p3_name AS STRING OR NA OR Error = df.GetString(2, "name")
    LET p3_price AS FLOAT OR NA OR Error = df.GetFloat(2, "price")
    LET p3_stock AS INTEGER OR NA OR Error = df.GetInteger(2, "in_stock")
    PRINT "   Row 2 -> ID:", p3_id, "| Name:", p3_name, "| Price: $", p3_price, "| In Stock:", p3_stock

    // -------------------------------------------------------------
    // Section 2: Transactions (Atomic Commit & Rollback)
    // -------------------------------------------------------------
    PRINT ""
    PRINT "--- Section 2: Atomic Transactions (Begin, Rollback, Commit) ---"

    PRINT "-> Action: Starting explicit transaction with memDb.Begin() to test Rollback..."
    res = memDb.Begin()
    IF res IS Error THEN
        PRINT "<- Result: FAILED to begin transaction: Code =", res.Code
    ELSE
        PRINT "<- Result: Transaction started."
    END IF

    PRINT "-> Action: Inserting temporary item (ID 4: 'Temporary Item') inside the active transaction..."
    res = memDb.Exec("INSERT INTO products VALUES (4, 'Temporary Item', 9.99, 1);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to insert temporary item: Code =", res.Code
    ELSE
        PRINT "<- Result: Temporary item inserted into transaction."
    END IF

    PRINT "-> Action: Aborting transaction with memDb.Rollback() to discard uncommitted changes..."
    res = memDb.Rollback()
    IF res IS Error THEN
        PRINT "<- Result: FAILED to rollback: Code =", res.Code
    ELSE
        PRINT "<- Result: Rollback completed successfully."
    END IF

    PRINT "-> Action: Verifying rollback by querying COUNT of products where ID = 4..."
    LET dfCheck1 AS Data.DataFrame OR Error = memDb.Query("SELECT COUNT(*) AS total FROM products WHERE id = 4;")
    IF NOT (dfCheck1 IS Error) THEN
        PRINT "<- Result: Verified rollback: Count of item 4 in table =", dfCheck1.GetInteger(0, "total"), "(0 indicates successful discard)."
    END IF

    PRINT "-> Action: Starting a second transaction with memDb.Begin() to test Commit..."
    res = memDb.Begin()
    IF res IS Error THEN
        PRINT "<- Result: FAILED to begin transaction: Code =", res.Code
    ELSE
        PRINT "<- Result: Transaction started."
    END IF

    PRINT "-> Action: Inserting persistent item (ID 4: 'Committed Monitor') and confirming with memDb.Commit()..."
    res = memDb.Exec("INSERT INTO products VALUES (4, 'Committed Monitor', 399.00, 5);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to insert item: Code =", res.Code
    END IF
    res = memDb.Commit()
    IF res IS Error THEN
        PRINT "<- Result: FAILED to commit transaction: Code =", res.Code
    ELSE
        PRINT "<- Result: Transaction committed successfully."
    END IF

    PRINT "-> Action: Verifying committed item by querying record with ID = 4..."
    LET dfCheck2 AS Data.DataFrame OR Error = memDb.Query("SELECT name, price FROM products WHERE id = 4;")
    IF NOT (dfCheck2 IS Error) THEN
        PRINT "<- Result: Verified commit: Product found -> Name:", dfCheck2.GetString(0, "name"), "| Price: $", dfCheck2.GetFloat(0, "price")
    END IF

    PRINT "-> Action: Closing in-memory database connection via memDb.Close()..."
    res = memDb.Close()
    IF res IS Error THEN
        PRINT "<- Result: FAILED to close in-memory connection: Code =", res.Code
    ELSE
        PRINT "<- Result: In-memory database connection closed."
    END IF

    // -------------------------------------------------------------
    // Section 3: File Database Modes (Open, OpenReadOnly, OpenExisting)
    // -------------------------------------------------------------
    PRINT ""
    PRINT "--- Section 3: File Database Modes (Open, OpenReadOnly, OpenExisting) ---"
    LET demoDbPath AS STRING = "sqlite_demo.db"

    PRINT "-> Action: Cleaning up any pre-existing '" + demoDbPath + "' file..."
    LET exists1 AS BOOLEAN OR Error = FS.Exists(demoDbPath)
    IF NOT (exists1 IS Error) THEN
        IF exists1 THEN
            res = FS.DeleteFile(demoDbPath)
        END IF
    END IF
    PRINT "<- Result: Clean environment confirmed."

    PRINT "-> Action: Attempting OpenExisting('" + demoDbPath + "') on non-existent file..."
    LET missingDb AS Sqlite.Connection OR Error = Sqlite.OpenExisting(demoDbPath)
    IF missingDb IS Error THEN
        PRINT "<- Result: As expected, OpenExisting failed: Code =", missingDb.Code, "(FILE_NOT_FOUND)"
    END IF

    PRINT "-> Action: Creating and opening new database file '" + demoDbPath + "' using Sqlite.Open()..."
    LET fileDb AS Sqlite.Connection OR Error = Sqlite.Open(demoDbPath)
    IF fileDb IS Error THEN
        PRINT "<- Result: FAILED to create file database: Code =", fileDb.Code
        RETURN
    END IF
    PRINT "<- Result: Database file connection established."

    PRINT "-> Action: Creating 'logs' table and inserting audit record (101, 'system initialized')..."
    res = fileDb.Exec("CREATE TABLE logs (entry_id INT, msg TEXT);")
    res = fileDb.Exec("INSERT INTO logs VALUES (101, 'system initialized');")
    res = fileDb.Close()
    PRINT "<- Result: Table created, record inserted, and database closed to flush data to disk."

    PRINT "-> Action: Opening file in read-only mode using Sqlite.OpenReadOnly('" + demoDbPath + "')..."
    LET roDb AS Sqlite.Connection OR Error = Sqlite.OpenReadOnly(demoDbPath)
    IF roDb IS Error THEN
        PRINT "<- Result: FAILED to open read-only: Code =", roDb.Code
        RETURN
    END IF
    PRINT "<- Result: Read-only connection established."

    PRINT "-> Action: Querying data through read-only connection..."
    LET roQuery AS Data.DataFrame OR Error = roDb.Query("SELECT entry_id, msg FROM logs;")
    IF NOT (roQuery IS Error) THEN
        PRINT "<- Result: Query succeeded on read-only connection. Entry ID:", roQuery.GetInteger(0, "entry_id"), "| Message:", roQuery.GetString(0, "msg")
    END IF

    PRINT "-> Action: Attempting write operation (INSERT) on read-only connection..."
    LET roWrite AS VOID OR Error = roDb.Exec("INSERT INTO logs VALUES (102, 'should fail');")
    IF roWrite IS Error THEN
        PRINT "<- Result: As expected, write was rejected: Code =", roWrite.Code, "(READ_ONLY)"
    ELSE
        PRINT "<- Result: UNEXPECTED: write succeeded on read-only connection"
    END IF
    res = roDb.Close()
    PRINT "<- Result: Read-only connection closed."

    // -------------------------------------------------------------
    // Section 4: API Misuse Validation and Safe Error Handling
    // -------------------------------------------------------------
    PRINT ""
    PRINT "--- Section 4: API Misuse Validation and Error Handling ---"
    LET errDb AS Sqlite.Connection OR Error = Sqlite.Open(":memory:")
    IF NOT (errDb IS Error) THEN
        PRINT "-> Action: Calling Exec('SELECT 1;') - SELECT queries require Query() instead of Exec()..."
        LET misuseExec AS VOID OR Error = errDb.Exec("SELECT 1;")
        IF misuseExec IS Error THEN
            PRINT "<- Result: Misuse correctly caught: Code =", misuseExec.Code, "(MISUSE) | Operation =", misuseExec.Operation
        END IF

        PRINT "-> Action: Calling Query('CREATE TABLE temp (v INT);') - DDL commands require Exec()..."
        LET misuseQuery AS Data.DataFrame OR Error = errDb.Query("CREATE TABLE temp (v INT);")
        IF misuseQuery IS Error THEN
            PRINT "<- Result: Misuse correctly caught: Code =", misuseQuery.Code, "(MISUSE) | Operation =", misuseQuery.Operation
        END IF

        res = errDb.Close()
        PRINT "<- Result: Connection closed."

        PRINT "-> Action: Attempting Exec() on already closed connection..."
        LET closedExec AS VOID OR Error = errDb.Exec("SELECT 1;")
        IF closedExec IS Error THEN
            PRINT "<- Result: Call on closed connection correctly rejected: Code =", closedExec.Code, "(CLOSED)"
        END IF

        PRINT "-> Action: Attempting second Close() on already closed connection (double close)..."
        LET doubleClose AS VOID OR Error = errDb.Close()
        IF doubleClose IS Error THEN
            PRINT "<- Result: Double close correctly rejected: Code =", doubleClose.Code, "(CLOSED)"
        END IF
    END IF

    // Clean up temporary database file
    PRINT "-> Action: Cleaning up demo database file '" + demoDbPath + "' from disk..."
    LET exists2 AS BOOLEAN OR Error = FS.Exists(demoDbPath)
    IF NOT (exists2 IS Error) THEN
        IF exists2 THEN
            res = FS.DeleteFile(demoDbPath)
            PRINT "<- Result: Temporary database file removed successfully."
        END IF
    END IF

    // -------------------------------------------------------------
    // Section 5: Password Hashing & Secret Table Authentication (Salt + Pepper)
    // -------------------------------------------------------------
    PRINT ""
    PRINT "--- Section 5: Password Hashing & Secret Authentication (Salt + Pepper) ---"

    PRINT "-> Action: Opening an in-memory database to store authentication secrets..."
    LET authDb AS Sqlite.Connection OR Error = Sqlite.Open(":memory:")
    IF authDb IS Error THEN
        PRINT "<- Result: FAILED to open authentication database: Code =", authDb.Code
        RETURN
    END IF
    PRINT "<- Result: Dedicated authentication database connection established."

    PRINT "-> Action: Creating 'secret' table (id INT PRIMARY KEY, username TEXT, salt_hex TEXT, hash_hex TEXT)..."
    res = authDb.Exec("CREATE TABLE secret (id INTEGER PRIMARY KEY, username TEXT, salt_hex TEXT, hash_hex TEXT);")
    IF res IS Error THEN
        PRINT "<- Result: FAILED to create 'secret' table: Code =", res.Code
        RETURN
    END IF
    PRINT "<- Result: Table 'secret' created successfully."

    PRINT "-> Action: Defining application pepper and user credentials for 'alice'..."
    // Pepper: Application-side static secret key; never stored in the database.
    // Salt: Unique cryptographic salt per user; stored in the database alongside hash.
    LET appPepper AS STRING = "AppServerStaticPepperKey#2026!"
    LET alicePass AS STRING = "CorrectHorseBatteryStaple!"
    LET aliceSalt AS Crypto.Bytes = Crypto.FromText("alice_deterministic_salt_12345")
    PRINT "   Pepper (application-level, kept in code/env):", appPepper
    PRINT "   Salt (user-level, stored in database):", aliceSalt.ToHex()

    PRINT "-> Action: Deriving Argon2id key over (password + pepper) using user salt (64 KiB, 1 iter)..."
    LET aliceInput AS Crypto.Bytes = Crypto.FromText(alicePass + appPepper)
    LET aliceHash AS Crypto.Bytes OR Error = Crypto.Argon2id(aliceInput, aliceSalt, 64, 1, 1)
    IF aliceHash IS Error THEN
        PRINT "<- Result: FAILED to derive Argon2id hash: Code =", aliceHash.Code
        RETURN
    END IF
    PRINT "<- Result: Password hash derived successfully via Argon2id (length:", aliceHash.Length(), "bytes)."
    PRINT "   Derived Hash Hex:", aliceHash.ToHex()

    PRINT "-> Action: Persisting user 'alice' credentials into 'secret' table..."
    LET insertSql AS STRING = "INSERT INTO secret VALUES (1, 'alice', '" + aliceSalt.ToHex() + "', '" + aliceHash.ToHex() + "');"
    res = authDb.Exec(insertSql)
    IF res IS Error THEN
        PRINT "<- Result: FAILED to insert user credentials: Code =", res.Code
        RETURN
    END IF
    PRINT "<- Result: Credentials persisted in 'secret' table (Changes =", authDb.Changes(), ")."

    PRINT "-> Action: Retrieving user record from 'secret' table to verify authentication..."
    LET userQuery AS Data.DataFrame OR Error = authDb.Query("SELECT salt_hex, hash_hex FROM secret WHERE username = 'alice';")
    IF userQuery IS Error THEN
        PRINT "<- Result: FAILED to query secret table: Code =", userQuery.Code
        RETURN
    END IF

    LET storedSaltHex AS STRING OR NA OR Error = userQuery.GetString(0, "salt_hex")
    LET storedHashHex AS STRING OR NA OR Error = userQuery.GetString(0, "hash_hex")

    IF storedSaltHex IS STRING AND storedHashHex IS STRING THEN
        PRINT "<- Result: Stored credentials retrieved: salt_hex and hash_hex."

        PRINT "-> Action: Simulating login attempt with CORRECT password ('" + alicePass + "')..."
        LET decodedSalt AS Crypto.Bytes OR Error = Crypto.FromHex(storedSaltHex)
        IF decodedSalt IS Error THEN
            PRINT "<- Result: FAILED to decode salt hex: Code =", decodedSalt.Code
            RETURN
        END IF

        LET candOkInput AS Crypto.Bytes = Crypto.FromText(alicePass + appPepper)
        LET candOkHash AS Crypto.Bytes OR Error = Crypto.Argon2id(candOkInput, decodedSalt, 64, 1, 1)
        IF candOkHash IS Error THEN
            PRINT "<- Result: FAILED to derive candidate hash: Code =", candOkHash.Code
            RETURN
        END IF

        IF candOkHash.ToHex() = storedHashHex THEN
            PRINT "<- Result: Authentication SUCCESSFUL. Candidate hash matches stored hash exactly."
        ELSE
            PRINT "<- Result: Authentication FAILED unexpectedly: hashes do not match."
        END IF

        PRINT "-> Action: Simulating login attempt with INCORRECT password ('WrongPassword999')..."
        LET candBadInput AS Crypto.Bytes = Crypto.FromText("WrongPassword999" + appPepper)
        LET candBadHash AS Crypto.Bytes OR Error = Crypto.Argon2id(candBadInput, decodedSalt, 64, 1, 1)
        IF candBadHash IS Error THEN
            PRINT "<- Result: FAILED to derive candidate hash: Code =", candBadHash.Code
            RETURN
        END IF

        IF candBadHash.ToHex() = storedHashHex THEN
            PRINT "<- Result: UNEXPECTED SECURITY FAILURE: invalid password authenticated!"
        ELSE
            PRINT "<- Result: Authentication REJECTED as expected. Candidate hash differs from stored hash."
        END IF
    END IF

    PRINT "-> Action: Closing authentication database connection..."
    res = authDb.Close()
    IF res IS Error THEN
        PRINT "<- Result: FAILED to close authentication connection: Code =", res.Code
    ELSE
        PRINT "<- Result: Authentication database connection closed."
    END IF

    PRINT ""
    PRINT "=== Tour completed successfully ==="
END FUNCTION
