// Runtime trap: SHL overflow. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET big AS INTEGER = 1073741824
    PRINT big SHL 2
    RETURN 0
END FUNCTION
