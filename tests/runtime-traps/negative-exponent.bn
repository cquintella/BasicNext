// Runtime trap: negative integer exponent. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET e AS INTEGER = -1
    PRINT 2 ** e
    RETURN 0
END FUNCTION
