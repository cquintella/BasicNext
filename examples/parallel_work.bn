// Basic Next 0.5.0 BNDispatch example: typed parallel reductions.
IMPORT BNDispatch AS Dispatch

ASYNC FUNCTION WorkA() AS INTEGER OR Error
    LET total AS INTEGER = 0
    LET value AS INTEGER = 1
    WHILE value <= 1000
        total += value
        value += 1
    END WHILE
    RETURN total
END FUNCTION

ASYNC FUNCTION WorkB() AS INTEGER OR Error
    LET total AS INTEGER = 0
    LET value AS INTEGER = 1001
    WHILE value <= 2000
        total += value
        value += 1
    END WHILE
    RETURN total
END FUNCTION

ASYNC FUNCTION WorkC() AS INTEGER OR Error
    LET total AS INTEGER = 0
    LET value AS INTEGER = 2001
    WHILE value <= 3000
        total += value
        value += 1
    END WHILE
    RETURN total
END FUNCTION

ASYNC FUNCTION WorkD() AS INTEGER OR Error
    LET total AS INTEGER = 0
    LET value AS INTEGER = 3001
    WHILE value <= 4000
        total += value
        value += 1
    END WHILE
    RETURN total
END FUNCTION

FUNCTION Start() AS VOID
    LET queue AS Dispatch.Queue OR Error = Dispatch.Queue.Concurrent(4)
    IF queue IS Error THEN
        PRINT "queue error"
        RETURN
    END IF
    LET a AS Dispatch.Ticket OR Error = queue.Async(WorkA)
    LET b AS Dispatch.Ticket OR Error = queue.Async(WorkB)
    LET c AS Dispatch.Ticket OR Error = queue.Async(WorkC)
    LET d AS Dispatch.Ticket OR Error = queue.Async(WorkD)
    IF a IS Error THEN
        RETURN
    END IF
    IF b IS Error THEN
        RETURN
    END IF
    IF c IS Error THEN
        RETURN
    END IF
    IF d IS Error THEN
        RETURN
    END IF
    LET av AS INTEGER OR Error = AWAIT a(60000)
    LET bv AS INTEGER OR Error = AWAIT b(60000)
    LET cv AS INTEGER OR Error = AWAIT c(60000)
    LET dv AS INTEGER OR Error = AWAIT d(60000)
    IF av IS Error THEN
        RETURN
    END IF
    IF bv IS Error THEN
        RETURN
    END IF
    IF cv IS Error THEN
        RETURN
    END IF
    IF dv IS Error THEN
        RETURN
    END IF
    PRINT "sum 1..4000 = ", av + bv + cv + dv
    queue.Close(60000)
END FUNCTION
