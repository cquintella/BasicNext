
(*
  Basic Next Language Grammar 0.4

  Normative syntax for source files after lexical analysis. The companion
  0.4.md defines static semantics, runtime behaviour, and diagnostics.
  0.4 preserves the 0.3 and 0.2 grammar except as amended here. The
  ASYNC/AWAIT productions below are normative for 0.4 and are not part of
  the 0.3 grammar.

  Dialect: ISO 14977-style EBNF. Quoted text is a terminal; {} repeats zero
  or more times; [] is optional; () groups alternatives; and ?...? is a lexer
  predicate. The character range A…Z is inclusive. NEWLINE and EOF are lexer
  tokens, not source text. The lexer recognizes reserved-word and special-float-literal
  before identifier when their spelling is followed by a token boundary.
*)

(* Source unit *)

source-file          = program EOF ;
program              = { NEWLINE } { import-declaration { NEWLINE } }
                       { declaration { NEWLINE } } ;
import-declaration   = "IMPORT" import-path "AS" identifier NEWLINE ;
import-path          = host-import-path | module-import-path ;
host-import-path     = "HOST" "." importable-host-capability-name { "." identifier } ;
importable-host-capability-name = "Clock" | "Console" | "FileSystem" | "Net" | "Random" ;
host-capability-name = "Args" | "Clock" | "Console" | "FileSystem" | "Net" | "Random" ;
module-import-path   = identifier { "." identifier } ;
declaration          = [ "EXPORT" ] ( function-declaration | class-declaration
                       | struct-declaration | interface-declaration ) ;

(* A block admits blank and comment-only lines because the lexer emits NEWLINE. *)

statement-block      = { NEWLINE | statement } ;
member-block         = { NEWLINE | class-member } ;
struct-member-block  = { NEWLINE | struct-field-declaration } ;
interface-member-block = { NEWLINE | interface-function-declaration } ;

(* Module declarations *)

function-declaration = [ "ASYNC" ] "FUNCTION" identifier "(" [ parameters ] ")" "AS"
                       return-type NEWLINE statement-block "END" "FUNCTION" NEWLINE ;
class-declaration    = "CLASS" identifier [ "EXTENDS" named-type ] [ "IMPLEMENTS" interface-list ] NEWLINE
                       member-block "END" "CLASS" NEWLINE ;
struct-declaration   = "STRUCT" identifier NEWLINE struct-member-block
                       "END" "STRUCT" NEWLINE ;
interface-declaration = "INTERFACE" identifier NEWLINE interface-member-block
                       "END" "INTERFACE" NEWLINE ;
interface-list       = named-type { "," named-type } ;

class-member         = [ visibility ] ( static-member | field-declaration
                       | function-declaration | constructor-declaration
                       | destructor-declaration ) ;
visibility           = "PUBLIC" | "PRIVATE" ;
static-member        = "STATIC" ( static-field-declaration | function-declaration ) ;
field-declaration    = identifier "AS" variable-type [ "=" expression ] NEWLINE ;
static-field-declaration = identifier "AS" variable-type "=" expression NEWLINE ;
constructor-declaration = "FUNCTION" "CONSTRUCTOR" "(" [ parameters ] ")" NEWLINE
                       statement-block "END" "FUNCTION" NEWLINE ;
destructor-declaration = "FUNCTION" "DESTRUCTOR" "(" ")" NEWLINE statement-block
                       "END" "FUNCTION" NEWLINE ;
struct-field-declaration = identifier "AS" field-type [ "=" expression ] NEWLINE ;
interface-function-declaration = "FUNCTION" identifier "(" [ parameters ] ")"
                       "AS" return-type NEWLINE ;

(* VOID is permitted as a function return or an opaque pointer element. *)

parameters           = parameter { "," parameter } ;
parameter            = identifier "AS" parameter-type ;
return-type          = "VOID" | value-type ;
variable-type        = value-type ;
field-type           = value-type ;
parameter-type       = value-type ;
value-type           = data-type { "OR" ( data-type | "NULL" | "NA" | "EOF" ) } ;
local-value-type     = local-data-type { "OR" ( local-data-type | "NULL" | "NA" | "EOF" ) } ;
data-type            = scalar-type | vector-type | pointer-type | function-type
                       | named-type | system-type ;
local-data-type      = scalar-type | local-vector-type | pointer-type | function-type
                       | named-type | system-type ;
scalar-type          = "BOOLEAN" | numeric-type | "STRING" | "DATE" | "TIME"
                       | "TIMEZONE" ;
numeric-type         = "BYTE" | "INT8" | "INT16" | "INT32" | "INT64"
                       | "UINT16" | "UINT32" | "UINT64" | "FLOAT32"
                       | "FLOAT64" | "INTEGER" | "FLOAT" | "TIMESTAMP" ;
integer-type         = "BYTE" | "INT8" | "INT16" | "INT32" | "INT64"
                       | "UINT16" | "UINT32" | "UINT64" | "INTEGER" | "TIMESTAMP" ;
named-type           = identifier { "." identifier } ;
system-type          = "SYSTEM" ;
vector-type          = vector-element-type "[" integer-literal "]"
                       { "[" integer-literal "]" } ;
local-vector-type    = vector-element-type "[" expression "]"
                       { "[" expression "]" } ;
vector-element-type  = scalar-type | named-type ;
pointer-type         = "POINTER" "TO" pointer-element-type
                       [ "[" [ integer-literal ] "]" ] ;
pointer-element-type = numeric-type | named-type | "VOID" ;
function-type        = "FUNCTION" "(" [ parameter-type-list ] ")" "AS" return-type ;
parameter-type-list  = parameter-type { "," parameter-type } ;

(* Statements *)

(* `IMPORT HOST.Net AS alias`, `IMPORT BNLog AS alias`, and
   `IMPORT BNWeb AS alias` use the ordinary import productions. They introduce
   no keywords or special statement forms. *)

statement            = simple-statement NEWLINE | if-statement | while-statement
                       | repeat-statement | for-statement ;
simple-statement     = let-declaration | const-declaration | assignment-statement
                       | call-statement | print-statement | delete-statement
                       | return-statement | exit-statement | continue-statement
                       | stop-statement ;
let-declaration      = "LET" identifier { "," identifier } "AS" local-variable-type
                       [ "=" expression { "," expression } ] ;
local-variable-type  = local-value-type ;
const-declaration    = "CONST" identifier "AS" variable-type "=" expression ;
assignment-statement = assignment-target assignment-operator expression ;
assignment-target    = identifier { member-suffix | index-suffix }
                       | "SELF" member-suffix { member-suffix | index-suffix } ;
assignment-operator  = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "**=" ;
call-statement       = call-expression ;
print-statement      = "PRINT" [ expression-list ] ;
delete-statement     = "DELETE" expression ;
return-statement     = "RETURN" [ expression ] ;
exit-statement       = "EXIT" ( "FOR" | "WHILE" | "REPEAT" ) ;
continue-statement   = "CONTINUE" ( "FOR" | "WHILE" | "REPEAT" ) ;
stop-statement       = "STOP" expression ;

if-statement         = block-if-statement | single-line-if-statement ;
block-if-statement   = "IF" expression "THEN" NEWLINE statement-block
                       { "ELSE" "IF" expression "THEN" NEWLINE statement-block }
                       [ "ELSE" NEWLINE statement-block ] "END" "IF" NEWLINE ;
single-line-if-statement = "IF" expression "THEN" simple-statement
                       [ "ELSE" simple-statement ] NEWLINE ;
while-statement      = "WHILE" expression NEWLINE statement-block
                       "END" "WHILE" NEWLINE ;
repeat-statement     = "REPEAT" NEWLINE statement-block "UNTIL" expression NEWLINE
                       "END" "REPEAT" NEWLINE ;
for-statement        = counted-for-statement | for-each-statement ;
counted-for-statement = "FOR" identifier "AS" integer-type "=" expression "TO"
                       expression [ "STEP" expression ] NEWLINE statement-block
                       "END" "FOR" NEWLINE ;
for-each-statement   = "FOR" "EACH" identifier "AS" variable-type "IN" expression
                       NEWLINE statement-block "END" "FOR" NEWLINE ;

(* Expressions. Suffixes bind more tightly than unary operators. ** is right associative. *)

expression           = or-expression ;
or-expression        = xor-expression { "OR" xor-expression } ;
xor-expression       = and-expression { "XOR" and-expression } ;
and-expression       = is-expression { "AND" is-expression } ;
is-expression        = equality-expression [ "IS" is-test ] ;
is-test              = data-type | "NULL" | "NA" | "EOF" | "NAN" | "INF"
                       | "-" "INF" ;
equality-expression  = comparison-expression { ( "=" | "<>" ) comparison-expression } ;
comparison-expression = shift-expression { ( "<" | "<=" | ">" | ">=" ) shift-expression } ;
shift-expression     = additive-expression { ( "SHL" | "SHR" ) additive-expression } ;
additive-expression  = multiplicative-expression { ( "+" | "-" ) multiplicative-expression } ;
multiplicative-expression = unary-expression { ( "*" | "/" | "DIV" | "%" ) unary-expression } ;
unary-expression     = ( "NOT" | "-" ) unary-expression | power-expression ;
power-expression     = postfix-expression [ "**" unary-expression ] ;
postfix-expression   = primary { postfix-suffix } ;
postfix-suffix       = call-suffix | member-suffix | index-suffix | cast-suffix ;
call-expression      = primary { member-suffix | index-suffix | cast-suffix }
                       call-suffix { postfix-suffix } ;
call-suffix          = "(" [ expression-list ] ")" ;
member-suffix        = "." identifier ;
index-suffix         = "[" expression "]" ;
cast-suffix          = "AS" ( numeric-type | "BOOLEAN" ) ;
primary              = literal | identifier | "SELF" | "SUPER" | input-expression | len-expression
                       | sizeof-expression | host-capability-expression | new-expression
                       | vector-literal | async-submit-expression | await-expression
                       | "(" expression ")" ;
(* ASYNC has the explicit surface `ASYNC queue Function(args)`. The queue
   expression ends at the named function call; semantic analysis requires a
   Dispatch.Queue operand and a named function target. AWAIT has the surface
   `AWAIT ticket(timeoutMs)` and requires a Dispatch.Ticket operand. *)
async-submit-expression = "ASYNC" expression identifier "(" [ expression-list ] ")" ;
await-expression        = "AWAIT" expression "(" expression ")" ;
host-capability-expression = "HOST" "." host-capability-name ;
input-expression     = "INPUT" "(" ")" ;
len-expression       = "LEN" "(" expression ")" ;
sizeof-expression    = "SIZEOF" "(" expression ")" ;
new-expression       = "NEW" numeric-type [ "[" expression "]" ]
                       | "NEW" named-type "(" [ expression-list ] ")" ;
vector-literal       = "[" [ expression-list ] "]" ;
expression-list      = expression { "," expression } ;
literal              = integer-literal | floating-literal | string-literal
                       | "TRUE" | "FALSE" | "NULL" | "NA" | "EOF"
                       | special-float-literal ;

(* Lexical grammar *)

reserved-word        = "AND" | "AS" | "ASYNC" | "AWAIT" | "BOOLEAN" | "BYTE" | "CLASS" | "CONST"
                       | "CONSTRUCTOR" | "CONTINUE" | "DATE" | "DELETE" | "DESTRUCTOR" | "EACH" | "ELSE"
                       | "DIV" | "END" | "EOF" | "EXIT" | "EXPORT" | "EXTENDS" | "FALSE"
                       | "FLOAT" | "FLOAT32" | "FLOAT64" | "FOR" | "FUNCTION" | "HOST" | "IF"
                       | "IMPLEMENTS" | "IMPORT" | "IN" | "INPUT" | "INT8" | "INT16" | "INT32"
                       | "INT64" | "INTEGER" | "INTERFACE" | "IS" | "LEN" | "LET" | "NA" | "NEW" | "NOT"
                       | "NULL" | "OR" | "PARALLEL" | "POINTER" | "PRIVATE" | "PRINT"
                       | "PUBLIC" | "REPEAT" | "RETURN" | "SELF" | "SHL" | "SHR" | "SIZEOF" | "STATIC"
                       | "STEP" | "STOP" | "STRING" | "STRUCT" | "SUPER" | "SYSTEM" | "THEN" | "TO" | "TRUE"
                       | "TIMESTAMP" | "TIME" | "TIMEZONE" | "UINT16" | "UINT32" | "UINT64"
                       | "UNTIL" | "VOID" | "WHILE" | "XOR" ;
identifier           = identifier-start { identifier-continue } ;
identifier-start     = ASCII-letter | "_" ;
identifier-continue  = identifier-start | ASCII-digit ;
ASCII-letter         = "A"…"Z" | "a"…"z" ;
ASCII-digit          = "0"…"9" ;
integer-literal      = decimal-integer | binary-integer | hexadecimal-integer ;
decimal-integer      = ASCII-digit { ASCII-digit } ;
binary-integer       = "0b" binary-digit { binary-digit } ;
hexadecimal-integer  = "0x" hexadecimal-digit { hexadecimal-digit } ;
binary-digit         = "0" | "1" ;
hexadecimal-digit    = ASCII-digit | "A"…"F" | "a"…"f" ;
floating-literal     = ASCII-digit { ASCII-digit } "." ASCII-digit { ASCII-digit } ;
special-float-literal = "NAN" | "INF" ;
string-literal       = '"' { string-character | escape-sequence } '"' ;
escape-sequence      = '\\' ( '"' | '\\' ) ;
string-character     = ? Unicode scalar value except U+0000…U+001F, U+007F,
                       line ending, '"', and '\\' ? ;

line-comment         = "//" { source-character-except-line-ending } ;
block-comment        = "/*" { block-comment-character } "*/" ;
source-character-except-line-ending = ? Unicode scalar value except CR and LF ? ;
block-comment-character = ? source character sequence that does not begin */ ? ;
newline              = LF | CRLF ;
LF                   = ? U+000A ? ;
CRLF                 = ? U+000D U+000A ? ;

(* Lexing rules:
   - Source is valid UTF-8. Invalid UTF-8, an unterminated string/comment,
     a control character in a string, or an escape other than \" and \\ is a lexical error.
   - Spaces, tabs, and comments are whitespace. Each physical newline inside a
     block comment emits NEWLINE; a line comment leaves its trailing NEWLINE intact.
   - If the last meaningful token is not NEWLINE, the lexer inserts one NEWLINE
     immediately before EOF. Thus a final newline is optional in source text.
   - Numeric overflow is diagnosed after tokenization. Decimal leading zeros are
     allowed; no exponent, separator, suffix, .5, or 1. floating syntax exists.
     A candidate beginning with an ASCII digit and extending over ASCII letters,
     digits, underscores, or dots must match exactly `integer-literal` or
     `floating-literal`; otherwise it is a lexical error. A dot immediately
     followed by an ASCII digit is also a lexical error.
   - The lexer uses maximal munch. Its overlapping symbols, in priority order,
     include **= before ** before *=, <= >= <> before < > =, and += -= *= /= %=.
     // and /* start comments before / is emitted. Braces are not tokens in 0.2.
   - Exact-uppercase reserved words and the exact NAN and INF literals are never
     identifiers. `-INF` is the unary `-` operator applied to the `INF` literal;
     it is not a separate lexer token.
     EXTENDS and SUPER have grammar productions in 0.2.
     CLS, BEEP, and PRINTAT are not reserved in 0.2; console operations are
     methods on HOST.Console. PARALLEL is reserved lexical-only: it has no
     grammar production in 0.2.
*)
