// Only the exact uppercase spelling of a reserved word is reserved
// (keywords.md, "Reserved words are exact uppercase"): NEW is not a name.
FUNCTION Start() AS VOID
    LET NEW AS INTEGER = 1
    PRINT NEW
END FUNCTION
