// BNCrypto digest fixture: the FIPS 180-4 example messages routed through the
// provider seam. The expected digests are asserted in tests/runtime.rs and
// mirrored in tests/fixtures/crypto/sha-vectors.json.

IMPORT BNCrypto AS Crypto

FUNCTION Start() AS VOID
    PRINT Crypto.SHA256("")
    PRINT Crypto.SHA256("abc")
    PRINT Crypto.SHA512("")
    PRINT Crypto.SHA512("abc")
END FUNCTION
