// Runtime trap: a UINT32 index above the INT32 range (known issue K71: the
// native binary read it as -1).
FUNCTION Start() AS INTEGER
    LET values AS INTEGER[3] = [1, 2, 3]
    LET at AS UINT32 = 4294967295
    PRINT values[at]
    RETURN 0
END FUNCTION
