// A STRUCT literal inside a vector literal still needs one element per field
// (0.6.md, "STRUCT literals").
STRUCT Point
    X AS INTEGER = 0
    Y AS INTEGER = 0
END STRUCT

FUNCTION Start() AS VOID
    LET corners AS Point[2] = [[1], [2, 3]]
    PRINT corners[0].X
END FUNCTION
