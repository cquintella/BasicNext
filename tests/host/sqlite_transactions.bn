IMPORT BNData AS Data
IMPORT BNSqlite AS Sqlite

FUNCTION Start() AS INTEGER
    LET conn AS Sqlite.Connection OR Error = Sqlite.Open(":memory:")
    IF conn IS Error THEN
        PRINT "OPEN_FAILED:", conn.Code
        RETURN 1
    END IF

    LET res AS VOID OR Error = conn.Exec("CREATE TABLE tx_test (id INT, val TEXT);")
    IF res IS Error THEN
        PRINT "EXEC_FAILED:", res.Code
        RETURN 1
    END IF

    // 1. Transaction rolled back
    res = conn.Begin()
    res = conn.Exec("INSERT INTO tx_test VALUES (1, 'RolledBack');")
    res = conn.Rollback()

    LET q1 AS Data.DataFrame OR Error = conn.Query("SELECT COUNT(*) AS c FROM tx_test WHERE id = 1;")
    IF NOT (q1 IS Error) THEN
        LET c1 AS INTEGER OR NA OR Error = q1.GetInteger(0, "c")
        PRINT "AFTER_ROLLBACK_COUNT:", c1
    END IF

    // 2. Transaction committed
    res = conn.Begin()
    res = conn.Exec("INSERT INTO tx_test VALUES (2, 'Committed');")
    res = conn.Commit()

    LET q2 AS Data.DataFrame OR Error = conn.Query("SELECT id, val FROM tx_test WHERE id = 2;")
    IF NOT (q2 IS Error) THEN
        LET id2 AS INTEGER OR NA OR Error = q2.GetInteger(0, "id")
        LET val2 AS STRING OR NA OR Error = q2.GetString(0, "val")
        PRINT "AFTER_COMMIT:", id2, val2
    END IF

    res = conn.Close()
    PRINT "TX_COMPLETE"
    RETURN 0
END FUNCTION
