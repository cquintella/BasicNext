// BNCrypto.Bytes fixture: opaque buffers round-trip through hex and text, keep
// their length, and are freed by RELEASE. Malformed hex yields Error rather
// than a partial buffer.

IMPORT BNCrypto AS Crypto

FUNCTION Start() AS VOID
    LET text AS Crypto.Bytes = Crypto.FromText("abc")
    PRINT text.Length()
    PRINT text.ToHex()
    RELEASE text

    LET raw AS Crypto.Bytes OR Error = Crypto.FromHex("000fff")
    IF raw IS Error THEN
        PRINT "unexpected-error"
    ELSE
        PRINT raw.Length()
        PRINT raw.ToHex()
        RELEASE raw
    END IF

    LET bad AS Crypto.Bytes OR Error = Crypto.FromHex("abc")
    IF bad IS Error THEN
        PRINT "odd-length-rejected"
    ELSE
        PRINT "odd-length-accepted"
    END IF
END FUNCTION
