FUNCTION Start() AS VOID
    LET found AS INTEGER OR Error = HOST.NumProcs()
    PRINT found IS INTEGER, found IS Error
    IF found IS INTEGER THEN
        PRINT found > 0
    END IF
END FUNCTION
