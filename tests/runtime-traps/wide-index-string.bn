// Runtime trap: a STRING index of type UINT64 above the INT32 range (known
// issue K71: the native binary dropped the high bits).
FUNCTION Start() AS INTEGER
    LET text AS STRING = "abc"
    LET at AS UINT64 = 18446744073709551615
    PRINT text[at]
    RETURN 0
END FUNCTION
