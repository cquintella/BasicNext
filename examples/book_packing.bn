// book_packages.bn — packages the Basic Next book as an EPUB 3 file.
// Author: Carlos Quintella
// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this
// file, You can obtain one at http://mozilla.org/MPL/2.0/.
//
// Reads the Markdown chapters of docs/book/en in the order given by
// docs/book/en/toc.md, converts them to XHTML 5, and writes a complete
// EPUB 3 (with an EPUB 2 toc.ncx fallback): generated cover with the
// official logo, preface, table of contents, chapters, appendices, CSS,
// images and metadata. The ZIP container is written by this program with
// STORED entries and CRC-32 computed here, so nothing outside Basic Next
// is needed.
//
// Usage, from the repository root:
//   bni run examples/book_packages.bn -- [bookDir] [outputDir] [version]
// Defaults: docs/book/en, the current directory, and the workspace version
// read from Cargo.toml. Output: basic-next-book-en-<version>.epub

IMPORT HOST.FileSystem AS FS
IMPORT HOST.Clock AS Clock

CONST DEFAULT_BOOK_DIR AS STRING = "docs/book/en"
CONST DEFAULT_OUTPUT_DIR AS STRING = "."
CONST VERSION_FILE AS STRING = "Cargo.toml"
CONST LOGO_FILE AS STRING = "logo.png"
CONST BOOK_AUTHOR AS STRING = "Carlos Alvaro Quintella"
CONST BOOK_AUTHOR_SORT AS STRING = "Quintella, Carlos Alvaro"
CONST BOOK_PUBLISHER AS STRING = "Basic Next Project (basicnext.org)"
CONST BOOK_RIGHTS AS STRING = "Copyright Carlos Alvaro Quintella. Distributed under the Mozilla Public License 2.0."
CONST REPOSITORY_URL AS STRING = "https://github.com/cquintella/BasicNext/blob/main/docs/book/"
CONST OUTPUT_PREFIX AS STRING = "basic-next-book-en-"
CONST CONTENT_DIR AS STRING = "OEBPS/"
CONST BN_KEYWORDS AS STRING = "|AND|AS|ASYNC|AWAIT|CLASS|CONST|CONSTRUCTOR|CONTINUE|DESTRUCTOR|DIV|EACH|ELSE|END|EXIT|EXPORT|EXTENDS|FOR|FUNCTION|HOST|IF|IMPLEMENTS|IMPORT|IN|INPUT|INTERFACE|IS|LEN|LET|NEW|NOT|OR|OVERRIDE|PARALLEL|PRINT|PRIVATE|PROTECTED|PUBLIC|RELEASE|REPEAT|RETURN|SELF|SHL|SHR|SIZEOF|STATIC|STEP|STOP|STRUCT|SUPER|SYSTEM|THEN|TO|UNTIL|WEAK|WHILE|XOR|"
CONST BN_TYPES AS STRING = "|BOOLEAN|BYTE|DATE|FLOAT|FLOAT32|FLOAT64|INT8|INT16|INT32|INT64|INTEGER|POINTER|STRING|TIME|TIMESTAMP|TIMEZONE|UINT16|UINT32|UINT64|VOID|Error|"
CONST BN_LITERALS AS STRING = "|TRUE|FALSE|NULL|NA|EOF|NAN|INF|"
CONST ROLE_PREFACE AS STRING = "preface"
CONST ROLE_CHAPTER AS STRING = "chapter"
CONST ROLE_APPENDICES AS STRING = "appendices"
CONST ROLE_APPENDIX AS STRING = "appendix"

// ---------------------------------------------------------------------------
// Text helpers. STRING has no slice syntax and no method namespace, so the
// usual operations are written once here on top of LEN, indexing and +.
// ---------------------------------------------------------------------------

FUNCTION Newline() AS STRING
    LET lineFeed AS STRING OR Error = CHAR(10)
    IF lineFeed IS Error THEN
        RETURN " "
    END IF
    RETURN lineFeed
END FUNCTION

FUNCTION CodeOf(ch AS STRING) AS INTEGER
    LET code AS INTEGER OR Error = ASC(ch)
    IF code IS Error THEN
        RETURN -1
    END IF
    RETURN code
END FUNCTION

FUNCTION IsDigit(ch AS STRING) AS BOOLEAN
    LET code AS INTEGER = CodeOf(ch)
    RETURN code >= 48 AND code <= 57
END FUNCTION

FUNCTION IsAsciiLetter(ch AS STRING) AS BOOLEAN
    LET code AS INTEGER = CodeOf(ch)
    RETURN (code >= 65 AND code <= 90) OR (code >= 97 AND code <= 122)
END FUNCTION

FUNCTION IsWordChar(ch AS STRING) AS BOOLEAN
    RETURN IsAsciiLetter(ch) OR IsDigit(ch) OR ch = "_" OR CodeOf(ch) > 127
END FUNCTION

FUNCTION IsSpace(ch AS STRING) AS BOOLEAN
    LET code AS INTEGER = CodeOf(ch)
    RETURN code = 32 OR code = 9 OR code = 13 OR code = 10
END FUNCTION

FUNCTION IsAsciiPunctuation(ch AS STRING) AS BOOLEAN
    LET code AS INTEGER = CodeOf(ch)
    RETURN (code >= 33 AND code <= 47) OR (code >= 58 AND code <= 64) OR (code >= 91 AND code <= 96) OR (code >= 123 AND code <= 126)
END FUNCTION

FUNCTION Mid(text AS STRING, start AS INTEGER, count AS INTEGER) AS STRING
    LET result AS STRING = ""
    LET finish AS INTEGER = start + count
    IF finish > LEN(text) THEN finish = LEN(text)
    LET index AS INTEGER = start
    IF index < 0 THEN index = 0
    WHILE index < finish
        result += text[index]
        index += 1
    END WHILE
    RETURN result
END FUNCTION

FUNCTION FromIndex(text AS STRING, start AS INTEGER) AS STRING
    RETURN Mid(text, start, LEN(text) - start)
END FUNCTION

FUNCTION MatchesAt(text AS STRING, needle AS STRING, at AS INTEGER) AS BOOLEAN
    IF at < 0 OR at + LEN(needle) > LEN(text) THEN
        RETURN FALSE
    END IF
    FOR offset = 0 TO LEN(needle) - 1
        IF text[at + offset] <> needle[offset] THEN
            RETURN FALSE
        END IF
    END FOR
    RETURN TRUE
END FUNCTION

FUNCTION StartsWith(text AS STRING, prefix AS STRING) AS BOOLEAN
    RETURN MatchesAt(text, prefix, 0)
END FUNCTION

FUNCTION EndsWith(text AS STRING, suffix AS STRING) AS BOOLEAN
    RETURN MatchesAt(text, suffix, LEN(text) - LEN(suffix))
END FUNCTION

FUNCTION IndexOfFrom(text AS STRING, needle AS STRING, from AS INTEGER) AS INTEGER
    LET at AS INTEGER = from
    WHILE at + LEN(needle) <= LEN(text)
        IF MatchesAt(text, needle, at) THEN
            RETURN at
        END IF
        at += 1
    END WHILE
    RETURN -1
END FUNCTION

FUNCTION IndexOf(text AS STRING, needle AS STRING) AS INTEGER
    RETURN IndexOfFrom(text, needle, 0)
END FUNCTION

FUNCTION LastIndexOf(text AS STRING, needle AS STRING) AS INTEGER
    LET at AS INTEGER = LEN(text) - LEN(needle)
    WHILE at >= 0
        IF MatchesAt(text, needle, at) THEN
            RETURN at
        END IF
        at -= 1
    END WHILE
    RETURN -1
END FUNCTION

FUNCTION TrimLeft(text AS STRING) AS STRING
    LET start AS INTEGER = 0
    WHILE start < LEN(text) AND IsSpace(text[start])
        start += 1
    END WHILE
    RETURN FromIndex(text, start)
END FUNCTION

FUNCTION TrimRight(text AS STRING) AS STRING
    LET finish AS INTEGER = LEN(text)
    WHILE finish > 0 AND IsSpace(text[finish - 1])
        finish -= 1
    END WHILE
    RETURN Mid(text, 0, finish)
END FUNCTION

FUNCTION Trim(text AS STRING) AS STRING
    RETURN TrimRight(TrimLeft(text))
END FUNCTION

FUNCTION IsBlank(text AS STRING) AS BOOLEAN
    RETURN LEN(Trim(text)) = 0
END FUNCTION

FUNCTION Repeat(text AS STRING, times AS INTEGER) AS STRING
    LET result AS STRING = ""
    FOR counter = 1 TO times
        result += text
    END FOR
    RETURN result
END FUNCTION

FUNCTION ReplaceAll(text AS STRING, needle AS STRING, replacement AS STRING) AS STRING
    LET result AS STRING = ""
    LET at AS INTEGER = 0
    WHILE at < LEN(text)
        IF MatchesAt(text, needle, at) THEN
            result += replacement
            at += LEN(needle)
        ELSE
            result += text[at]
            at += 1
        END IF
    END WHILE
    RETURN result
END FUNCTION

FUNCTION Indentation(line AS STRING) AS INTEGER
    LET width AS INTEGER = 0
    LET at AS INTEGER = 0
    WHILE at < LEN(line)
        IF line[at] = " " THEN
            width += 1
        ELSE IF CodeOf(line[at]) = 9 THEN
            width += 4
        ELSE
            RETURN width
        END IF
        at += 1
    END WHILE
    RETURN width
END FUNCTION

FUNCTION RemoveIndentation(line AS STRING, width AS INTEGER) AS STRING
    LET removed AS INTEGER = 0
    LET at AS INTEGER = 0
    WHILE at < LEN(line) AND removed < width
        IF line[at] = " " THEN
            removed += 1
        ELSE IF CodeOf(line[at]) = 9 THEN
            removed += 4
        ELSE
            RETURN FromIndex(line, at)
        END IF
        at += 1
    END WHILE
    RETURN FromIndex(line, at)
END FUNCTION

FUNCTION DigitsValue(text AS STRING, start AS INTEGER, count AS INTEGER) AS INTEGER
    LET value AS INTEGER = 0
    FOR at = start TO start + count - 1
        value = value * 10 + (CodeOf(text[at]) - 48)
    END FOR
    RETURN value
END FUNCTION

FUNCTION EscapeXml(text AS STRING) AS STRING
    LET result AS STRING = ""
    FOR EACH ch IN text
        IF ch = "&" THEN
            result += "&amp;"
        ELSE IF ch = "<" THEN
            result += "&lt;"
        ELSE IF ch = ">" THEN
            result += "&gt;"
        ELSE IF ch = "\"" THEN
            result += "&quot;"
        ELSE
            result += ch
        END IF
    END FOR
    RETURN result
END FUNCTION

FUNCTION BaseName(path AS STRING) AS STRING
    RETURN FromIndex(path, LastIndexOf(path, "/") + 1)
END FUNCTION

FUNCTION WithoutExtension(fileName AS STRING) AS STRING
    LET dot AS INTEGER = LastIndexOf(fileName, ".")
    IF dot <= 0 THEN
        RETURN fileName
    END IF
    RETURN Mid(fileName, 0, dot)
END FUNCTION

FUNCTION ManifestId(fileName AS STRING) AS STRING
    LET result AS STRING = "item-"
    FOR EACH ch IN TOLOWER(fileName)
        IF IsAsciiLetter(ch) OR IsDigit(ch) THEN
            result += ch
        ELSE
            result += "-"
        END IF
    END FOR
    RETURN result
END FUNCTION

FUNCTION MediaTypeOf(fileName AS STRING) AS STRING
    LET lower AS STRING = TOLOWER(fileName)
    IF EndsWith(lower, ".png") THEN RETURN "image/png"
    IF EndsWith(lower, ".jpg") OR EndsWith(lower, ".jpeg") THEN RETURN "image/jpeg"
    IF EndsWith(lower, ".gif") THEN RETURN "image/gif"
    IF EndsWith(lower, ".webp") THEN RETURN "image/webp"
    IF EndsWith(lower, ".svg") THEN RETURN "image/svg+xml"
    IF EndsWith(lower, ".css") THEN RETURN "text/css"
    IF EndsWith(lower, ".ncx") THEN RETURN "application/x-dtbncx+xml"
    RETURN "application/xhtml+xml"
END FUNCTION

// ---------------------------------------------------------------------------
// Collections. Pointer regions of class objects are not allowed (NEW T[n]
// needs a primitive element type), so lists of objects are linked.
// ---------------------------------------------------------------------------

CLASS StringNode
    PUBLIC value AS STRING = ""
    PUBLIC following AS StringNode OR NULL = NULL

    PUBLIC FUNCTION CONSTRUCTOR(value AS STRING)
        SELF.value = value
    END FUNCTION
END CLASS

// Linked list of strings. Get remembers the last visited node, so the
// usual sequential scans (index 0, 1, 2, ...) cost O(1) per step.
CLASS StringList
    PRIVATE head AS StringNode OR NULL = NULL
    PRIVATE tail AS StringNode OR NULL = NULL
    PRIVATE cursor AS StringNode OR NULL = NULL
    PRIVATE cursorIndex AS INTEGER = 0
    PRIVATE used AS INTEGER = 0

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Count() AS INTEGER
        RETURN SELF.used
    END FUNCTION

    PRIVATE FUNCTION Rewind() AS VOID
        SELF.cursor = SELF.head
        SELF.cursorIndex = 0
    END FUNCTION

    PUBLIC FUNCTION Get(index AS INTEGER) AS STRING
        IF index < SELF.cursorIndex THEN
            SELF.Rewind()
        END IF
        LET node AS StringNode OR NULL = SELF.cursor
        IF NOT (node IS StringNode) THEN
            SELF.Rewind()
            node = SELF.head
        END IF
        WHILE node IS StringNode
            IF SELF.cursorIndex = index THEN
                SELF.cursor = node
                RETURN node.value
            END IF
            node = node.following
            SELF.cursorIndex += 1
        END WHILE
        SELF.Rewind()
        RETURN ""
    END FUNCTION

    PUBLIC FUNCTION Add(value AS STRING) AS VOID
        LET node AS StringNode = NEW StringNode(value)
        LET last AS StringNode OR NULL = SELF.tail
        IF last IS StringNode THEN
            last.following = node
        ELSE
            SELF.head = node
        END IF
        SELF.tail = node
        SELF.used += 1
    END FUNCTION

    PUBLIC FUNCTION RemoveLast() AS VOID
        IF SELF.used = 0 THEN
            RETURN
        END IF
        SELF.used -= 1
        SELF.Rewind()
        IF SELF.used = 0 THEN
            SELF.head = NULL
            SELF.tail = NULL
            RETURN
        END IF
        LET node AS StringNode OR NULL = SELF.head
        FOR step_ = 1 TO SELF.used - 1
            IF node IS StringNode THEN
                node = node.following
            END IF
        END FOR
        IF node IS StringNode THEN
            node.following = NULL
            SELF.tail = node
        END IF
    END FUNCTION

    PUBLIC FUNCTION Contains(value AS STRING) AS BOOLEAN
        FOR index = 0 TO SELF.used - 1
            IF SELF.Get(index) = value THEN
                RETURN TRUE
            END IF
        END FOR
        RETURN FALSE
    END FUNCTION

    PUBLIC FUNCTION Join(separator AS STRING) AS STRING
        LET result AS STRING = ""
        FOR index = 0 TO SELF.used - 1
            IF index > 0 THEN
                result += separator
            END IF
            result += SELF.Get(index)
        END FOR
        RETURN result
    END FUNCTION
END CLASS

FUNCTION SplitOn(text AS STRING, separator AS STRING) AS StringList
    LET parts AS StringList = NEW StringList()
    LET current AS STRING = ""
    LET at AS INTEGER = 0
    WHILE at < LEN(text)
        IF MatchesAt(text, separator, at) THEN
            parts.Add(current)
            current = ""
            at += LEN(separator)
        ELSE
            current += text[at]
            at += 1
        END IF
    END WHILE
    parts.Add(current)
    RETURN parts
END FUNCTION

FUNCTION NormalizePath(path AS STRING) AS STRING
    LET segments AS StringList = SplitOn(path, "/")
    LET kept AS StringList = NEW StringList()
    FOR index = 0 TO segments.Count() - 1
        LET segment AS STRING = segments.Get(index)
        IF segment = ".." AND kept.Count() > 0 AND kept.Get(kept.Count() - 1) <> ".." THEN
            kept.RemoveLast()
        ELSE IF segment <> "." AND (segment <> "" OR index = 0) THEN
            kept.Add(segment)
        END IF
    END FOR
    RETURN kept.Join("/")
END FUNCTION

// ---------------------------------------------------------------------------
// Bytes: growable byte buffer with little-endian and UTF-8 writers.
// ---------------------------------------------------------------------------

CLASS ByteBuffer
    PRIVATE bytes AS POINTER TO BYTE[] = NEW BYTE[4096]
    PRIVATE used AS INTEGER = 0

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Size() AS INTEGER
        RETURN SELF.used
    END FUNCTION

    PUBLIC FUNCTION Region() AS POINTER TO BYTE[]
        RETURN SELF.bytes
    END FUNCTION

    PUBLIC FUNCTION ByteAt(index AS INTEGER) AS BYTE
        RETURN SELF.bytes[index]
    END FUNCTION

    PRIVATE FUNCTION Reserve(extra AS INTEGER) AS VOID
        LET needed AS INTEGER = SELF.used + extra
        IF needed <= LEN(SELF.bytes) THEN
            RETURN
        END IF
        LET capacity AS INTEGER = LEN(SELF.bytes) * 2
        WHILE capacity < needed
            capacity *= 2
        END WHILE
        LET grown AS POINTER TO BYTE[] = NEW BYTE[capacity]
        FOR index = 0 TO SELF.used - 1
            grown[index] = SELF.bytes[index]
        END FOR
        SELF.bytes = grown
    END FUNCTION

    PUBLIC FUNCTION AppendByte(value AS INTEGER) AS VOID
        SELF.Reserve(1)
        SELF.bytes[SELF.used] = (value AND 255) AS BYTE
        SELF.used += 1
    END FUNCTION

    PUBLIC FUNCTION AppendUInt16(value AS INTEGER) AS VOID
        SELF.AppendByte(value)
        SELF.AppendByte(value SHR 8)
    END FUNCTION

    PUBLIC FUNCTION AppendUInt32(value AS UINT32) AS VOID
        FOR shift = 0 TO 24 STEP 8
            SELF.AppendByte(((value SHR shift) AND 255) AS INTEGER)
        END FOR
    END FUNCTION

    PUBLIC FUNCTION AppendRegion(region AS POINTER TO BYTE[], count AS INTEGER) AS VOID
        SELF.Reserve(count)
        FOR index = 0 TO count - 1
            SELF.bytes[SELF.used + index] = region[index]
        END FOR
        SELF.used += count
    END FUNCTION

    PUBLIC FUNCTION AppendText(text AS STRING) AS VOID
        FOR EACH ch IN text
            SELF.AppendCodePoint(CodeOf(ch))
        END FOR
    END FUNCTION

    PUBLIC FUNCTION AppendLine(text AS STRING) AS VOID
        SELF.AppendText(text)
        SELF.AppendByte(10)
    END FUNCTION

    PRIVATE FUNCTION AppendCodePoint(code AS INTEGER) AS VOID
        IF code < 0 THEN
            RETURN
        ELSE IF code < 128 THEN
            SELF.AppendByte(code)
        ELSE IF code < 2048 THEN
            SELF.AppendByte(192 OR (code SHR 6))
            SELF.AppendByte(128 OR (code AND 63))
        ELSE IF code < 65536 THEN
            SELF.AppendByte(224 OR (code SHR 12))
            SELF.AppendByte(128 OR ((code SHR 6) AND 63))
            SELF.AppendByte(128 OR (code AND 63))
        ELSE
            SELF.AppendByte(240 OR (code SHR 18))
            SELF.AppendByte(128 OR ((code SHR 12) AND 63))
            SELF.AppendByte(128 OR ((code SHR 6) AND 63))
            SELF.AppendByte(128 OR (code AND 63))
        END IF
    END FUNCTION
END CLASS

FUNCTION TextBytes(text AS STRING) AS ByteBuffer
    LET buffer AS ByteBuffer = NEW ByteBuffer()
    buffer.AppendText(text)
    RETURN buffer
END FUNCTION

FUNCTION ReadBinaryFile(path AS STRING) AS ByteBuffer OR Error
    LET opened AS FS.File OR Error = FS.Open(path, FS.READ)
    IF opened IS Error THEN
        RETURN opened
    END IF
    LET content AS ByteBuffer = NEW ByteBuffer()
    LET chunk AS POINTER TO BYTE[] = NEW BYTE[65536]
    LET finished AS BOOLEAN = FALSE
    WHILE NOT finished
        LET got AS INTEGER OR EOF OR Error = opened.ReadBytes(chunk)
        IF got IS Error THEN
            opened.Close()
            RETURN got
        ELSE IF got IS INTEGER THEN
            content.AppendRegion(chunk, got)
        ELSE
            finished = TRUE
        END IF
    END WHILE
    opened.Close()
    RETURN content
END FUNCTION

FUNCTION ReadTextLines(path AS STRING) AS StringList OR Error
    LET opened AS FS.File OR Error = FS.Open(path, FS.READ)
    IF opened IS Error THEN
        RETURN opened
    END IF
    LET lines AS StringList = NEW StringList()
    LET finished AS BOOLEAN = FALSE
    WHILE NOT finished
        LET line AS STRING OR EOF OR Error = opened.ReadLine()
        IF line IS Error THEN
            opened.Close()
            RETURN line
        ELSE IF line IS STRING THEN
            lines.Add(TrimRight(line))
        ELSE
            finished = TRUE
        END IF
    END WHILE
    opened.Close()
    RETURN lines
END FUNCTION

FUNCTION Base64Into(source AS ByteBuffer, target AS ByteBuffer) AS VOID
    LET alphabet AS STRING = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    LET at AS INTEGER = 0
    WHILE at < source.Size()
        LET remaining AS INTEGER = source.Size() - at
        LET b0 AS INTEGER = source.ByteAt(at) AS INTEGER
        LET b1 AS INTEGER = 0
        LET b2 AS INTEGER = 0
        IF remaining > 1 THEN b1 = source.ByteAt(at + 1) AS INTEGER
        IF remaining > 2 THEN b2 = source.ByteAt(at + 2) AS INTEGER
        LET group AS INTEGER = (b0 SHL 16) OR (b1 SHL 8) OR b2
        target.AppendText(alphabet[(group SHR 18) AND 63])
        target.AppendText(alphabet[(group SHR 12) AND 63])
        IF remaining > 1 THEN
            target.AppendText(alphabet[(group SHR 6) AND 63])
        ELSE
            target.AppendText("=")
        END IF
        IF remaining > 2 THEN
            target.AppendText(alphabet[group AND 63])
        ELSE
            target.AppendText("=")
        END IF
        at += 3
    END WHILE
END FUNCTION

// ---------------------------------------------------------------------------
// ZIP container (PKWARE APPNOTE): STORED entries, CRC-32 (IEEE 802.3).
// ---------------------------------------------------------------------------

CLASS Crc32
    PRIVATE table AS POINTER TO UINT32[] = NEW UINT32[256]

    PUBLIC FUNCTION CONSTRUCTOR()
        FOR slot = 0 TO 255
            LET value AS UINT32 = slot AS UINT32
            FOR bit = 1 TO 8
                IF (value AND 1) = 1 THEN
                    value = 0xEDB88320 XOR (value SHR 1)
                ELSE
                    value = value SHR 1
                END IF
            END FOR
            SELF.table[slot] = value
        END FOR
    END FUNCTION

    PUBLIC FUNCTION Of(buffer AS ByteBuffer) AS UINT32
        LET crc AS UINT32 = 0xFFFFFFFF
        LET data AS POINTER TO BYTE[] = buffer.Region()
        FOR index = 0 TO buffer.Size() - 1
            LET slot AS INTEGER = ((crc XOR (data[index] AS UINT32)) AND 255) AS INTEGER
            crc = SELF.table[slot] XOR (crc SHR 8)
        END FOR
        RETURN crc XOR 0xFFFFFFFF
    END FUNCTION
END CLASS

STRUCT DosStamp
    dosTime AS INTEGER
    dosDate AS INTEGER
END STRUCT

// rfc3339 is "YYYY-MM-DDTHH:MM:SS.mmmZ" as produced by Timestamp.Format.
FUNCTION DosStampOf(rfc3339 AS STRING) AS DosStamp
    LET year AS INTEGER = DigitsValue(rfc3339, 0, 4)
    LET month AS INTEGER = DigitsValue(rfc3339, 5, 2)
    LET day AS INTEGER = DigitsValue(rfc3339, 8, 2)
    LET hour AS INTEGER = DigitsValue(rfc3339, 11, 2)
    LET minute AS INTEGER = DigitsValue(rfc3339, 14, 2)
    LET second AS INTEGER = DigitsValue(rfc3339, 17, 2)
    LET stamp AS DosStamp = [(hour SHL 11) OR (minute SHL 5) OR (second DIV 2), ((year - 1980) SHL 9) OR (month SHL 5) OR day]
    RETURN stamp
END FUNCTION

CLASS ZipEntry
    PUBLIC name AS STRING = ""
    PUBLIC crc AS UINT32 = 0
    PUBLIC size AS INTEGER = 0
    PUBLIC offset AS INTEGER = 0
    PUBLIC following AS ZipEntry OR NULL = NULL

    PUBLIC FUNCTION CONSTRUCTOR(name AS STRING, crc AS UINT32, size AS INTEGER, offset AS INTEGER)
        SELF.name = name
        SELF.crc = crc
        SELF.size = size
        SELF.offset = offset
    END FUNCTION
END CLASS

CLASS ZipWriter
    PRIVATE target AS FS.File = NEW FS.File()
    PRIVATE stamp AS DosStamp
    PRIVATE checksum AS Crc32 = NEW Crc32()
    PRIVATE written AS INTEGER = 0
    PRIVATE entryCount AS INTEGER = 0
    PRIVATE firstEntry AS ZipEntry OR NULL = NULL
    PRIVATE lastEntry AS ZipEntry OR NULL = NULL

    PUBLIC FUNCTION CONSTRUCTOR(target AS FS.File, stamp AS DosStamp)
        SELF.target = target
        SELF.stamp = stamp
    END FUNCTION

    PUBLIC STATIC FUNCTION Create(path AS STRING, stamp AS DosStamp) AS ZipWriter OR Error
        LET opened AS FS.File OR Error = FS.Open(path, FS.WRITE)
        IF opened IS Error THEN
            RETURN opened
        END IF
        RETURN NEW ZipWriter(opened, stamp)
    END FUNCTION

    PUBLIC FUNCTION AddStored(name AS STRING, content AS ByteBuffer) AS VOID OR Error
        LET entry AS ZipEntry = NEW ZipEntry(name, SELF.checksum.Of(content), content.Size(), SELF.written)
        LET header AS ByteBuffer = NEW ByteBuffer()
        header.AppendUInt32(0x04034B50)
        header.AppendUInt16(20)
        SELF.AppendCommonFields(header, entry)
        header.AppendRegion(TextBytes(name).Region(), TextBytes(name).Size())
        LET headerWritten AS VOID OR Error = SELF.WriteBuffer(header)
        IF headerWritten IS Error THEN
            RETURN headerWritten
        END IF
        LET contentWritten AS VOID OR Error = SELF.WriteBuffer(content)
        IF contentWritten IS Error THEN
            RETURN contentWritten
        END IF
        SELF.Remember(entry)
        RETURN
    END FUNCTION

    PUBLIC FUNCTION Finish() AS VOID OR Error
        LET directoryStart AS INTEGER = SELF.written
        LET directory AS ByteBuffer = NEW ByteBuffer()
        LET node AS ZipEntry OR NULL = SELF.firstEntry
        WHILE node IS ZipEntry
            SELF.AppendDirectoryRecord(directory, node)
            node = node.following
        END WHILE
        LET directorySize AS INTEGER = directory.Size()
        directory.AppendUInt32(0x06054B50)
        directory.AppendUInt16(0)
        directory.AppendUInt16(0)
        directory.AppendUInt16(SELF.entryCount)
        directory.AppendUInt16(SELF.entryCount)
        directory.AppendUInt32(directorySize AS UINT32)
        directory.AppendUInt32(directoryStart AS UINT32)
        directory.AppendUInt16(0)
        LET directoryWritten AS VOID OR Error = SELF.WriteBuffer(directory)
        IF directoryWritten IS Error THEN
            SELF.target.Close()
            RETURN directoryWritten
        END IF
        RETURN SELF.target.Close()
    END FUNCTION

    PRIVATE FUNCTION AppendCommonFields(buffer AS ByteBuffer, entry AS ZipEntry) AS VOID
        buffer.AppendUInt16(0)
        buffer.AppendUInt16(0)
        buffer.AppendUInt16(SELF.stamp.dosTime)
        buffer.AppendUInt16(SELF.stamp.dosDate)
        buffer.AppendUInt32(entry.crc)
        buffer.AppendUInt32(entry.size AS UINT32)
        buffer.AppendUInt32(entry.size AS UINT32)
        buffer.AppendUInt16(TextBytes(entry.name).Size())
        buffer.AppendUInt16(0)
    END FUNCTION

    PRIVATE FUNCTION AppendDirectoryRecord(buffer AS ByteBuffer, entry AS ZipEntry) AS VOID
        buffer.AppendUInt32(0x02014B50)
        buffer.AppendUInt16(20)
        buffer.AppendUInt16(20)
        SELF.AppendCommonFields(buffer, entry)
        buffer.AppendUInt16(0)
        buffer.AppendUInt16(0)
        buffer.AppendUInt16(0)
        buffer.AppendUInt32(0)
        buffer.AppendUInt32(entry.offset AS UINT32)
        buffer.AppendText(entry.name)
    END FUNCTION

    PRIVATE FUNCTION WriteBuffer(buffer AS ByteBuffer) AS VOID OR Error
        LET result AS VOID OR Error = SELF.target.WriteBytes(buffer.Region(), buffer.Size())
        IF result IS Error THEN
            RETURN result
        END IF
        SELF.written += buffer.Size()
        RETURN
    END FUNCTION

    PRIVATE FUNCTION Remember(entry AS ZipEntry) AS VOID
        LET tail AS ZipEntry OR NULL = SELF.lastEntry
        IF tail IS ZipEntry THEN
            tail.following = entry
        ELSE
            SELF.firstEntry = entry
        END IF
        SELF.lastEntry = entry
        SELF.entryCount += 1
    END FUNCTION
END CLASS

// ---------------------------------------------------------------------------
// Book model: resources, headings, parts and link rewriting.
// ---------------------------------------------------------------------------

CLASS ResourceRegistry
    PUBLIC sources AS StringList = NEW StringList()
    PUBLIC packaged AS StringList = NEW StringList()

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    // Returns the path inside OEBPS/ under which the file will be packaged.
    PUBLIC FUNCTION Register(sourcePath AS STRING) AS STRING
        FOR index = 0 TO SELF.sources.Count() - 1
            IF SELF.sources.Get(index) = sourcePath THEN
                RETURN SELF.packaged.Get(index)
            END IF
        END FOR
        LET name AS STRING = "images/" + BaseName(sourcePath)
        IF SELF.packaged.Contains(name) THEN
            name = "images/r" + (SELF.sources.Count() AS STRING) + "-" + BaseName(sourcePath)
        END IF
        SELF.sources.Add(sourcePath)
        SELF.packaged.Add(name)
        RETURN name
    END FUNCTION
END CLASS

FUNCTION PlainText(markdown AS STRING) AS STRING
    LET result AS STRING = ""
    LET at AS INTEGER = 0
    WHILE at < LEN(markdown)
        LET ch AS STRING = markdown[at]
        IF ch = "]" AND MatchesAt(markdown, "](", at) THEN
            LET close AS INTEGER = IndexOfFrom(markdown, ")", at)
            IF close < 0 THEN close = LEN(markdown) - 1
            at = close + 1
        ELSE IF ch = "\\" AND at + 1 < LEN(markdown) THEN
            result += markdown[at + 1]
            at += 2
        ELSE
            IF ch <> "`" AND ch <> "*" AND ch <> "[" AND ch <> "!" THEN
                result += ch
            END IF
            at += 1
        END IF
    END WHILE
    RETURN Trim(result)
END FUNCTION

// GitHub-compatible heading anchor: lowercase, punctuation removed,
// spaces become hyphens.
FUNCTION Slugify(plain AS STRING) AS STRING
    LET slug AS STRING = ""
    FOR EACH ch IN TOLOWER(plain)
        IF ch = " " THEN
            slug += "-"
        ELSE IF IsWordChar(ch) OR ch = "-" THEN
            slug += ch
        END IF
    END FOR
    IF slug = "" THEN
        RETURN "section"
    END IF
    RETURN slug
END FUNCTION

CLASS HeadingCollector
    PUBLIC title AS STRING = ""
    PUBLIC sectionIds AS StringList = NEW StringList()
    PUBLIC sectionTitles AS StringList = NEW StringList()
    PRIVATE usedIds AS StringList = NEW StringList()

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Register(level AS INTEGER, markdown AS STRING) AS STRING
        LET plain AS STRING = PlainText(markdown)
        LET base AS STRING = Slugify(plain)
        LET id AS STRING = base
        LET suffix AS INTEGER = 1
        WHILE SELF.usedIds.Contains(id)
            id = base + "-" + (suffix AS STRING)
            suffix += 1
        END WHILE
        SELF.usedIds.Add(id)
        IF level = 1 AND SELF.title = "" THEN
            SELF.title = plain
        ELSE IF level = 2 THEN
            SELF.sectionIds.Add(id)
            SELF.sectionTitles.Add(plain)
        END IF
        RETURN id
    END FUNCTION
END CLASS

CLASS BookPart
    PUBLIC sourceName AS STRING = ""
    PUBLIC xhtmlName AS STRING = ""
    PUBLIC label AS STRING = ""
    PUBLIC role AS STRING = ""
    PUBLIC headings AS HeadingCollector = NEW HeadingCollector()
    PUBLIC page AS ByteBuffer = NEW ByteBuffer()
    PUBLIC following AS BookPart OR NULL = NULL

    PUBLIC FUNCTION CONSTRUCTOR(sourceName AS STRING, label AS STRING, role AS STRING)
        SELF.sourceName = sourceName
        SELF.xhtmlName = WithoutExtension(sourceName) + ".xhtml"
        SELF.label = label
        SELF.role = role
    END FUNCTION

    PUBLIC FUNCTION Title() AS STRING
        IF SELF.headings.title <> "" THEN
            RETURN SELF.headings.title
        END IF
        RETURN SELF.label
    END FUNCTION
END CLASS

CLASS PartList
    PUBLIC first AS BookPart OR NULL = NULL
    PRIVATE last AS BookPart OR NULL = NULL
    PUBLIC names AS StringList = NEW StringList()

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Add(part AS BookPart) AS VOID
        IF SELF.names.Contains(part.sourceName) THEN
            RETURN
        END IF
        LET tail AS BookPart OR NULL = SELF.last
        IF tail IS BookPart THEN
            tail.following = part
        ELSE
            SELF.first = part
        END IF
        SELF.last = part
        SELF.names.Add(part.sourceName)
    END FUNCTION

    PUBLIC FUNCTION FirstWithRole(role AS STRING) AS BookPart OR NULL
        LET node AS BookPart OR NULL = SELF.first
        WHILE node IS BookPart
            IF node.role = role THEN
                RETURN node
            END IF
            node = node.following
        END WHILE
        RETURN NULL
    END FUNCTION
END CLASS

CLASS LinkRewriter
    PRIVATE bookDir AS STRING = ""
    PRIVATE bookFiles AS StringList = NEW StringList()
    PRIVATE resources AS ResourceRegistry = NEW ResourceRegistry()

    PUBLIC FUNCTION CONSTRUCTOR(bookDir AS STRING, bookFiles AS StringList, resources AS ResourceRegistry)
        SELF.bookDir = bookDir
        SELF.bookFiles = bookFiles
        SELF.resources = resources
    END FUNCTION

    PUBLIC FUNCTION Link(url AS STRING) AS STRING
        IF IsExternal(url) OR StartsWith(url, "#") THEN
            RETURN url
        END IF
        LET hash AS INTEGER = IndexOf(url, "#")
        LET path AS STRING = url
        LET fragment AS STRING = ""
        IF hash >= 0 THEN
            path = Mid(url, 0, hash)
            fragment = FromIndex(url, hash)
        END IF
        IF path = "toc.md" THEN
            RETURN "nav.xhtml" + fragment
        END IF
        IF SELF.bookFiles.Contains(path) THEN
            RETURN WithoutExtension(path) + ".xhtml" + fragment
        END IF
        RETURN REPOSITORY_URL + NormalizePath("en/" + path) + fragment
    END FUNCTION

    // Returns the packaged path, or "" when the image cannot be packaged
    // (remote images are not allowed inside the book).
    PUBLIC FUNCTION Image(url AS STRING) AS STRING
        IF IsExternal(url) THEN
            RETURN ""
        END IF
        LET sourcePath AS STRING = NormalizePath(SELF.bookDir + "/" + url)
        LET exists AS BOOLEAN OR Error = FS.Exists(sourcePath)
        IF exists IS Error THEN
            RETURN ""
        ELSE IF NOT exists THEN
            RETURN ""
        END IF
        RETURN SELF.resources.Register(sourcePath)
    END FUNCTION
END CLASS

FUNCTION IsExternal(url AS STRING) AS BOOLEAN
    RETURN StartsWith(url, "http://") OR StartsWith(url, "https://") OR StartsWith(url, "mailto:")
END FUNCTION

// ---------------------------------------------------------------------------
// Inline Markdown: code spans, links, images, emphasis, autolinks, escapes.
// ---------------------------------------------------------------------------

STRUCT LinkMatch
    found AS BOOLEAN
    label AS STRING
    url AS STRING
    finish AS INTEGER
END STRUCT

FUNCTION MatchingClose(text AS STRING, openAt AS INTEGER, opener AS STRING, closer AS STRING) AS INTEGER
    LET depth AS INTEGER = 0
    LET at AS INTEGER = openAt
    WHILE at < LEN(text)
        IF text[at] = "\\" THEN
            at += 1
        ELSE IF text[at] = opener THEN
            depth += 1
        ELSE IF text[at] = closer THEN
            depth -= 1
            IF depth = 0 THEN
                RETURN at
            END IF
        END IF
        at += 1
    END WHILE
    RETURN -1
END FUNCTION

FUNCTION MatchLink(text AS STRING, openAt AS INTEGER) AS LinkMatch
    LET none AS LinkMatch = [FALSE, "", "", openAt]
    LET closeLabel AS INTEGER = MatchingClose(text, openAt, "[", "]")
    IF closeLabel < 0 OR closeLabel + 1 >= LEN(text) THEN
        RETURN none
    END IF
    IF text[closeLabel + 1] <> "(" THEN
        RETURN none
    END IF
    LET closeUrl AS INTEGER = MatchingClose(text, closeLabel + 1, "(", ")")
    IF closeUrl < 0 THEN
        RETURN none
    END IF
    LET target AS STRING = Trim(Mid(text, closeLabel + 2, closeUrl - closeLabel - 2))
    LET space AS INTEGER = IndexOf(target, " ")
    IF space > 0 THEN
        target = Mid(target, 0, space)
    END IF
    IF StartsWith(target, "<") AND EndsWith(target, ">") THEN
        target = Mid(target, 1, LEN(target) - 2)
    END IF
    LET found AS LinkMatch = [TRUE, Mid(text, openAt + 1, closeLabel - openAt - 1), target, closeUrl + 1]
    RETURN found
END FUNCTION

FUNCTION RunLength(text AS STRING, at AS INTEGER) AS INTEGER
    LET count AS INTEGER = 0
    WHILE at + count < LEN(text) AND text[at + count] = text[at]
        count += 1
    END WHILE
    RETURN count
END FUNCTION

FUNCTION CodeSpanEnd(text AS STRING, at AS INTEGER, ticks AS INTEGER) AS INTEGER
    LET fence AS STRING = Repeat("`", ticks)
    LET candidate AS INTEGER = IndexOfFrom(text, fence, at + ticks)
    WHILE candidate >= 0
        IF RunLength(text, candidate) = ticks THEN
            RETURN candidate
        END IF
        candidate = IndexOfFrom(text, fence, candidate + RunLength(text, candidate))
    END WHILE
    RETURN -1
END FUNCTION

FUNCTION CodeSpan(content AS STRING) AS STRING
    LET code AS STRING = content
    IF LEN(code) >= 2 AND StartsWith(code, " ") AND EndsWith(code, " ") AND NOT IsBlank(code) THEN
        code = Mid(code, 1, LEN(code) - 2)
    END IF
    RETURN "<code>" + EscapeXml(code) + "</code>"
END FUNCTION

FUNCTION EmphasisEnd(text AS STRING, at AS INTEGER, marker AS STRING) AS INTEGER
    LET width AS INTEGER = LEN(marker)
    IF at + width >= LEN(text) OR IsSpace(text[at + width]) THEN
        RETURN -1
    END IF
    IF marker[0] = "_" AND at > 0 AND IsWordChar(text[at - 1]) THEN
        RETURN -1
    END IF
    LET candidate AS INTEGER = IndexOfFrom(text, marker, at + width + 1)
    WHILE candidate >= 0
        LET closesAfterText AS BOOLEAN = NOT IsSpace(text[candidate - 1])
        LET exactRun AS BOOLEAN = RunLength(text, candidate) = width OR width = 2
        LET boundaryOk AS BOOLEAN = TRUE
        IF marker[0] = "_" AND candidate + width < LEN(text) THEN
            boundaryOk = NOT IsWordChar(text[candidate + width])
        END IF
        IF closesAfterText AND exactRun AND boundaryOk THEN
            RETURN candidate
        END IF
        candidate = IndexOfFrom(text, marker, candidate + 1)
    END WHILE
    RETURN -1
END FUNCTION

FUNCTION WrapEmphasis(inner AS STRING, width AS INTEGER) AS STRING
    IF width = 1 THEN
        RETURN "<em>" + inner + "</em>"
    ELSE IF width = 2 THEN
        RETURN "<strong>" + inner + "</strong>"
    END IF
    RETURN "<strong><em>" + inner + "</em></strong>"
END FUNCTION

FUNCTION ImageTag(found AS LinkMatch, links AS LinkRewriter) AS STRING
    LET alt AS STRING = EscapeXml(PlainText(found.label))
    LET source AS STRING = links.Image(found.url)
    IF source = "" THEN
        RETURN "<span class=\"missing-image\">" + alt + "</span>"
    END IF
    RETURN "<img src=\"" + EscapeXml(source) + "\" alt=\"" + alt + "\"/>"
END FUNCTION

FUNCTION AnchorTag(found AS LinkMatch, links AS LinkRewriter) AS STRING
    LET href AS STRING = links.Link(found.url)
    LET classes AS STRING = ""
    IF IsExternal(href) THEN
        classes = " class=\"external\""
    END IF
    RETURN "<a href=\"" + EscapeXml(href) + "\"" + classes + ">" + Inline(found.label, links) + "</a>"
END FUNCTION

FUNCTION Inline(text AS STRING, links AS LinkRewriter) AS STRING
    LET html AS STRING = ""
    LET at AS INTEGER = 0
    WHILE at < LEN(text)
        LET ch AS STRING = text[at]
        LET consumed AS BOOLEAN = FALSE
        IF ch = "\\" AND at + 1 < LEN(text) AND IsAsciiPunctuation(text[at + 1]) THEN
            html += EscapeXml(text[at + 1])
            at += 2
            consumed = TRUE
        ELSE IF ch = "`" THEN
            LET ticks AS INTEGER = RunLength(text, at)
            LET spanEnd AS INTEGER = CodeSpanEnd(text, at, ticks)
            IF spanEnd >= 0 THEN
                html += CodeSpan(Mid(text, at + ticks, spanEnd - at - ticks))
                at = spanEnd + ticks
            ELSE
                html += Repeat("`", ticks)
                at += ticks
            END IF
            consumed = TRUE
        ELSE IF ch = "!" AND MatchesAt(text, "![", at) THEN
            LET picture AS LinkMatch = MatchLink(text, at + 1)
            IF picture.found THEN
                html += ImageTag(picture, links)
                at = picture.finish
                consumed = TRUE
            END IF
        ELSE IF ch = "[" THEN
            LET anchor AS LinkMatch = MatchLink(text, at)
            IF anchor.found THEN
                html += AnchorTag(anchor, links)
                at = anchor.finish
                consumed = TRUE
            END IF
        ELSE IF ch = "<" THEN
            LET autolinkEnd AS INTEGER = IndexOfFrom(text, ">", at)
            IF autolinkEnd > at AND IsExternal(Mid(text, at + 1, autolinkEnd - at - 1)) THEN
                LET address AS STRING = EscapeXml(Mid(text, at + 1, autolinkEnd - at - 1))
                html += "<a href=\"" + address + "\" class=\"external\">" + address + "</a>"
                at = autolinkEnd + 1
                consumed = TRUE
            END IF
        ELSE IF ch = "*" OR ch = "_" THEN
            LET width AS INTEGER = RunLength(text, at)
            IF width > 3 THEN width = 3
            LET marker AS STRING = Repeat(ch, width)
            LET closing AS INTEGER = EmphasisEnd(text, at, marker)
            IF closing > 0 THEN
                html += WrapEmphasis(Inline(Mid(text, at + width, closing - at - width), links), width)
                at = closing + width
            ELSE
                html += marker
                at += width
            END IF
            consumed = TRUE
        END IF
        IF NOT consumed THEN
            html += EscapeXml(ch)
            at += 1
        END IF
    END WHILE
    RETURN html
END FUNCTION

// ---------------------------------------------------------------------------
// Basic Next syntax highlighting for fenced code blocks.
// ---------------------------------------------------------------------------

FUNCTION IsHighlightedLanguage(language AS STRING) AS BOOLEAN
    LET lower AS STRING = TOLOWER(language)
    RETURN lower = "basic" OR lower = "basicnext" OR lower = "bn"
END FUNCTION

FUNCTION Span(cssClass AS STRING, text AS STRING) AS STRING
    RETURN "<span class=\"" + cssClass + "\">" + EscapeXml(text) + "</span>"
END FUNCTION

FUNCTION WordClass(word AS STRING) AS STRING
    LET key AS STRING = "|" + word + "|"
    IF IndexOf(BN_KEYWORDS, key) >= 0 THEN RETURN "k"
    IF IndexOf(BN_TYPES, key) >= 0 THEN RETURN "t"
    IF IndexOf(BN_LITERALS, key) >= 0 THEN RETURN "l"
    RETURN ""
END FUNCTION

FUNCTION StringLiteralEnd(line AS STRING, at AS INTEGER) AS INTEGER
    LET cursor AS INTEGER = at + 1
    WHILE cursor < LEN(line)
        IF line[cursor] = "\\" THEN
            cursor += 2
        ELSE IF line[cursor] = "\"" THEN
            RETURN cursor + 1
        ELSE
            cursor += 1
        END IF
    END WHILE
    RETURN LEN(line)
END FUNCTION

FUNCTION HighlightBasicLine(line AS STRING) AS STRING
    LET html AS STRING = ""
    LET at AS INTEGER = 0
    WHILE at < LEN(line)
        LET ch AS STRING = line[at]
        IF MatchesAt(line, "//", at) THEN
            html += Span("c", FromIndex(line, at))
            at = LEN(line)
        ELSE IF ch = "\"" THEN
            LET literalEnd AS INTEGER = StringLiteralEnd(line, at)
            html += Span("s", Mid(line, at, literalEnd - at))
            at = literalEnd
        ELSE IF IsDigit(ch) THEN
            LET numberEnd AS INTEGER = at
            WHILE numberEnd < LEN(line) AND (IsWordChar(line[numberEnd]) OR line[numberEnd] = ".")
                numberEnd += 1
            END WHILE
            html += Span("n", Mid(line, at, numberEnd - at))
            at = numberEnd
        ELSE IF IsAsciiLetter(ch) OR ch = "_" THEN
            LET wordEnd AS INTEGER = at
            WHILE wordEnd < LEN(line) AND (IsAsciiLetter(line[wordEnd]) OR IsDigit(line[wordEnd]) OR line[wordEnd] = "_")
                wordEnd += 1
            END WHILE
            LET word AS STRING = Mid(line, at, wordEnd - at)
            LET cssClass AS STRING = WordClass(word)
            IF cssClass = "" THEN
                html += EscapeXml(word)
            ELSE
                html += Span(cssClass, word)
            END IF
            at = wordEnd
        ELSE
            html += EscapeXml(ch)
            at += 1
        END IF
    END WHILE
    RETURN html
END FUNCTION

// ---------------------------------------------------------------------------
// Block Markdown: headings, paragraphs, fenced code, lists, block quotes,
// callouts, GFM tables and thematic breaks. Output goes straight into a
// ByteBuffer because repeated STRING concatenation is quadratic.
// ---------------------------------------------------------------------------

FUNCTION IsFence(line AS STRING) AS BOOLEAN
    LET trimmed AS STRING = TrimLeft(line)
    RETURN StartsWith(trimmed, "```") OR StartsWith(trimmed, "~~~")
END FUNCTION

FUNCTION HeadingLevel(line AS STRING) AS INTEGER
    IF Indentation(line) > 3 THEN
        RETURN 0
    END IF
    LET trimmed AS STRING = TrimLeft(line)
    LET level AS INTEGER = 0
    WHILE level < LEN(trimmed) AND trimmed[level] = "#"
        level += 1
    END WHILE
    IF level < 1 OR level > 6 THEN
        RETURN 0
    END IF
    IF level < LEN(trimmed) AND trimmed[level] <> " " THEN
        RETURN 0
    END IF
    RETURN level
END FUNCTION

FUNCTION IsThematicBreak(line AS STRING) AS BOOLEAN
    LET compact AS STRING = ReplaceAll(Trim(line), " ", "")
    IF LEN(compact) < 3 THEN
        RETURN FALSE
    END IF
    LET mark AS STRING = compact[0]
    IF mark <> "-" AND mark <> "*" AND mark <> "_" THEN
        RETURN FALSE
    END IF
    RETURN RunLength(compact, 0) = LEN(compact)
END FUNCTION

FUNCTION IsQuote(line AS STRING) AS BOOLEAN
    RETURN StartsWith(TrimLeft(line), ">")
END FUNCTION

// Length of the list marker including the following space, or 0.
FUNCTION ListMarkerWidth(line AS STRING) AS INTEGER
    LET trimmed AS STRING = TrimLeft(line)
    IF LEN(trimmed) >= 2 AND (trimmed[0] = "-" OR trimmed[0] = "*" OR trimmed[0] = "+") AND trimmed[1] = " " THEN
        RETURN 2
    END IF
    LET digits AS INTEGER = 0
    WHILE digits < LEN(trimmed) AND IsDigit(trimmed[digits])
        digits += 1
    END WHILE
    IF digits = 0 OR digits > 9 OR digits + 1 >= LEN(trimmed) THEN
        RETURN 0
    END IF
    IF (trimmed[digits] = "." OR trimmed[digits] = ")") AND trimmed[digits + 1] = " " THEN
        RETURN digits + 2
    END IF
    RETURN 0
END FUNCTION

FUNCTION IsListItem(line AS STRING) AS BOOLEAN
    RETURN ListMarkerWidth(line) > 0 AND NOT IsThematicBreak(line)
END FUNCTION

FUNCTION IsOrderedItem(line AS STRING) AS BOOLEAN
    RETURN IsListItem(line) AND IsDigit(TrimLeft(line)[0])
END FUNCTION

FUNCTION IsTableRow(line AS STRING) AS BOOLEAN
    RETURN StartsWith(Trim(line), "|")
END FUNCTION

FUNCTION IsTableDelimiter(line AS STRING) AS BOOLEAN
    LET trimmed AS STRING = Trim(line)
    IF NOT StartsWith(trimmed, "|") OR IndexOf(trimmed, "-") < 0 THEN
        RETURN FALSE
    END IF
    FOR EACH ch IN trimmed
        IF ch <> "|" AND ch <> "-" AND ch <> ":" AND ch <> " " THEN
            RETURN FALSE
        END IF
    END FOR
    RETURN TRUE
END FUNCTION

// Splits a GFM table row on "|" outside code spans and escapes.
FUNCTION TableCells(line AS STRING) AS StringList
    LET row AS STRING = Trim(line)
    IF StartsWith(row, "|") THEN row = FromIndex(row, 1)
    IF EndsWith(row, "|") AND NOT EndsWith(row, "\\|") THEN row = Mid(row, 0, LEN(row) - 1)
    LET cells AS StringList = NEW StringList()
    LET current AS STRING = ""
    LET inCode AS BOOLEAN = FALSE
    LET at AS INTEGER = 0
    WHILE at < LEN(row)
        LET ch AS STRING = row[at]
        IF ch = "\\" AND at + 1 < LEN(row) AND row[at + 1] = "|" THEN
            current += "|"
            at += 2
        ELSE
            IF ch = "`" THEN
                inCode = NOT inCode
            END IF
            IF ch = "|" AND NOT inCode THEN
                cells.Add(Trim(current))
                current = ""
            ELSE
                current += ch
            END IF
            at += 1
        END IF
    END WHILE
    cells.Add(Trim(current))
    RETURN cells
END FUNCTION

FUNCTION AlignmentClass(delimiterCell AS STRING) AS STRING
    LET left AS BOOLEAN = StartsWith(delimiterCell, ":")
    LET right AS BOOLEAN = EndsWith(delimiterCell, ":")
    IF left AND right THEN RETURN " class=\"align-center\""
    IF right THEN RETURN " class=\"align-right\""
    RETURN ""
END FUNCTION

FUNCTION CalloutKind(firstLine AS STRING) AS STRING
    LET lower AS STRING = TOLOWER(Trim(firstLine))
    IF StartsWith(lower, "**note") OR StartsWith(lower, "[!note]") THEN RETURN "note"
    IF StartsWith(lower, "**tip") OR StartsWith(lower, "[!tip]") THEN RETURN "tip"
    IF StartsWith(lower, "**warning") OR StartsWith(lower, "**caution") OR StartsWith(lower, "[!warning]") THEN RETURN "warning"
    IF StartsWith(lower, "**important") OR StartsWith(lower, "[!important]") THEN RETURN "important"
    IF StartsWith(lower, "**draft") THEN RETURN "draft"
    RETURN ""
END FUNCTION

FUNCTION StartsBlock(line AS STRING) AS BOOLEAN
    RETURN IsFence(line) OR HeadingLevel(line) > 0 OR IsThematicBreak(line) OR IsQuote(line) OR IsListItem(line) OR IsTableRow(line)
END FUNCTION

CLASS MarkdownConverter
    PRIVATE lines AS StringList = NEW StringList()
    PRIVATE position AS INTEGER = 0
    PRIVATE links AS LinkRewriter = NEW LinkRewriter("", NEW StringList(), NEW ResourceRegistry())
    PRIVATE headings AS HeadingCollector = NEW HeadingCollector()
    PRIVATE out AS ByteBuffer = NEW ByteBuffer()
    PRIVATE tight AS BOOLEAN = FALSE

    PUBLIC FUNCTION CONSTRUCTOR(lines AS StringList, links AS LinkRewriter, headings AS HeadingCollector, out AS ByteBuffer, tight AS BOOLEAN)
        SELF.lines = lines
        SELF.links = links
        SELF.headings = headings
        SELF.out = out
        SELF.tight = tight
    END FUNCTION

    PUBLIC FUNCTION Convert() AS VOID
        WHILE SELF.HasLine()
            SELF.ConvertBlock()
        END WHILE
    END FUNCTION

    PRIVATE FUNCTION HasLine() AS BOOLEAN
        RETURN SELF.position < SELF.lines.Count()
    END FUNCTION

    PRIVATE FUNCTION Current() AS STRING
        RETURN SELF.lines.Get(SELF.position)
    END FUNCTION

    PRIVATE FUNCTION Emit(html AS STRING) AS VOID
        SELF.out.AppendLine(html)
    END FUNCTION

    PRIVATE FUNCTION ConvertNested(blockLines AS StringList, tightBlock AS BOOLEAN) AS VOID
        LET nested AS MarkdownConverter = NEW MarkdownConverter(blockLines, SELF.links, SELF.headings, SELF.out, tightBlock)
        nested.Convert()
    END FUNCTION

    PRIVATE FUNCTION ConvertBlock() AS VOID
        LET line AS STRING = SELF.Current()
        IF IsBlank(line) THEN
            SELF.position += 1
        ELSE IF IsFence(line) THEN
            SELF.ConvertCodeBlock()
        ELSE IF HeadingLevel(line) > 0 THEN
            SELF.ConvertHeading()
        ELSE IF IsThematicBreak(line) THEN
            SELF.Emit("<hr/>")
            SELF.position += 1
        ELSE IF IsQuote(line) THEN
            SELF.ConvertQuote()
        ELSE IF IsListItem(line) THEN
            SELF.ConvertList(Indentation(line))
        ELSE IF IsTableRow(line) AND SELF.position + 1 < SELF.lines.Count() AND IsTableDelimiter(SELF.lines.Get(SELF.position + 1)) THEN
            SELF.ConvertTable()
        ELSE
            SELF.ConvertParagraph()
        END IF
    END FUNCTION

    PRIVATE FUNCTION ConvertHeading() AS VOID
        LET line AS STRING = Trim(SELF.Current())
        LET level AS INTEGER = HeadingLevel(line)
        LET text AS STRING = Trim(FromIndex(line, level))
        WHILE EndsWith(text, "#")
            text = TrimRight(Mid(text, 0, LEN(text) - 1))
        END WHILE
        LET id AS STRING = SELF.headings.Register(level, text)
        LET tag AS STRING = "h" + (level AS STRING)
        SELF.Emit("<" + tag + " id=\"" + EscapeXml(id) + "\">" + Inline(text, SELF.links) + "</" + tag + ">")
        SELF.position += 1
    END FUNCTION

    PRIVATE FUNCTION ConvertParagraph() AS VOID
        LET text AS STRING = Trim(SELF.Current())
        SELF.position += 1
        WHILE SELF.HasLine() AND NOT IsBlank(SELF.Current()) AND NOT StartsBlock(SELF.Current())
            text += " " + Trim(SELF.Current())
            SELF.position += 1
        END WHILE
        IF SELF.tight THEN
            SELF.Emit(Inline(text, SELF.links))
        ELSE
            SELF.Emit("<p>" + Inline(text, SELF.links) + "</p>")
        END IF
    END FUNCTION

    PRIVATE FUNCTION ConvertCodeBlock() AS VOID
        LET opening AS STRING = SELF.Current()
        LET indent AS INTEGER = Indentation(opening)
        LET trimmed AS STRING = TrimLeft(opening)
        LET fence AS STRING = Repeat(trimmed[0], RunLength(trimmed, 0))
        LET language AS STRING = Trim(FromIndex(trimmed, LEN(fence)))
        LET highlight AS BOOLEAN = IsHighlightedLanguage(language)
        LET classes AS STRING = ""
        IF language <> "" THEN
            classes = " class=\"language-" + EscapeXml(TOLOWER(language)) + "\""
        END IF
        SELF.out.AppendText("<pre" + classes + "><code" + classes + ">")
        SELF.position += 1
        LET firstLine AS BOOLEAN = TRUE
        WHILE SELF.HasLine() AND NOT StartsWith(TrimLeft(SELF.Current()), fence)
            IF NOT firstLine THEN
                SELF.out.AppendByte(10)
            END IF
            LET codeLine AS STRING = RemoveIndentation(SELF.Current(), indent)
            IF highlight THEN
                SELF.out.AppendText(HighlightBasicLine(codeLine))
            ELSE
                SELF.out.AppendText(EscapeXml(codeLine))
            END IF
            firstLine = FALSE
            SELF.position += 1
        END WHILE
        SELF.position += 1
        SELF.Emit("</code></pre>")
    END FUNCTION

    PRIVATE FUNCTION ConvertQuote() AS VOID
        LET quoted AS StringList = NEW StringList()
        WHILE SELF.HasLine() AND IsQuote(SELF.Current())
            LET content AS STRING = FromIndex(TrimLeft(SELF.Current()), 1)
            IF StartsWith(content, " ") THEN
                content = FromIndex(content, 1)
            END IF
            quoted.Add(content)
            SELF.position += 1
        END WHILE
        LET kind AS STRING = CalloutKind(quoted.Get(0))
        IF kind = "" THEN
            SELF.Emit("<blockquote>")
            SELF.ConvertNested(quoted, FALSE)
            SELF.Emit("</blockquote>")
        ELSE
            SELF.Emit("<div class=\"callout " + kind + "\">")
            SELF.ConvertNested(quoted, FALSE)
            SELF.Emit("</div>")
        END IF
    END FUNCTION

    PRIVATE FUNCTION ConvertTable() AS VOID
        LET header AS StringList = TableCells(SELF.Current())
        LET alignment AS StringList = TableCells(SELF.lines.Get(SELF.position + 1))
        SELF.position += 2
        SELF.Emit("<div class=\"table-wrap\"><table>")
        SELF.Emit("<thead>")
        SELF.EmitRow(header, alignment, "th")
        SELF.Emit("</thead>")
        SELF.Emit("<tbody>")
        WHILE SELF.HasLine() AND IsTableRow(SELF.Current())
            SELF.EmitRow(TableCells(SELF.Current()), alignment, "td")
            SELF.position += 1
        END WHILE
        SELF.Emit("</tbody>")
        SELF.Emit("</table></div>")
    END FUNCTION

    PRIVATE FUNCTION EmitRow(cells AS StringList, alignment AS StringList, tag AS STRING) AS VOID
        LET row AS STRING = "<tr>"
        FOR column = 0 TO alignment.Count() - 1
            LET cell AS STRING = ""
            IF column < cells.Count() THEN
                cell = cells.Get(column)
            END IF
            row += "<" + tag + AlignmentClass(alignment.Get(column)) + ">" + Inline(cell, SELF.links) + "</" + tag + ">"
        END FOR
        SELF.Emit(row + "</tr>")
    END FUNCTION

    PRIVATE FUNCTION NextNonBlank(from AS INTEGER) AS INTEGER
        LET at AS INTEGER = from
        WHILE at < SELF.lines.Count() AND IsBlank(SELF.lines.Get(at))
            at += 1
        END WHILE
        RETURN at
    END FUNCTION

    PRIVATE FUNCTION ConvertList(markerIndent AS INTEGER) AS VOID
        LET ordered AS BOOLEAN = IsOrderedItem(SELF.Current())
        LET listTag AS STRING = "ul"
        LET opening AS STRING = "<ul>"
        IF ordered THEN
            listTag = "ol"
            LET first AS INTEGER = DigitsValue(TrimLeft(SELF.Current()), 0, ListMarkerWidth(SELF.Current()) - 2)
            opening = "<ol>"
            IF first <> 1 THEN
                opening = "<ol start=\"" + (first AS STRING) + "\">"
            END IF
        END IF
        SELF.Emit(opening)
        LET continuing AS BOOLEAN = TRUE
        WHILE continuing
            SELF.ConvertListItem(markerIndent)
            LET upcoming AS INTEGER = SELF.NextNonBlank(SELF.position)
            continuing = FALSE
            IF upcoming < SELF.lines.Count() THEN
                LET candidate AS STRING = SELF.lines.Get(upcoming)
                IF IsListItem(candidate) AND Indentation(candidate) <= markerIndent + 1 AND Indentation(candidate) >= markerIndent AND IsOrderedItem(candidate) = ordered THEN
                    SELF.position = upcoming
                    continuing = TRUE
                END IF
            END IF
        END WHILE
        SELF.Emit("</" + listTag + ">")
    END FUNCTION

    PRIVATE FUNCTION ConvertListItem(markerIndent AS INTEGER) AS VOID
        LET line AS STRING = SELF.Current()
        LET contentIndent AS INTEGER = Indentation(line) + ListMarkerWidth(line)
        LET itemLines AS StringList = NEW StringList()
        itemLines.Add(TrimLeft(FromIndex(TrimLeft(line), ListMarkerWidth(line))))
        SELF.position += 1
        LET loose AS BOOLEAN = FALSE
        LET inFence AS BOOLEAN = FALSE
        LET gathering AS BOOLEAN = TRUE
        WHILE gathering AND SELF.HasLine()
            LET next AS STRING = SELF.Current()
            IF IsBlank(next) THEN
                LET resume AS INTEGER = SELF.NextNonBlank(SELF.position)
                IF resume < SELF.lines.Count() AND Indentation(SELF.lines.Get(resume)) >= contentIndent THEN
                    itemLines.Add("")
                    IF NOT inFence AND NOT IsListItem(SELF.lines.Get(resume)) THEN
                        loose = TRUE
                    END IF
                    SELF.position += 1
                ELSE
                    gathering = FALSE
                END IF
            ELSE IF inFence OR Indentation(next) >= contentIndent THEN
                IF IsFence(next) THEN
                    inFence = NOT inFence
                END IF
                itemLines.Add(RemoveIndentation(next, contentIndent))
                SELF.position += 1
            ELSE IF IsListItem(next) THEN
                IF Indentation(next) > markerIndent + 1 THEN
                    itemLines.Add(RemoveIndentation(next, markerIndent + 2))
                    SELF.position += 1
                ELSE
                    gathering = FALSE
                END IF
            ELSE IF NOT StartsBlock(next) THEN
                itemLines.Add(Trim(next))
                SELF.position += 1
            ELSE
                gathering = FALSE
            END IF
        END WHILE
        SELF.out.AppendText("<li>")
        SELF.ConvertNested(itemLines, NOT loose)
        SELF.Emit("</li>")
    END FUNCTION
END CLASS

// ---------------------------------------------------------------------------
// Table of contents (toc.md) → ordered book parts.
// ---------------------------------------------------------------------------

STRUCT TocLink
    found AS BOOLEAN
    target AS STRING
    label AS STRING
END STRUCT

FUNCTION FirstMarkdownLink(text AS STRING) AS TocLink
    LET none AS TocLink = [FALSE, "", ""]
    LET open AS INTEGER = IndexOf(text, "[")
    WHILE open >= 0
        LET found AS LinkMatch = MatchLink(text, open)
        IF found.found AND EndsWith(found.url, ".md") AND NOT IsExternal(found.url) THEN
            LET result AS TocLink = [TRUE, found.url, PlainText(text)]
            RETURN result
        END IF
        open = IndexOfFrom(text, "[", open + 1)
    END WHILE
    RETURN none
END FUNCTION

CLASS BookOutline
    PUBLIC title AS STRING = "The Basic Next Programming Language"
    PUBLIC parts AS PartList = NEW PartList()

    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION ReadOutline(tocLines AS StringList) AS BookOutline
    LET outline AS BookOutline = NEW BookOutline()
    LET inAppendices AS BOOLEAN = FALSE
    FOR index = 0 TO tocLines.Count() - 1
        LET line AS STRING = tocLines.Get(index)
        IF HeadingLevel(line) = 1 THEN
            outline.title = PlainText(FromIndex(Trim(line), 2))
        ELSE IF HeadingLevel(line) = 2 THEN
            LET entry AS TocLink = FirstMarkdownLink(FromIndex(Trim(line), 3))
            IF entry.found THEN
                LET role AS STRING = ROLE_CHAPTER
                IF StartsWith(TOLOWER(entry.label), "preface") THEN
                    role = ROLE_PREFACE
                ELSE IF StartsWith(TOLOWER(entry.label), "appendi") THEN
                    role = ROLE_APPENDICES
                    inAppendices = TRUE
                END IF
                outline.parts.Add(NEW BookPart(entry.target, entry.label, role))
            END IF
        ELSE IF inAppendices AND IsListItem(line) THEN
            LET appendix AS TocLink = FirstMarkdownLink(FromIndex(TrimLeft(line), ListMarkerWidth(line)))
            IF appendix.found THEN
                outline.parts.Add(NEW BookPart(appendix.target, appendix.label, ROLE_APPENDIX))
            END IF
        END IF
    END FOR
    RETURN outline
END FUNCTION

// ---------------------------------------------------------------------------
// XHTML documents.
// ---------------------------------------------------------------------------

FUNCTION XmlDeclaration() AS STRING
    RETURN "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
END FUNCTION

FUNCTION OpenXhtml(out AS ByteBuffer, title AS STRING, bodyType AS STRING) AS VOID
    out.AppendLine(XmlDeclaration())
    out.AppendLine("<!DOCTYPE html>")
    out.AppendLine("<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\" lang=\"en\" xml:lang=\"en\">")
    out.AppendLine("<head>")
    out.AppendLine("<meta charset=\"UTF-8\"/>")
    out.AppendLine("<title>" + EscapeXml(title) + "</title>")
    out.AppendLine("<link rel=\"stylesheet\" type=\"text/css\" href=\"css/book.css\"/>")
    out.AppendLine("</head>")
    out.AppendLine("<body epub:type=\"" + bodyType + "\">")
END FUNCTION

FUNCTION CloseXhtml(out AS ByteBuffer) AS VOID
    out.AppendLine("</body>")
    out.AppendLine("</html>")
END FUNCTION

FUNCTION MatterOf(role AS STRING) AS STRING
    IF role = ROLE_PREFACE THEN RETURN "frontmatter"
    IF role = ROLE_CHAPTER THEN RETURN "bodymatter"
    RETURN "backmatter"
END FUNCTION

FUNCTION SectionTypeOf(role AS STRING) AS STRING
    IF role = ROLE_PREFACE THEN RETURN "preface"
    IF role = ROLE_CHAPTER THEN RETURN "chapter"
    RETURN "appendix"
END FUNCTION

FUNCTION RenderPart(part AS BookPart, lines AS StringList, links AS LinkRewriter) AS VOID
    LET body AS ByteBuffer = NEW ByteBuffer()
    LET converter AS MarkdownConverter = NEW MarkdownConverter(lines, links, part.headings, body, FALSE)
    converter.Convert()
    LET sectionType AS STRING = SectionTypeOf(part.role)
    OpenXhtml(part.page, part.Title(), MatterOf(part.role))
    part.page.AppendLine("<section epub:type=\"" + sectionType + "\" role=\"doc-" + sectionType + "\" class=\"" + part.role + "\">")
    part.page.AppendRegion(body.Region(), body.Size())
    part.page.AppendLine("</section>")
    CloseXhtml(part.page)
END FUNCTION

// ---------------------------------------------------------------------------
// Cover: an SVG with the official logo, title, author, version and date.
// ---------------------------------------------------------------------------

CLASS CoverFacts
    PUBLIC title AS STRING = ""
    PUBLIC author AS STRING = ""
    PUBLIC version AS STRING = ""
    PUBLIC generated AS STRING = ""

    PUBLIC FUNCTION CONSTRUCTOR(title AS STRING, author AS STRING, version AS STRING, generated AS STRING)
        SELF.title = title
        SELF.author = author
        SELF.version = version
        SELF.generated = generated
    END FUNCTION
END CLASS

// Splits a title into two lines at the space nearest to its middle.
FUNCTION TitleLines(title AS STRING) AS StringList
    LET lines AS StringList = NEW StringList()
    LET best AS INTEGER = -1
    FOR at = 0 TO LEN(title) - 1
        IF title[at] = " " THEN
            LET distance AS INTEGER = at - LEN(title) DIV 2
            IF distance < 0 THEN distance = -distance
            LET bestDistance AS INTEGER = best - LEN(title) DIV 2
            IF bestDistance < 0 THEN bestDistance = -bestDistance
            IF best < 0 OR distance < bestDistance THEN
                best = at
            END IF
        END IF
    END FOR
    IF LEN(title) < 22 OR best < 0 THEN
        lines.Add(title)
    ELSE
        lines.Add(Mid(title, 0, best))
        lines.Add(FromIndex(title, best + 1))
    END IF
    RETURN lines
END FUNCTION

FUNCTION SvgText(out AS ByteBuffer, y AS INTEGER, size AS INTEGER, fill AS STRING, family AS STRING, weight AS STRING, text AS STRING) AS VOID
    out.AppendLine("<text x=\"600\" y=\"" + (y AS STRING) + "\" text-anchor=\"middle\" font-family=\"" + family + "\" font-size=\"" + (size AS STRING) + "\" font-weight=\"" + weight + "\" fill=\"" + fill + "\">" + EscapeXml(text) + "</text>")
END FUNCTION

// logoHref is either a packaged path or a data: URI.
FUNCTION RenderCoverSvg(out AS ByteBuffer, facts AS CoverFacts, logo AS ByteBuffer, embedLogo AS BOOLEAN) AS VOID
    LET serif AS STRING = "Georgia, 'Times New Roman', serif"
    LET sans AS STRING = "'Helvetica Neue', Arial, sans-serif"
    out.AppendLine("<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" version=\"1.1\" viewBox=\"0 0 1200 1800\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\">")
    out.AppendLine("<title>" + EscapeXml(facts.title) + "</title>")
    out.AppendLine("<defs><linearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0b1d36\"/><stop offset=\"1\" stop-color=\"#16426e\"/></linearGradient></defs>")
    out.AppendLine("<rect width=\"1200\" height=\"1800\" fill=\"url(#bg)\"/>")
    out.AppendLine("<rect x=\"60\" y=\"60\" width=\"1080\" height=\"1680\" fill=\"none\" stroke=\"#f2b632\" stroke-width=\"4\" rx=\"24\"/>")
    out.AppendLine("<circle cx=\"600\" cy=\"560\" r=\"330\" fill=\"#ffffff\"/>")
    out.AppendText("<image x=\"330\" y=\"290\" width=\"540\" height=\"540\" preserveAspectRatio=\"xMidYMid meet\" xlink:href=\"")
    IF embedLogo THEN
        out.AppendText("data:image/png;base64,")
        Base64Into(logo, out)
    ELSE
        out.AppendText("images/logo.png")
    END IF
    out.AppendLine("\"/>")
    LET titleLines AS StringList = TitleLines(facts.title)
    LET y AS INTEGER = 1060
    FOR index = 0 TO titleLines.Count() - 1
        SvgText(out, y, 84, "#ffffff", serif, "bold", titleLines.Get(index))
        y += 104
    END FOR
    out.AppendLine("<rect x=\"450\" y=\"" + ((y - 40) AS STRING) + "\" width=\"300\" height=\"6\" fill=\"#f2b632\"/>")
    SvgText(out, y + 70, 50, "#e8eef6", serif, "normal", facts.author)
    SvgText(out, 1530, 46, "#f2b632", sans, "bold", "Version " + facts.version)
    SvgText(out, 1600, 30, "#b9c7d8", sans, "normal", "Generated " + facts.generated)
    SvgText(out, 1660, 28, "#b9c7d8", sans, "normal", "basicnext.org")
    out.AppendLine("</svg>")
END FUNCTION

FUNCTION RenderCoverPage(out AS ByteBuffer, facts AS CoverFacts, logo AS ByteBuffer) AS VOID
    OpenXhtml(out, "Cover", "cover")
    out.AppendLine("<section epub:type=\"cover\" class=\"cover\">")
    RenderCoverSvg(out, facts, logo, FALSE)
    out.AppendLine("</section>")
    CloseXhtml(out)
END FUNCTION

// ---------------------------------------------------------------------------
// Navigation: EPUB 3 nav.xhtml (toc + landmarks) and EPUB 2 toc.ncx.
// ---------------------------------------------------------------------------

FUNCTION NavItem(out AS ByteBuffer, part AS BookPart) AS VOID
    out.AppendText("<li><a href=\"" + part.xhtmlName + "\">" + EscapeXml(part.label) + "</a>")
    IF part.role <> ROLE_APPENDICES AND part.headings.sectionIds.Count() > 0 THEN
        out.AppendLine("<ol>")
        FOR index = 0 TO part.headings.sectionIds.Count() - 1
            out.AppendLine("<li><a href=\"" + part.xhtmlName + "#" + EscapeXml(part.headings.sectionIds.Get(index)) + "\">" + EscapeXml(part.headings.sectionTitles.Get(index)) + "</a></li>")
        END FOR
        out.AppendText("</ol>")
    END IF
END FUNCTION

FUNCTION RenderNav(out AS ByteBuffer, outline AS BookOutline) AS VOID
    OpenXhtml(out, "Contents", "frontmatter")
    out.AppendLine("<nav epub:type=\"toc\" id=\"toc\" role=\"doc-toc\">")
    out.AppendLine("<h1>Contents</h1>")
    out.AppendLine("<ol class=\"toc\">")
    LET inAppendices AS BOOLEAN = FALSE
    LET appendicesSeen AS BOOLEAN = FALSE
    LET node AS BookPart OR NULL = outline.parts.first
    WHILE node IS BookPart
        IF node.role = ROLE_APPENDICES THEN
            appendicesSeen = TRUE
        END IF
        IF node.role = ROLE_APPENDIX AND appendicesSeen THEN
            IF NOT inAppendices THEN
                out.AppendLine("<ol>")
                inAppendices = TRUE
            END IF
            NavItem(out, node)
            out.AppendLine("</li>")
        ELSE
            NavItem(out, node)
            IF node.role <> ROLE_APPENDICES THEN
                out.AppendLine("</li>")
            END IF
        END IF
        node = node.following
    END WHILE
    IF inAppendices THEN
        out.AppendLine("</ol>")
    END IF
    IF appendicesSeen THEN
        out.AppendLine("</li>")
    END IF
    out.AppendLine("</ol>")
    out.AppendLine("</nav>")
    out.AppendLine("<nav epub:type=\"landmarks\" id=\"landmarks\" hidden=\"hidden\">")
    out.AppendLine("<h2>Landmarks</h2>")
    out.AppendLine("<ol>")
    out.AppendLine("<li><a epub:type=\"cover\" href=\"cover.xhtml\">Cover</a></li>")
    out.AppendLine("<li><a epub:type=\"toc\" href=\"nav.xhtml\">Contents</a></li>")
    LandmarkFor(out, outline.parts, ROLE_PREFACE, "preface", "Preface")
    LandmarkFor(out, outline.parts, ROLE_CHAPTER, "bodymatter", "Start of Content")
    LandmarkFor(out, outline.parts, ROLE_APPENDICES, "backmatter", "Appendices")
    out.AppendLine("</ol>")
    out.AppendLine("</nav>")
    CloseXhtml(out)
END FUNCTION

FUNCTION LandmarkFor(out AS ByteBuffer, parts AS PartList, role AS STRING, landmark AS STRING, label AS STRING) AS VOID
    LET part AS BookPart OR NULL = parts.FirstWithRole(role)
    IF part IS BookPart THEN
        out.AppendLine("<li><a epub:type=\"" + landmark + "\" href=\"" + part.xhtmlName + "\">" + label + "</a></li>")
    END IF
END FUNCTION

CLASS NcxWriter
    PRIVATE out AS ByteBuffer = NEW ByteBuffer()
    PRIVATE playOrder AS INTEGER = 0

    PUBLIC FUNCTION CONSTRUCTOR(out AS ByteBuffer)
        SELF.out = out
    END FUNCTION

    PUBLIC FUNCTION OpenPoint(label AS STRING, href AS STRING) AS VOID
        SELF.playOrder += 1
        SELF.out.AppendLine("<navPoint id=\"np-" + (SELF.playOrder AS STRING) + "\" playOrder=\"" + (SELF.playOrder AS STRING) + "\">")
        SELF.out.AppendLine("<navLabel><text>" + EscapeXml(label) + "</text></navLabel>")
        SELF.out.AppendLine("<content src=\"" + EscapeXml(href) + "\"/>")
    END FUNCTION

    PUBLIC FUNCTION ClosePoint() AS VOID
        SELF.out.AppendLine("</navPoint>")
    END FUNCTION

    PUBLIC FUNCTION Point(label AS STRING, href AS STRING) AS VOID
        SELF.OpenPoint(label, href)
        SELF.ClosePoint()
    END FUNCTION
END CLASS

FUNCTION RenderNcx(out AS ByteBuffer, outline AS BookOutline, identifier AS STRING) AS VOID
    out.AppendLine(XmlDeclaration())
    out.AppendLine("<ncx xmlns=\"http://www.daisy.org/z3986/2005/ncx/\" version=\"2005-1\" xml:lang=\"en\">")
    out.AppendLine("<head>")
    out.AppendLine("<meta name=\"dtb:uid\" content=\"" + identifier + "\"/>")
    out.AppendLine("<meta name=\"dtb:depth\" content=\"2\"/>")
    out.AppendLine("<meta name=\"dtb:totalPageCount\" content=\"0\"/>")
    out.AppendLine("<meta name=\"dtb:maxPageNumber\" content=\"0\"/>")
    out.AppendLine("</head>")
    out.AppendLine("<docTitle><text>" + EscapeXml(outline.title) + "</text></docTitle>")
    out.AppendLine("<navMap>")
    LET points AS NcxWriter = NEW NcxWriter(out)
    points.Point("Cover", "cover.xhtml")
    LET appendicesOpen AS BOOLEAN = FALSE
    LET node AS BookPart OR NULL = outline.parts.first
    WHILE node IS BookPart
        IF node.role = ROLE_APPENDICES THEN
            points.OpenPoint(node.label, node.xhtmlName)
            appendicesOpen = TRUE
        ELSE IF node.role = ROLE_APPENDIX THEN
            points.Point(node.label, node.xhtmlName)
        ELSE
            points.Point(node.label, node.xhtmlName)
            IF node.role = ROLE_PREFACE THEN
                points.Point("Contents", "nav.xhtml")
            END IF
        END IF
        node = node.following
    END WHILE
    IF appendicesOpen THEN
        points.ClosePoint()
    END IF
    out.AppendLine("</navMap>")
    out.AppendLine("</ncx>")
END FUNCTION

// ---------------------------------------------------------------------------
// Package document (content.opf) and container.xml.
// ---------------------------------------------------------------------------

CLASS PackageFacts
    PUBLIC identifier AS STRING = ""
    PUBLIC title AS STRING = ""
    PUBLIC version AS STRING = ""
    PUBLIC generatedDate AS STRING = ""
    PUBLIC modified AS STRING = ""

    PUBLIC FUNCTION CONSTRUCTOR(identifier AS STRING, title AS STRING, version AS STRING, generatedDate AS STRING, modified AS STRING)
        SELF.identifier = identifier
        SELF.title = title
        SELF.version = version
        SELF.generatedDate = generatedDate
        SELF.modified = modified
    END FUNCTION
END CLASS

FUNCTION ManifestItem(out AS ByteBuffer, href AS STRING, properties AS STRING) AS VOID
    LET extra AS STRING = ""
    IF properties <> "" THEN
        extra = " properties=\"" + properties + "\""
    END IF
    out.AppendLine("<item id=\"" + ManifestId(href) + "\" href=\"" + EscapeXml(href) + "\" media-type=\"" + MediaTypeOf(href) + "\"" + extra + "/>")
END FUNCTION

FUNCTION SpineItem(out AS ByteBuffer, href AS STRING) AS VOID
    out.AppendLine("<itemref idref=\"" + ManifestId(href) + "\"/>")
END FUNCTION

FUNCTION RenderMetadata(out AS ByteBuffer, facts AS PackageFacts) AS VOID
    out.AppendLine("<metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\">")
    out.AppendLine("<dc:identifier id=\"book-id\">" + facts.identifier + "</dc:identifier>")
    out.AppendLine("<dc:title id=\"title\">" + EscapeXml(facts.title) + "</dc:title>")
    out.AppendLine("<meta refines=\"#title\" property=\"title-type\">main</meta>")
    out.AppendLine("<dc:title id=\"edition\">Version " + EscapeXml(facts.version) + "</dc:title>")
    out.AppendLine("<meta refines=\"#edition\" property=\"title-type\">edition</meta>")
    out.AppendLine("<dc:creator id=\"author\">" + EscapeXml(BOOK_AUTHOR) + "</dc:creator>")
    out.AppendLine("<meta refines=\"#author\" property=\"role\" scheme=\"marc:relators\">aut</meta>")
    out.AppendLine("<meta refines=\"#author\" property=\"file-as\">" + EscapeXml(BOOK_AUTHOR_SORT) + "</meta>")
    out.AppendLine("<dc:language>en</dc:language>")
    out.AppendLine("<dc:date>" + facts.generatedDate + "</dc:date>")
    out.AppendLine("<dc:publisher>" + EscapeXml(BOOK_PUBLISHER) + "</dc:publisher>")
    out.AppendLine("<dc:rights>" + EscapeXml(BOOK_RIGHTS) + "</dc:rights>")
    out.AppendLine("<dc:subject>Programming languages</dc:subject>")
    out.AppendLine("<dc:subject>Basic Next</dc:subject>")
    out.AppendLine("<dc:description>The official tutorial of the Basic Next programming language, edition for version " + EscapeXml(facts.version) + ".</dc:description>")
    out.AppendLine("<meta property=\"dcterms:modified\">" + facts.modified + "</meta>")
    out.AppendLine("<meta property=\"schema:version\">" + EscapeXml(facts.version) + "</meta>")
    out.AppendLine("<meta property=\"schema:accessMode\">textual</meta>")
    out.AppendLine("<meta property=\"schema:accessMode\">visual</meta>")
    out.AppendLine("<meta property=\"schema:accessModeSufficient\">textual</meta>")
    out.AppendLine("<meta property=\"schema:accessibilityFeature\">structuralNavigation</meta>")
    out.AppendLine("<meta property=\"schema:accessibilityFeature\">tableOfContents</meta>")
    out.AppendLine("<meta property=\"schema:accessibilityHazard\">none</meta>")
    out.AppendLine("<meta property=\"schema:accessibilitySummary\">Reflowable text with semantic headings, navigable table of contents and text alternatives for images.</meta>")
    out.AppendLine("<meta name=\"cover\" content=\"" + ManifestId("images/cover.svg") + "\"/>")
    out.AppendLine("</metadata>")
END FUNCTION

FUNCTION RenderPackage(out AS ByteBuffer, facts AS PackageFacts, outline AS BookOutline, resources AS ResourceRegistry) AS VOID
    out.AppendLine(XmlDeclaration())
    out.AppendLine("<package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\" unique-identifier=\"book-id\" xml:lang=\"en\" prefix=\"schema: http://schema.org/\">")
    RenderMetadata(out, facts)
    out.AppendLine("<manifest>")
    ManifestItem(out, "toc.ncx", "")
    ManifestItem(out, "nav.xhtml", "nav")
    ManifestItem(out, "cover.xhtml", "svg")
    ManifestItem(out, "css/book.css", "")
    ManifestItem(out, "images/cover.svg", "cover-image")
    ManifestItem(out, "images/logo.png", "")
    FOR index = 0 TO resources.packaged.Count() - 1
        ManifestItem(out, resources.packaged.Get(index), "")
    END FOR
    LET node AS BookPart OR NULL = outline.parts.first
    WHILE node IS BookPart
        ManifestItem(out, node.xhtmlName, "")
        node = node.following
    END WHILE
    out.AppendLine("</manifest>")
    out.AppendLine("<spine toc=\"" + ManifestId("toc.ncx") + "\">")
    SpineItem(out, "cover.xhtml")
    LET contentsPlaced AS BOOLEAN = FALSE
    LET entry AS BookPart OR NULL = outline.parts.first
    WHILE entry IS BookPart
        IF NOT contentsPlaced AND entry.role <> ROLE_PREFACE THEN
            SpineItem(out, "nav.xhtml")
            contentsPlaced = TRUE
        END IF
        SpineItem(out, entry.xhtmlName)
        entry = entry.following
    END WHILE
    IF NOT contentsPlaced THEN
        SpineItem(out, "nav.xhtml")
    END IF
    out.AppendLine("</spine>")
    out.AppendLine("</package>")
END FUNCTION

FUNCTION RenderContainer(out AS ByteBuffer) AS VOID
    out.AppendLine(XmlDeclaration())
    out.AppendLine("<container version=\"1.0\" xmlns=\"urn:oasis:names:tc:opendocument:xmlns:container\">")
    out.AppendLine("<rootfiles>")
    out.AppendLine("<rootfile full-path=\"" + CONTENT_DIR + "content.opf\" media-type=\"application/oebps-package+xml\"/>")
    out.AppendLine("</rootfiles>")
    out.AppendLine("</container>")
END FUNCTION

FUNCTION HexOf(value AS UINT32, digits AS INTEGER) AS STRING
    LET alphabet AS STRING = "0123456789abcdef"
    LET result AS STRING = ""
    LET rest AS UINT32 = value
    FOR position = 1 TO digits
        result = alphabet[(rest AND 15) AS INTEGER] + result
        rest = rest SHR 4
    END FOR
    RETURN result
END FUNCTION

// Name-based UUID (RFC 9562 version 8 layout): four CRC-32 values of the
// edition name with different salts give 128 stable bits, so every build
// of one version keeps the same identifier.
FUNCTION StableUuid(seed AS STRING) AS STRING
    LET crc AS Crc32 = NEW Crc32()
    LET hex AS STRING = ""
    FOR salt = 0 TO 3
        hex += HexOf(crc.Of(TextBytes(seed + "#" + (salt AS STRING))), 8)
    END FOR
    LET variantDigit AS STRING = "89ab"[CodeOf(hex[16]) % 4]
    RETURN "urn:uuid:" + Mid(hex, 0, 8) + "-" + Mid(hex, 8, 4) + "-8" + Mid(hex, 13, 3) + "-" + variantDigit + Mid(hex, 17, 3) + "-" + Mid(hex, 20, 12)
END FUNCTION

// ---------------------------------------------------------------------------
// Stylesheet.
// ---------------------------------------------------------------------------

FUNCTION RenderCss(out AS ByteBuffer) AS VOID
    out.AppendLine("@charset \"UTF-8\";")
    out.AppendLine("/* Basic Next book — EPUB stylesheet. Generic font stacks only. */")
    out.AppendLine("html { font-size: 100%; }")
    out.AppendLine("body { font-family: Georgia, 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Palatino, serif; line-height: 1.55; color: #1d232b; margin: 0 4%; text-align: left; hyphens: auto; -epub-hyphens: auto; widows: 2; orphans: 2; }")
    out.AppendLine("h1, h2, h3, h4, h5, h6 { font-family: 'Helvetica Neue', 'Segoe UI', Arial, sans-serif; color: #12355b; line-height: 1.25; page-break-after: avoid; break-after: avoid; hyphens: none; -epub-hyphens: none; }")
    out.AppendLine("h1 { font-size: 1.9em; margin: 1.2em 0 0.8em 0; padding-bottom: 0.3em; border-bottom: 3px solid #f2b632; }")
    out.AppendLine("h2 { font-size: 1.45em; margin: 1.6em 0 0.6em 0; padding-bottom: 0.15em; border-bottom: 1px solid #d5dde7; }")
    out.AppendLine("h3 { font-size: 1.2em; margin: 1.3em 0 0.5em 0; }")
    out.AppendLine("h4, h5, h6 { font-size: 1.05em; margin: 1.1em 0 0.4em 0; }")
    out.AppendLine("section.chapter > h1:first-child, section.appendix > h1:first-child, section.appendices > h1:first-child, section.preface > h1:first-child { margin-top: 0.5em; }")
    out.AppendLine("p { margin: 0 0 0.85em 0; }")
    out.AppendLine("a { color: #1d5fa8; text-decoration: none; }")
    out.AppendLine("a.external { text-decoration: underline; text-decoration-color: #9bb8da; }")
    out.AppendLine("strong { font-weight: bold; color: #0f2440; }")
    out.AppendLine("code, pre, kbd, samp { font-family: 'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', 'Liberation Mono', monospace; }")
    out.AppendLine("code { font-size: 0.88em; background-color: #eef2f7; padding: 0.05em 0.25em; border-radius: 3px; hyphens: none; -epub-hyphens: none; }")
    out.AppendLine("pre { font-size: 0.8em; line-height: 1.4; background-color: #f6f8fb; border: 1px solid #d5dde7; border-left: 4px solid #12355b; border-radius: 4px; padding: 0.7em 0.9em; margin: 0.6em 0 1.1em 0; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; page-break-inside: avoid; break-inside: avoid; }")
    out.AppendLine("pre code { font-size: 1em; background: none; padding: 0; border-radius: 0; }")
    out.AppendLine("pre.language-sh, pre.language-shell, pre.language-text { border-left-color: #6b7a8c; }")
    out.AppendLine("pre .k { color: #8a1f63; font-weight: bold; }")
    out.AppendLine("pre .t { color: #1d5fa8; font-weight: bold; }")
    out.AppendLine("pre .l { color: #9a5b00; }")
    out.AppendLine("pre .s { color: #2c7a2c; }")
    out.AppendLine("pre .n { color: #9a5b00; }")
    out.AppendLine("pre .c { color: #6b7a8c; font-style: italic; }")
    out.AppendLine("ul, ol { margin: 0 0 0.9em 0; padding-left: 1.6em; }")
    out.AppendLine("li { margin: 0.2em 0; }")
    out.AppendLine("li > ul, li > ol { margin-bottom: 0.2em; }")
    out.AppendLine("blockquote { margin: 1em 0; padding: 0.4em 1em; border-left: 4px solid #c7d3e1; color: #3a4654; font-style: italic; }")
    out.AppendLine("blockquote p:last-child, div.callout p:last-child { margin-bottom: 0; }")
    out.AppendLine("div.callout { margin: 1em 0; padding: 0.6em 0.9em; border-radius: 4px; border-left: 5px solid #1d5fa8; background-color: #edf4fc; page-break-inside: avoid; break-inside: avoid; }")
    out.AppendLine("div.callout.tip { border-left-color: #2c7a2c; background-color: #eef8ee; }")
    out.AppendLine("div.callout.warning { border-left-color: #b8461b; background-color: #fdf0ea; }")
    out.AppendLine("div.callout.important { border-left-color: #8a1f63; background-color: #f9eef5; }")
    out.AppendLine("div.callout.draft { border-left-color: #9a5b00; background-color: #fdf6e6; }")
    out.AppendLine("div.table-wrap { margin: 0.8em 0 1.2em 0; overflow-x: auto; }")
    out.AppendLine("table { border-collapse: collapse; width: 100%; font-size: 0.86em; line-height: 1.4; page-break-inside: auto; }")
    out.AppendLine("th, td { border: 1px solid #d5dde7; padding: 0.35em 0.55em; vertical-align: top; text-align: left; }")
    out.AppendLine("thead th { background-color: #12355b; color: #ffffff; font-family: 'Helvetica Neue', Arial, sans-serif; }")
    out.AppendLine("thead th code { color: #12355b; }")
    out.AppendLine("tbody tr:nth-child(even) td { background-color: #f6f8fb; }")
    out.AppendLine(".align-center { text-align: center; }")
    out.AppendLine(".align-right { text-align: right; }")
    out.AppendLine("hr { border: none; border-top: 1px solid #d5dde7; margin: 1.6em 15%; }")
    out.AppendLine("img { max-width: 100%; height: auto; }")
    out.AppendLine(".missing-image { font-style: italic; color: #6b7a8c; }")
    out.AppendLine("section.cover { margin: 0; padding: 0; text-align: center; height: 100vh; }")
    out.AppendLine("section.cover svg { display: block; margin: 0 auto; max-height: 100vh; }")
    out.AppendLine("body[epub|type~='cover'] { margin: 0; }")
    out.AppendLine("nav#toc ol { list-style-type: none; padding-left: 0; }")
    out.AppendLine("nav#toc > ol > li { margin: 0.55em 0; font-weight: bold; font-family: 'Helvetica Neue', Arial, sans-serif; }")
    out.AppendLine("nav#toc ol ol { padding-left: 1.3em; font-weight: normal; font-family: Georgia, serif; font-size: 0.95em; }")
    out.AppendLine("nav#landmarks { display: none; }")
END FUNCTION

// ---------------------------------------------------------------------------
// Program.
// ---------------------------------------------------------------------------

FUNCTION ArgumentOr(index AS INTEGER, fallback AS STRING) AS STRING
    IF LEN(HOST.Args) > index THEN
        IF HOST.Args[index] <> "" THEN
            RETURN HOST.Args[index]
        END IF
    END IF
    RETURN fallback
END FUNCTION

// Reads the first `version = "x.y.z"` line of Cargo.toml (the workspace
// version comes first in the file).
FUNCTION WorkspaceVersion(cargoPath AS STRING) AS STRING OR Error
    LET lines AS StringList OR Error = ReadTextLines(cargoPath)
    IF lines IS Error THEN
        RETURN lines
    END IF
    FOR index = 0 TO lines.Count() - 1
        LET line AS STRING = Trim(lines.Get(index))
        IF StartsWith(line, "version") AND IndexOf(line, "\"") > 0 THEN
            LET open AS INTEGER = IndexOf(line, "\"")
            LET close AS INTEGER = IndexOfFrom(line, "\"", open + 1)
            IF close > open THEN
                RETURN Mid(line, open + 1, close - open - 1)
            END IF
        END IF
    END FOR
    RETURN "unknown"
END FUNCTION

FUNCTION Report(step AS STRING, failure AS Error) AS INTEGER
    PRINT "error: ", step, ": ", failure.Message
    RETURN 1
END FUNCTION

FUNCTION RenderParts(outline AS BookOutline, bookDir AS STRING, links AS LinkRewriter) AS VOID OR Error
    LET node AS BookPart OR NULL = outline.parts.first
    WHILE node IS BookPart
        LET lines AS StringList OR Error = ReadTextLines(bookDir + "/" + node.sourceName)
        IF lines IS Error THEN
            RETURN lines
        END IF
        RenderPart(node, lines, links)
        PRINT "  converted ", node.sourceName, " -> ", node.xhtmlName
        node = node.following
    END WHILE
    RETURN
END FUNCTION

FUNCTION AddText(zip AS ZipWriter, name AS STRING, content AS ByteBuffer) AS VOID OR Error
    RETURN zip.AddStored(name, content)
END FUNCTION

FUNCTION WriteEpub(path AS STRING, stamp AS DosStamp, outline AS BookOutline, facts AS PackageFacts, cover AS CoverFacts, logo AS ByteBuffer, resources AS ResourceRegistry) AS VOID OR Error
    LET created AS ZipWriter OR Error = ZipWriter.Create(path, stamp)
    IF created IS Error THEN
        RETURN created
    END IF
    LET zip AS ZipWriter = created
    LET mimetype AS VOID OR Error = zip.AddStored("mimetype", TextBytes("application/epub+zip"))
    IF mimetype IS Error THEN
        RETURN mimetype
    END IF
    LET container AS ByteBuffer = NEW ByteBuffer()
    RenderContainer(container)
    LET packageDocument AS ByteBuffer = NEW ByteBuffer()
    RenderPackage(packageDocument, facts, outline, resources)
    LET ncx AS ByteBuffer = NEW ByteBuffer()
    RenderNcx(ncx, outline, facts.identifier)
    LET nav AS ByteBuffer = NEW ByteBuffer()
    RenderNav(nav, outline)
    LET coverPage AS ByteBuffer = NEW ByteBuffer()
    RenderCoverPage(coverPage, cover, logo)
    LET coverImage AS ByteBuffer = NEW ByteBuffer()
    coverImage.AppendLine(XmlDeclaration())
    RenderCoverSvg(coverImage, cover, logo, TRUE)
    LET css AS ByteBuffer = NEW ByteBuffer()
    RenderCss(css)
    LET steps AS VOID OR Error = AddAll(zip, container, packageDocument, ncx, nav, coverPage, coverImage, css, logo)
    IF steps IS Error THEN
        RETURN steps
    END IF
    LET images AS VOID OR Error = AddResources(zip, resources)
    IF images IS Error THEN
        RETURN images
    END IF
    LET node AS BookPart OR NULL = outline.parts.first
    WHILE node IS BookPart
        LET added AS VOID OR Error = zip.AddStored(CONTENT_DIR + node.xhtmlName, node.page)
        IF added IS Error THEN
            RETURN added
        END IF
        node = node.following
    END WHILE
    RETURN zip.Finish()
END FUNCTION

FUNCTION AddAll(zip AS ZipWriter, container AS ByteBuffer, packageDocument AS ByteBuffer, ncx AS ByteBuffer, nav AS ByteBuffer, coverPage AS ByteBuffer, coverImage AS ByteBuffer, css AS ByteBuffer, logo AS ByteBuffer) AS VOID OR Error
    LET names AS StringList = NEW StringList()
    names.Add("META-INF/container.xml")
    names.Add(CONTENT_DIR + "content.opf")
    names.Add(CONTENT_DIR + "toc.ncx")
    names.Add(CONTENT_DIR + "nav.xhtml")
    names.Add(CONTENT_DIR + "cover.xhtml")
    names.Add(CONTENT_DIR + "images/cover.svg")
    names.Add(CONTENT_DIR + "css/book.css")
    names.Add(CONTENT_DIR + "images/logo.png")
    FOR index = 0 TO names.Count() - 1
        LET content AS ByteBuffer = logo
        IF index = 0 THEN content = container
        IF index = 1 THEN content = packageDocument
        IF index = 2 THEN content = ncx
        IF index = 3 THEN content = nav
        IF index = 4 THEN content = coverPage
        IF index = 5 THEN content = coverImage
        IF index = 6 THEN content = css
        LET added AS VOID OR Error = zip.AddStored(names.Get(index), content)
        IF added IS Error THEN
            RETURN added
        END IF
    END FOR
    RETURN
END FUNCTION

FUNCTION AddResources(zip AS ZipWriter, resources AS ResourceRegistry) AS VOID OR Error
    FOR index = 0 TO resources.sources.Count() - 1
        LET content AS ByteBuffer OR Error = ReadBinaryFile(resources.sources.Get(index))
        IF content IS Error THEN
            RETURN content
        END IF
        LET added AS VOID OR Error = zip.AddStored(CONTENT_DIR + resources.packaged.Get(index), content)
        IF added IS Error THEN
            RETURN added
        END IF
    END FOR
    RETURN
END FUNCTION

FUNCTION Start() AS INTEGER
    LET bookDir AS STRING = ArgumentOr(1, DEFAULT_BOOK_DIR)
    LET outputDir AS STRING = ArgumentOr(2, DEFAULT_OUTPUT_DIR)
    LET detected AS STRING OR Error = WorkspaceVersion(VERSION_FILE)
    LET version AS STRING = "unknown"
    IF detected IS STRING THEN
        version = detected
    END IF
    version = ArgumentOr(3, version)

    LET now AS STRING = Timestamp.Format(Clock.Now())
    LET generatedDate AS STRING = Mid(now, 0, 10)
    LET modified AS STRING = Mid(now, 0, 19) + "Z"

    LET tocLines AS StringList OR Error = ReadTextLines(bookDir + "/toc.md")
    IF tocLines IS Error THEN
        RETURN Report("reading toc.md", tocLines)
    END IF
    LET outline AS BookOutline = ReadOutline(tocLines)
    LET logo AS ByteBuffer OR Error = ReadBinaryFile(LOGO_FILE)
    IF logo IS Error THEN
        RETURN Report("reading " + LOGO_FILE, logo)
    END IF

    PRINT "Basic Next book ", version, " from ", bookDir
    LET resources AS ResourceRegistry = NEW ResourceRegistry()
    LET links AS LinkRewriter = NEW LinkRewriter(bookDir, outline.parts.names, resources)
    LET rendered AS VOID OR Error = RenderParts(outline, bookDir, links)
    IF rendered IS Error THEN
        RETURN Report("converting chapters", rendered)
    END IF

    LET facts AS PackageFacts = NEW PackageFacts(StableUuid("basic-next-book-en-" + version), outline.title, version, generatedDate, modified)
    LET cover AS CoverFacts = NEW CoverFacts(outline.title, BOOK_AUTHOR, version, generatedDate)
    LET outputPath AS STRING = outputDir + "/" + OUTPUT_PREFIX + version + ".epub"
    LET written AS VOID OR Error = WriteEpub(outputPath, DosStampOf(now), outline, facts, cover, logo, resources)
    IF written IS Error THEN
        RETURN Report("writing " + outputPath, written)
    END IF
    PRINT "wrote ", outputPath
    RETURN 0
END FUNCTION
