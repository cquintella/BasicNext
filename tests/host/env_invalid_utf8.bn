// Run with BN_BAD_UTF8 set to bytes that are not UTF-8: Get returns
// Error(Env.INVALID_UTF8); Has still reports the variable as present.
IMPORT HOST.Env AS Env

FUNCTION Start() AS VOID
    LET bad AS STRING OR Error = Env.Get("BN_BAD_UTF8")
    IF bad IS Error THEN
        PRINT bad.Code = Env.INVALID_UTF8, bad.Operation
    END IF
    PRINT Env.Has("BN_BAD_UTF8")
END FUNCTION
