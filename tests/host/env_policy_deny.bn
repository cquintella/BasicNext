// Run with BN_ENV_POLICY=deny: returns Error(Env.POLICY_DENIED) on both backends.
IMPORT HOST.Env AS Env

FUNCTION Start() AS INTEGER
    LET val AS STRING OR Error = Env.Get("PATH")
    IF val IS Error THEN
        PRINT val.Code = Env.POLICY_DENIED, val.Operation
    END IF
    LET hasVal AS BOOLEAN OR Error = Env.Has("PATH")
    IF hasVal IS Error THEN
        PRINT hasVal.Code = Env.POLICY_DENIED, hasVal.Operation
    END IF
    RETURN 0
END FUNCTION
