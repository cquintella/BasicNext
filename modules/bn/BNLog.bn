// BNLog 0.3 external-module interface. Runtime dispatch is supplied by Rust.

EXPORT CLASS Level
    PUBLIC STATIC ERROR AS INTEGER = 0
    PUBLIC STATIC WARN AS INTEGER = 1
    PUBLIC STATIC INFO AS INTEGER = 2
    PUBLIC STATIC HTTP AS INTEGER = 3
    PUBLIC STATIC VERBOSE AS INTEGER = 4
    PUBLIC STATIC DEBUG AS INTEGER = 5
    PUBLIC STATIC SILLY AS INTEGER = 6
END CLASS

EXPORT CLASS Fields
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION Count() AS INTEGER
        RETURN 0
    END FUNCTION
    PUBLIC FUNCTION SetString(key AS STRING, value AS STRING) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION SetInteger(key AS STRING, value AS INT64) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION SetBoolean(key AS STRING, value AS BOOLEAN) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Get(key AS STRING) AS STRING OR Error
        RETURN ""
    END FUNCTION
END CLASS

EXPORT CLASS Entry
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION WithField(key AS STRING, value AS STRING) AS Entry OR Error
        RETURN NEW Entry()
    END FUNCTION
END CLASS

EXPORT CLASS Transport
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION Flush(timeoutMs AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Close(timeoutMs AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS Logger
    PUBLIC STATIC FUNCTION New(label AS STRING) AS Logger OR Error
        RETURN NEW Logger()
    END FUNCTION
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION AddConsole(minimum AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION AddFile(path AS STRING, minimum AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION AddNull(minimum AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Child(fields AS Fields) AS Logger OR Error
        RETURN NEW Logger()
    END FUNCTION
    PUBLIC FUNCTION Log(level AS INTEGER, message AS STRING, fields AS Fields) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Flush(timeoutMs AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Close(timeoutMs AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS
