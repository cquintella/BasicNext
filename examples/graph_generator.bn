// Graph generation module with stochastic edge count based on normal distribution,
// and edge weights/distances uniformly sampled as integers from 1 to N.

IMPORT HOST.Random AS Random
IMPORT BNMath AS Math

CONST PI AS FLOAT = 3.141592653589793
CONST DEFAULT_PENALTY AS FLOAT = 10000.0

// Samples a random variable from N(mean, stddev^2) using the Box-Muller transform.
EXPORT FUNCTION RandomNormal(mean AS FLOAT, stddev AS FLOAT) AS FLOAT
    LET u1 AS FLOAT = Random.Random()
    LET u2 AS FLOAT = Random.Random()
    WHILE u1 <= 0.0000001
        u1 = Random.Random()
    END WHILE
    LET z0 AS FLOAT = Math.SQRT(-2.0 * Math.LOG(u1)) * Math.COS(2.0 * PI * u2)
    RETURN mean + z0 * stddev
END FUNCTION

// Weighted graph representation storing connectivity and integer edge distances.
EXPORT CLASS Graph
    PUBLIC vertexCount AS INTEGER = 0
    PUBLIC edgeCount AS INTEGER = 0
    PUBLIC penalty AS FLOAT = DEFAULT_PENALTY

    PRIVATE hasEdge AS POINTER TO INTEGER[] = NEW INTEGER[0]
    PRIVATE weight AS POINTER TO FLOAT[] = NEW FLOAT[0]

    PUBLIC FUNCTION CONSTRUCTOR(nodeCount AS INTEGER)
        SELF.vertexCount = nodeCount
        LET totalCells AS INTEGER = nodeCount * nodeCount
        SELF.hasEdge = NEW INTEGER[totalCells]
        SELF.weight = NEW FLOAT[totalCells]

        LET h AS POINTER TO INTEGER[] = SELF.hasEdge
        LET w AS POINTER TO FLOAT[] = SELF.weight
        FOR i AS INTEGER = 0 TO totalCells - 1
            h[i] = 0
            w[i] = 0.0
        END FOR
    END FUNCTION

    // Adds an undirected edge between vertices u and v with integer distance weight.
    PUBLIC FUNCTION AddEdge(u AS INTEGER, v AS INTEGER, edgeWeight AS FLOAT) AS VOID
        IF u = v THEN
            RETURN
        END IF
        LET idx1 AS INTEGER = u * SELF.vertexCount + v
        LET idx2 AS INTEGER = v * SELF.vertexCount + u
        LET h AS POINTER TO INTEGER[] = SELF.hasEdge
        IF h[idx1] = 0 THEN
            h[idx1] = 1
            h[idx2] = 1
            LET w AS POINTER TO FLOAT[] = SELF.weight
            w[idx1] = edgeWeight
            w[idx2] = edgeWeight
            SELF.edgeCount += 1
        END IF
    END FUNCTION

    // Checks whether an edge exists between vertex u and vertex v.
    PUBLIC FUNCTION HasEdge(u AS INTEGER, v AS INTEGER) AS INTEGER
        LET h AS POINTER TO INTEGER[] = SELF.hasEdge
        RETURN h[u * SELF.vertexCount + v]
    END FUNCTION

    // Gets the weight/distance of the edge between u and v.
    PUBLIC FUNCTION GetWeight(u AS INTEGER, v AS INTEGER) AS FLOAT
        LET w AS POINTER TO FLOAT[] = SELF.weight
        RETURN w[u * SELF.vertexCount + v]
    END FUNCTION

    // Gets the distance between vertex u and vertex v.
    PUBLIC FUNCTION GetDistance(u AS INTEGER, v AS INTEGER) AS FLOAT
        RETURN SELF.GetWeight(u, v)
    END FUNCTION

    // Gets the travel cost between u and v, penalizing missing edges.
    PUBLIC FUNCTION GetCost(u AS INTEGER, v AS INTEGER) AS FLOAT
        IF u = v THEN
            RETURN 0.0
        END IF
        IF SELF.HasEdge(u, v) = 1 THEN
            RETURN SELF.GetWeight(u, v)
        ELSE
            RETURN SELF.penalty
        END IF
    END FUNCTION

    // Prints the adjacency matrix of the graph.
    PUBLIC FUNCTION PrintAdjacencyMatrix() AS VOID
        PRINT "[GraphGenerator] Adjacency Matrix (" + (SELF.vertexCount AS STRING) + "x" + (SELF.vertexCount AS STRING) + "):"
        FOR i AS INTEGER = 0 TO SELF.vertexCount - 1
            LET rowStr AS STRING = ""
            FOR j AS INTEGER = 0 TO SELF.vertexCount - 1
                rowStr = rowStr + (SELF.HasEdge(i, j) AS STRING)
                IF j < SELF.vertexCount - 1 THEN
                    rowStr = rowStr + " "
                END IF
            END FOR
            PRINT rowStr
        END FOR
    END FUNCTION

    // Prints the weight / distance matrix of the graph.
    PUBLIC FUNCTION PrintWeightMatrix() AS VOID
        PRINT "[GraphGenerator] Weight/Distance Matrix (" + (SELF.vertexCount AS STRING) + "x" + (SELF.vertexCount AS STRING) + "):"
        FOR i AS INTEGER = 0 TO SELF.vertexCount - 1
            LET rowStr AS STRING = ""
            FOR j AS INTEGER = 0 TO SELF.vertexCount - 1
                rowStr = rowStr + (SELF.GetWeight(i, j) AS INTEGER AS STRING)
                IF j < SELF.vertexCount - 1 THEN
                    rowStr = rowStr + " "
                END IF
            END FOR
            PRINT rowStr
        END FOR
    END FUNCTION

    // Releases all heap-allocated buffers owned by the graph.
    PUBLIC FUNCTION Dispose() AS VOID
        LET h AS POINTER TO INTEGER[] = SELF.hasEdge
        LET w AS POINTER TO FLOAT[] = SELF.weight
        RELEASE h
        RELEASE w
    END FUNCTION
END CLASS

// Generates a random graph with target edges decided by a normal distribution,
// and edge weights/distances uniformly sampled as integers from 1 to maxDistance (N).
EXPORT FUNCTION GenerateGraph(averageDegree AS FLOAT OR INTEGER, vertexCount AS INTEGER, maxDistance AS INTEGER) AS Graph
    LET graph AS Graph = NEW Graph(vertexCount)
    LET maxD AS INTEGER = maxDistance
    IF maxD < 1 THEN
        maxD = 1
    END IF
    graph.penalty = Math.MAX(DEFAULT_PENALTY, ((maxD * vertexCount) AS FLOAT) * 2.0)

    LET d AS FLOAT = 0.0
    IF averageDegree IS INTEGER THEN
        d = averageDegree AS FLOAT
    ELSE
        d = averageDegree
    END IF

    // In an undirected graph: sum(degrees) = 2 * E => E = (d * V) / 2
    LET meanEdges AS FLOAT = (d * (vertexCount AS FLOAT)) / 2.0
    LET stddev AS FLOAT = Math.MAX(1.0, Math.SQRT(meanEdges))
    LET sampledEdges AS FLOAT = RandomNormal(meanEdges, stddev)
    LET targetEdges AS INTEGER = Math.ROUND(sampledEdges, 0) AS INTEGER

    LET maxEdges AS INTEGER = (vertexCount * (vertexCount - 1)) DIV 2
    IF targetEdges < 0 THEN
        targetEdges = 0
    END IF
    IF targetEdges > maxEdges THEN
        targetEdges = maxEdges
    END IF

    PRINT "[GraphGenerator] Expected edges for average degree ", d, ": ", meanEdges
    PRINT "[GraphGenerator] Normal distribution sampled target edges: ", targetEdges
    PRINT "[GraphGenerator] Edge distances (weights) range: 1 to ", maxD

    LET added AS INTEGER = 0
    LET attempts AS INTEGER = 0
    LET maxAttempts AS INTEGER = targetEdges * 100 + 1000

    WHILE added < targetEdges AND attempts < maxAttempts
        attempts += 1
        LET u AS INTEGER = (Random.Random() * (vertexCount AS FLOAT)) AS INTEGER
        LET v AS INTEGER = (Random.Random() * (vertexCount AS FLOAT)) AS INTEGER
        IF u >= vertexCount THEN
            u = vertexCount - 1
        END IF
        IF v >= vertexCount THEN
            v = vertexCount - 1
        END IF

        IF u <> v AND graph.HasEdge(u, v) = 0 THEN
            LET randDist AS INTEGER = (Random.Random() * (maxD AS FLOAT)) AS INTEGER + 1
            IF randDist > maxD THEN
                randDist = maxD
            END IF
            IF randDist < 1 THEN
                randDist = 1
            END IF
            graph.AddEdge(u, v, randDist AS FLOAT)
            added += 1
        END IF
    END WHILE

    PRINT "[GraphGenerator] Random connections created successfully: ", graph.edgeCount
    PRINT ""
    graph.PrintAdjacencyMatrix()
    PRINT ""
    RETURN graph
END FUNCTION