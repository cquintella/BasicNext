// HOST.Args[1] names a file holding "a<NUL>b" and a newline.
// bni prints "line 3"; a native build stops in ReadLine.
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    LET f AS FS.File OR Error = FS.Open(HOST.Args[1], FS.READ)
    IF f IS FS.File THEN
        LET line AS STRING OR EOF OR Error = f.ReadLine()
        IF line IS STRING THEN
            PRINT "line", LEN(line)
        END IF
        f.Close()
    END IF
END FUNCTION
