// Constant integer expressions whose value lies past INT32 initialize a wider
// binding (0.6.md C1: the minus applies to the literal's value, which must
// fit the declared type). Known issue K33: bni stopped with NUMERIC_OVERFLOW;
// bnc panicked on the UINT64 difference.
FUNCTION Start() AS VOID
    LET minimum AS INT64 = -9223372036854775808
    LET product AS INT64 = 4000000000 * 2
    LET sum AS INT64 = 2147483647 + 1
    LET negated AS INT64 = -(3000000000)
    LET unsigned AS UINT64 = 18446744073709551615 - 1
    PRINT minimum, product, sum, negated, unsigned
END FUNCTION
