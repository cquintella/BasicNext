// Runtime trap: a store at an INT64 index above the INT32 range (known
// issue K71: the native binary wrote element 2).
FUNCTION Start() AS INTEGER
    LET values AS INTEGER[3] = [1, 2, 3]
    LET at AS INT64 = 4294967298
    values[at] = 99
    PRINT values[2]
    RETURN 0
END FUNCTION
