CLASS Animal
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION Speak() AS STRING
        RETURN "..."
    END FUNCTION
END CLASS

CLASS Dog EXTENDS Animal
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
    PUBLIC OVERRIDE FUNCTION Speak() AS STRING
        RETURN "woof"
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET pet AS Animal = NEW Dog()
    PRINT pet.Speak()
END FUNCTION
