// Exhausting the socket quota causes BNWeb.Client to return Web.LIMIT.
IMPORT HOST.Net AS Net
IMPORT BNWeb AS Web

FUNCTION Fill(endpoint AS Net.Endpoint, count AS INTEGER) AS VOID
    IF count = 0 THEN
        LET client AS Web.Client = NEW Web.Client()
        LET policy AS Web.EgressPolicy OR Error = Web.EgressPolicy.New("http", "93.184.216.0/24", "80", 0, 1000)
        IF policy IS Error THEN
            PRINT "policy error"
            RETURN
        END IF
        LET res AS Web.Response OR Error = client.RequestWithPolicy("GET", "http://93.184.216.34:80/", "", policy)
        IF res IS Error THEN
            PRINT "client limit:", res.Code = Web.LIMIT, res.Code
        ELSE
            PRINT "unexpected client success"
        END IF
        RETURN
    END IF
    LET s AS Net.UDPSocket OR Error = Net.UDPBind(endpoint)
    IF s IS Error THEN
        PRINT "s is error:", s
        RETURN
    END IF
    Fill(endpoint, count - 1)
END FUNCTION

FUNCTION Start() AS VOID
    LET addr AS Net.Address OR Error = Net.Address.Parse("127.0.0.1")
    IF addr IS Error THEN
        PRINT "addr error"
        RETURN
    END IF
    LET anyPort AS Net.Endpoint OR Error = Net.Endpoint.Create(addr, 0)
    IF anyPort IS Error THEN
        PRINT "endpoint error"
        RETURN
    END IF
    Fill(anyPort, 256)
END FUNCTION
