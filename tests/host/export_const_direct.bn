EXPORT CONST PI AS INTEGER = 3
EXPORT CONST MSG AS STRING = "hello"
EXPORT CONST FLAG AS BOOLEAN = TRUE

FUNCTION GetDoublePi() AS INTEGER
    RETURN PI * 2
END FUNCTION

FUNCTION Start() AS VOID
    PRINT "PI:", PI
    PRINT "MSG:", MSG
    PRINT "FLAG:", FLAG
    PRINT "Double PI:", GetDoublePi()
END FUNCTION
