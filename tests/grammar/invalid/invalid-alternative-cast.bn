// AS does not narrow an alternative. The grammar admits AS INTEGER; the
// conversion is rejected because an alternative is not a numeric value.
FUNCTION Start() AS VOID
    LET number AS INTEGER OR NULL = 1
    PRINT number AS INTEGER
END FUNCTION
