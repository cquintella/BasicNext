#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");

const [modulePath, ...programArgs] = process.argv.slice(2);
if (!modulePath) {
    process.stderr.write("usage: bn-wasm module.wasm [args...]\n");
    process.exit(2);
}

const input = fs.readFileSync(0);
let inputOffset = 0;
let instance;
let heapCursor = 0;
const allocations = new Map();
let randomState = 1n;
// Stack left below a frame when the check trips (bn_rt::stack_abi keeps
// 256 KiB natively; the wasm32 shadow stack is 64 KiB).
const STACK_MARGIN_BYTES = 4096;
// A wasm32 vector row `{ ptr, i32 }`.
const ROW_BYTES = 8;
// STRING header: `[u64 count][u64 len]` then the payload. The value is payload.
const STRING_HEADER_BYTES = 16;
const STRING_LEN_OFFSET = 8;
const IMMORTAL_REF_COUNT = 0xFFFFFFFFFFFFFFFFn;
const MAX_STRING_REF_COUNT = 0x7FFFFFFFFFFFFFFFn;
const FREE_LISTS = new Map();

function catalogLine(key) {
    const file = path.join(__dirname, "../share/bn/catalog/string.txt");
    const text = fs.readFileSync(file, "utf8");
    const prefix = `${key} = `;
    const line = text.split("\n").find((entry) => entry.startsWith(prefix));
    if (line === undefined) {
        throw new Error(`missing string catalog key ${key}`);
    }
    return line.slice(prefix.length);
}

function trapCount(key) {
    process.stderr.write(`${catalogLine(key)}\n`);
    process.exit(1);
}

function reserve(memory, size) {
    const address = Math.ceil(heapCursor / 8) * 8;
    const required = address + size;
    if (required > memory.buffer.byteLength) {
        memory.grow(Math.ceil((required - memory.buffer.byteLength) / 65536));
    }
    heapCursor = required;
    return address;
}

function takeBlock(memory, size) {
    const list = FREE_LISTS.get(size);
    if (list !== undefined && list.length > 0) {
        const address = list.pop();
        allocations.set(address, size);
        return address;
    }
    const address = reserve(memory, size);
    allocations.set(address, size);
    return address;
}

function releaseBlock(address) {
    if (address === 0) return;
    const size = allocations.get(address);
    if (size === undefined) return;
    allocations.delete(address);
    const list = FREE_LISTS.get(size) ?? [];
    list.push(address);
    FREE_LISTS.set(size, list);
}

function cString(memory, address) {
    const bytes = new Uint8Array(memory.buffer);
    let end = address;
    while (bytes[end] !== 0) end += 1;
    return Buffer.from(bytes.subarray(address, end)).toString("utf8");
}

function stringBytes(memory, payload) {
    if (payload === 0) return Buffer.alloc(0);
    const view = new DataView(memory.buffer);
    const length = Number(view.getBigUint64(payload - STRING_LEN_OFFSET, true));
    return Buffer.from(new Uint8Array(memory.buffer).subarray(payload, payload + length));
}

function allocateString(memory, bytes) {
    const total = STRING_HEADER_BYTES + bytes.length + 1;
    const base = takeBlock(memory, total);
    const view = new DataView(memory.buffer);
    view.setBigUint64(base, 1n, true);
    view.setBigUint64(base + STRING_LEN_OFFSET, BigInt(bytes.length), true);
    const payload = base + STRING_HEADER_BYTES;
    const stored = new Uint8Array(memory.buffer);
    stored.set(bytes, payload);
    stored[payload + bytes.length] = 0;
    return payload;
}

function scalarCount(bytes) {
    return [...Buffer.from(bytes).toString("utf8")].length;
}

function packUtf8(character) {
    const encoded = Buffer.from(character, "utf8");
    let value = 0n;
    for (let index = 0; index < encoded.length; index += 1) {
        value |= BigInt(encoded[index]) << BigInt(8 * index);
    }
    return value;
}

function formatInterpreterFloat(value) {
    if (Number.isNaN(value)) return "NAN";
    if (value === Infinity) return "INF";
    if (value === -Infinity) return "-INF";
    let text = Object.is(value, -0) ? "-0" : value.toString();
    if (!/[.eE]/.test(text)) {
        text += ".0";
    }
    return text;
}

function formatGeneral(value, precision) {
    if (Number.isNaN(value)) return "NAN";
    if (value === Infinity) return "INF";
    if (value === -Infinity) return "-INF";
    if (value === 0) return Object.is(value, -0) ? "-0" : "0";
    const exponent = Math.floor(Math.log10(Math.abs(value)));
    const trim = (text) => text.replace(/(\.\d*?)0+$/, "$1").replace(/\.$/, "");
    if (exponent < -4 || exponent >= precision) {
        const [mantissa, rawExponent] = value.toExponential(precision - 1).split("e");
        const sign = rawExponent.startsWith("-") ? "-" : "+";
        const digits = rawExponent.replace(/^[+-]/, "").padStart(2, "0");
        return `${trim(mantissa)}e${sign}${digits}`;
    }
    return trim(value.toFixed(Math.max(0, precision - 1 - exponent)));
}

const imports = {
    env: {
        // Mirrors bn_rt::stack_abi: `1` when a BN call from `frame` would run
        // the shadow stack past its low end (`__stack_low`, exported by bnc),
        // so the program stops with STACK_OVERFLOW.
        bn_rt_stack_check(frame) {
            const low = instance.exports.__stack_low;
            if (low === undefined) {
                // bnc always exports it; without it no overflow is detected.
                throw new Error("module does not export __stack_low");
            }
            return (frame >>> 0) < (low.value >>> 0) + STACK_MARGIN_BYTES ? 1 : 0;
        },
        // Mirrors bn_rt::vector_abi::bn_rt_vector_nest for wasm32, where a row
        // `{ ptr, i32 }` is 8 bytes: links every row of the target storage to
        // its own elements, then copies the elements of `source` (none when
        // `source` is 0 or the target itself).
        bn_rt_vector_nest(rows, leaves, source, dimensionsAddress, rank, elementBytes) {
            const memory = instance.exports.memory;
            const view = new DataView(memory.buffer);
            const bytes = new Uint8Array(memory.buffer);
            [rows, leaves, source] = [rows >>> 0, leaves >>> 0, source >>> 0];
            const element = Number(elementBytes);
            const dimensions = [];
            for (let level = 0; level < rank; level += 1) {
                dimensions.push(view.getUint32(dimensionsAddress + 4 * level, true));
            }
            const levels = rank - 1;
            let levelStart = 0;
            let count = 1;
            for (let level = 0; level < levels; level += 1) {
                count *= dimensions[level];
                const nextStart = levelStart + count;
                const length = dimensions[level + 1];
                for (let index = 0; index < count; index += 1) {
                    const child = index * length;
                    const target = level + 1 === levels
                        ? leaves + child * element
                        : rows + (nextStart + child) * ROW_BYTES;
                    const row = rows + (levelStart + index) * ROW_BYTES;
                    view.setUint32(row, target, true);
                    view.setInt32(row + 4, length, true);
                }
                levelStart = nextStart;
            }
            if (source === 0 || source === rows) return;
            const leafRowBytes = dimensions[levels] * element;
            let cursor = leaves;
            const copy = (sourceRows, level) => {
                for (let index = 0; index < dimensions[level]; index += 1) {
                    const elements = view.getUint32(sourceRows + index * ROW_BYTES, true);
                    if (level + 1 === levels) {
                        bytes.copyWithin(cursor, elements, elements + leafRowBytes);
                        cursor += leafRowBytes;
                    } else {
                        copy(elements, level + 1);
                    }
                }
            };
            copy(source, 0);
        },
        bn_rt_policy_init() {
            return 0;
        },
        // Mirrors bn_rt::policy::bn_rt_policy_check: a rejected policy stops
        // the program before Start's user code (exit status 2).
        bn_rt_policy_check(status) {
            if (status !== 0) {
                process.exit(2);
            }
        },
        bn_rt_random_seed(seed) {
            randomState = BigInt.asUintN(64, BigInt(seed)) || 1n;
            return 0;
        },
        bn_rt_random_next() {
            let next = randomState;
            next ^= next >> 12n;
            next ^= BigInt.asUintN(64, next << 25n);
            next ^= next >> 27n;
            next = BigInt.asUintN(64, next * 0x2545f4914f6cdd1dn);
            randomState = next;
            return Number(next >> 11n) / 9007199254740992;
        },
        bn_rt_clock_timestamp() {
            return BigInt(Date.now());
        },
        bn_rt_clock_monotonic() {
            return process.hrtime.bigint();
        },
        bn_rt_console_cls() {
            return 0;
        },
        bn_rt_console_beep() {
            return 0;
        },
        bn_rt_console_print_at(column, row, textAddress) {
            process.stdout.write(cString(instance.exports.memory, textAddress));
            return 0;
        },
        bn_rt_console_num_cols() {
            return 80;
        },
        bn_rt_console_num_rows() {
            return 24;
        },
        bn_rt_math_iabs(value) { return value < 0n ? -value : value; },
        bn_rt_math_isign(value) { return value < 0n ? -1n : value > 0n ? 1n : 0n; },
        bn_rt_math_imin(left, right) { return left < right ? left : right; },
        bn_rt_math_imax(left, right) { return left > right ? left : right; },
        bn_rt_math_fabs(value) { return Math.abs(value); },
        bn_rt_math_fsign(value) { return value < 0 ? -1 : value > 0 ? 1 : 0; },
        bn_rt_math_fmin(left, right) { return Number.isNaN(left) || Number.isNaN(right) ? NaN : Math.min(left, right); },
        bn_rt_math_fmax(left, right) { return Number.isNaN(left) || Number.isNaN(right) ? NaN : Math.max(left, right); },
        bn_rt_math_sin(value) { return Math.sin(value); },
        bn_rt_math_cos(value) { return Math.cos(value); },
        bn_rt_math_tan(value) { return Math.tan(value); },
        bn_rt_math_asin(value) { return Math.asin(value); },
        bn_rt_math_acos(value) { return Math.acos(value); },
        bn_rt_math_atan(value) { return Math.atan(value); },
        bn_rt_math_atan2(left, right) { return Math.atan2(left, right); },
        bn_rt_math_sqrt(value) { return Math.sqrt(value); },
        bn_rt_math_exp(value) { return Math.exp(value); },
        bn_rt_math_log(value) { return Math.log(value); },
        bn_rt_math_log10(value) { return Math.log10(value); },
        bn_rt_math_log2(value) { return Math.log2(value); },
        bn_rt_math_pow(left, right) { return Math.pow(left, right); },
        bn_rt_math_floor(value) { return Math.floor(value); },
        bn_rt_math_ceil(value) { return Math.ceil(value); },
        bn_rt_math_round(value, digits) {
            const scale = 10 ** digits;
            const scaled = value * scale;
            const floor = Math.floor(scaled);
            const fraction = scaled - floor;
            const rounded = fraction < 0.5 ? floor : fraction > 0.5 ? floor + 1 : (floor % 2 === 0 ? floor : floor + 1);
            return rounded / scale;
        },
        bn_rt_math_trunc(value) { return Math.trunc(value); },
        bn_rt_math_hypot(left, right) { return Math.hypot(left, right); },
        bn_rt_math_fma(left, middle, right) { return left * middle + right; },
        bn_rt_math_val(address) { return Number(cString(instance.exports.memory, address)); },
        bn_rt_math_tohour(value) {
            return Math.floor(((Number(value) % 86400000) + 86400000) % 86400000 / 3600000);
        },
        bn_rt_math_toweekday(value) {
            const days = Math.floor(Number(value) / 86400000);
            return ((days + 3) % 7 + 7) % 7 + 1;
        },
        bn_rt_math_todate(value) { return Math.floor(Number(value) / 86400000); },
        bn_rt_math_totime(value) { return ((Number(value) % 86400000) + 86400000) % 86400000; },
        bn_rt_math_totimestamp(days, millis) { return BigInt(Number(days) * 86400000 + Number(millis)); },
        getchar() {
            return inputOffset < input.length ? input[inputOffset++] : -1;
        },
        putchar(value) {
            process.stdout.write(Buffer.from([value & 0xff]));
            return value;
        },
        printf(formatAddress, argumentsAddress) {
            const memory = instance.exports.memory;
            const format = cString(memory, formatAddress);
            const view = new DataView(memory.buffer);
            let value;
            if (format === "%lld") {
                value = view.getBigInt64(argumentsAddress, true).toString();
            } else if (format === "%s") {
                value = cString(memory, view.getUint32(argumentsAddress, true));
            } else if (format === "%.17g") {
                value = formatGeneral(view.getFloat64(argumentsAddress, true), 17);
            } else {
                throw new Error(`unsupported Basic Next printf format: ${format}`);
            }
            process.stdout.write(value);
            return Buffer.byteLength(value);
        },
        bn_rt_print_float(value) {
            process.stdout.write(formatInterpreterFloat(value));
        },
        realloc(address, rawSize) {
            const memory = instance.exports.memory;
            const size = Number(rawSize);
            const previousSize = address === 0 ? 0 : allocations.get(address) ?? 0;
            const replacement = takeBlock(memory, size);
            const bytes = new Uint8Array(memory.buffer);
            bytes.fill(0, replacement, replacement + size);
            if (address !== 0) {
                bytes.copyWithin(replacement, address, address + Math.min(previousSize, size));
                releaseBlock(address);
            }
            return replacement;
        },
        malloc(rawSize) {
            const memory = instance.exports.memory;
            const size = Number(rawSize);
            const address = takeBlock(memory, size);
            new Uint8Array(memory.buffer).fill(0, address, address + size);
            return address;
        },
        free(address) {
            releaseBlock(address);
        },
        exit(code) {
            process.exit(Number(code));
        },
        bn_rt_str_len(address) {
            const bytes = stringBytes(instance.exports.memory, address);
            return scalarCount(bytes);
        },
        bn_rt_str_eq(left, right) {
            const memory = instance.exports.memory;
            return stringBytes(memory, left).equals(stringBytes(memory, right)) ? 1 : 0;
        },
        bn_rt_str_concat(left, _leftLength, right, _rightLength) {
            const memory = instance.exports.memory;
            return allocateString(memory, Buffer.concat([
                stringBytes(memory, left),
                stringBytes(memory, right),
            ]));
        },
        bn_rt_str_from_packed(packed) {
            const value = BigInt(packed);
            if (value === 0n) {
                return allocateString(instance.exports.memory, Buffer.from([0]));
            }
            const bytes = [];
            for (let shift = 0n; shift < 64n; shift += 8n) {
                const byte = Number((value >> shift) & 0xFFn);
                if (byte === 0) break;
                bytes.push(byte);
            }
            return allocateString(instance.exports.memory, Buffer.from(bytes));
        },
        bn_rt_str_from_char(code) {
            const value = Number(code);
            let character;
            try {
                character = String.fromCodePoint(value);
            } catch {
                return 0;
            }
            return allocateString(instance.exports.memory, Buffer.from(character, "utf8"));
        },
        bn_rt_str_asc(address) {
            const bytes = stringBytes(instance.exports.memory, address);
            if (bytes.length === 0) return -1n;
            const code = bytes.toString("utf8").codePointAt(0);
            return code === undefined ? -1n : BigInt(code);
        },
        bn_rt_str_index_utf8(address, index, _trap) {
            const bytes = stringBytes(instance.exports.memory, address);
            const chars = [...bytes.toString("utf8")];
            if (index < 0 || index >= chars.length) {
                process.stderr.write(
                    `bn-wasm: INDEX_OUT_OF_BOUNDS index ${index} is outside string length ${chars.length}\n`,
                );
                process.exit(1);
            }
            return packUtf8(chars[index]);
        },
        bn_rt_str_to_lower(address) {
            const bytes = stringBytes(instance.exports.memory, address);
            return allocateString(
                instance.exports.memory,
                Buffer.from(bytes.toString("utf8").toLowerCase(), "utf8"),
            );
        },
        bn_rt_str_to_upper(address) {
            const bytes = stringBytes(instance.exports.memory, address);
            return allocateString(
                instance.exports.memory,
                Buffer.from(bytes.toString("utf8").toUpperCase(), "utf8"),
            );
        },
        bn_rt_str_retain(address) {
            if (address === 0) return 0;
            const view = new DataView(instance.exports.memory.buffer);
            const slot = address - STRING_HEADER_BYTES;
            const current = view.getBigUint64(slot, true);
            if (current === IMMORTAL_REF_COUNT) return 0;
            if (current >= MAX_STRING_REF_COUNT) trapCount("retain-overflow");
            view.setBigUint64(slot, current + 1n, true);
            return 0;
        },
        bn_rt_str_release(address) {
            if (address === 0) return 0;
            const view = new DataView(instance.exports.memory.buffer);
            const slot = address - STRING_HEADER_BYTES;
            const current = view.getBigUint64(slot, true);
            if (current === IMMORTAL_REF_COUNT) return 0;
            if (current === 0n) trapCount("release-of-zero");
            const next = current - 1n;
            view.setBigUint64(slot, next, true);
            if (next === 0n) releaseBlock(slot);
            return 0;
        },
        bn_rt_cstr_copy(address) {
            if (address === 0) return 0;
            return allocateString(
                instance.exports.memory,
                Buffer.from(cString(instance.exports.memory, address), "utf8"),
            );
        },
        bn_rt_input_line(_reusable) {
            if (inputOffset >= input.length) return 0;
            let end = inputOffset;
            while (end < input.length && input[end] !== 10) end += 1;
            let stop = end;
            if (stop > inputOffset && input[stop - 1] === 13) stop -= 1;
            const bytes = input.subarray(inputOffset, stop);
            inputOffset = end < input.length ? end + 1 : end;
            return allocateString(instance.exports.memory, bytes);
        },
        bn_rt_error_print(code, _error) {
            process.stdout.write(`Error ${code}\n`);
        },
        bn_rt_error_wrap(failed, value, _operation) {
            if (!failed) return value;
            process.stderr.write("bn-wasm: a failed call was wrapped as Error\n");
            process.exit(1);
        },
        bn_rt_print_str(address, _length) {
            process.stdout.write(stringBytes(instance.exports.memory, address));
        },
    },
};

WebAssembly.instantiate(fs.readFileSync(modulePath), imports)
    .then(({ instance: loaded }) => {
        instance = loaded;
        const memory = instance.exports.memory;
        const argumentsList = [modulePath, ...programArgs];
        heapCursor = Number(instance.exports.__heap_base.value);
        const pointers = takeBlock(memory, argumentsList.length * 4);
        argumentsList.forEach((value, index) => {
            const payload = allocateString(memory, Buffer.from(value, "utf8"));
            new DataView(instance.exports.memory.buffer).setUint32(
                pointers + index * 4,
                payload,
                true,
            );
        });
        const code = instance.exports.main(argumentsList.length, pointers);
        process.exit(Number(code));
    })
    .catch((error) => {
        process.stderr.write(`bn-wasm: ${error.message}\n`);
        process.exit(2);
    });
