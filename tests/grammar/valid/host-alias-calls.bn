// IMPORT HOST.NumProcs AS N, then call the alias. The count depends on the
// machine, so the program prints whether it is positive.

IMPORT HOST.NumProcs AS N

FUNCTION Start() AS VOID
    LET count AS INTEGER OR Error = N()
    IF count IS Error THEN
        PRINT "ERROR"
    ELSE
        IF count > 0 THEN
            PRINT "OK"
        ELSE
            PRINT "ZERO"
        END IF
    END IF
END FUNCTION
