IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    LET values AS FLOAT[4] = [1.0, 2.0, 2.0, 5.0]
    PRINT Math.MEAN(values), Math.MEDIAN(values), Math.MAX(values)
END FUNCTION
