FUNCTION Start() AS VOID
    LET x AS INTEGER = 1
    LET y AS INTEGER = 1
    IF x = y THEN PRINT "equal"
    IF x <> y THEN PRINT "unexpected" ELSE PRINT "fallback"
END FUNCTION
