IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    LET values AS INTEGER[2] = [2, 1]
    LET minimum AS INTEGER = Math.MIN(values)
    LET maximum AS INTEGER = Math.MAX(values)
    PRINT minimum, maximum
END FUNCTION
