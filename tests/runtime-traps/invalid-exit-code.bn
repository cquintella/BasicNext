// STOP of a value outside 0..255 stops with INVALID_EXIT_CODE, status 1.
// The caret is FUNCTION Start (0.6.md, "Control flow").

FUNCTION Start() AS INTEGER
    LET code AS INTEGER = -1
    STOP code
END FUNCTION
