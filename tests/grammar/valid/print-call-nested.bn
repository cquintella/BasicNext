FUNCTION AddOne(value AS INTEGER) AS INTEGER
    RETURN value + 1
END FUNCTION

FUNCTION AddTwo(value AS INTEGER) AS INTEGER
    RETURN AddOne(AddOne(value))
END FUNCTION

FUNCTION Start() AS VOID
    PRINT AddTwo(3)
END FUNCTION
