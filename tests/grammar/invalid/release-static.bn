// RELEASE takes a local binding or a parameter (0.6.md, "`RELEASE`"); a
// STATIC lets go by assigning NULL.
CLASS Item
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

CLASS Registry
    PUBLIC STATIC shared AS Item OR NULL = NULL
END CLASS

FUNCTION Start() AS VOID
    Registry.shared = NEW Item()
    RELEASE Registry.shared
END FUNCTION
