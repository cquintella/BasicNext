IMPORT Lib.Boxes AS Boxes

FUNCTION Start() AS VOID
    LET box AS Boxes.Box = NEW Boxes.Box(7)
    LET alias AS Boxes.Box = box
    PRINT box.Value(), alias.Value(), Boxes.Box.Count()
END FUNCTION
