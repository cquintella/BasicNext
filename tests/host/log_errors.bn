// The refusals of the BNLog API (bnlog.md, "Errors"), each an Error the
// program handles: Code and Operation, on both backends.
IMPORT BNLog AS Log
IMPORT HOST.Console AS CON

FUNCTION Show(result AS VOID OR Error) AS VOID
    IF result IS Error THEN
        PRINT result.Code, result.Operation
    ELSE
        PRINT "ok"
    END IF
END FUNCTION

FUNCTION Made(made AS Log.Logger OR Error) AS VOID
    IF made IS Error THEN
        PRINT made.Code, made.Operation
    ELSE
        PRINT "made"
    END IF
END FUNCTION

FUNCTION Start() AS INTEGER
    Made(Log.Logger.New("", "JSON", "CONSOLE"))
    Made(Log.Logger.New("app", "XML", "CONSOLE"))
    Made(Log.Logger.New("app", "JSON", ""))
    Made(Log.Logger.New("app", "JSON", "app.log"))
    LET web AS Log.Logger OR Error = Log.Logger.New("web", "APACHE", "NULL")
    LET app AS Log.Logger OR Error = Log.Logger.New("app", "JSON", "NULL")
    IF web IS Error OR app IS Error THEN
        RETURN 1
    END IF
    LET event AS Log.Event
    Show(web.Info("not an access record", event))
    Show(app.SetLevel(7))
    Show(app.Flush(0))
    Show(app.Close(60001))
    Show(app.Close(1000))
    Show(app.Info("closed", event))
    Show(app.SetLevel(Log.Level.INFO))
    Show(app.Close(1000))
    RETURN 0
END FUNCTION
