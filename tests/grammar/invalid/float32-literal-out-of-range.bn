// A literal stored as FLOAT32 whose nearest FLOAT32 is an infinity (0.6.md,
// "Floating-point literals out of range").
FUNCTION Start() AS VOID
    LET f AS FLOAT32 = 100000000000000000000000000000000000000000000000000.0
    PRINT f
END FUNCTION
