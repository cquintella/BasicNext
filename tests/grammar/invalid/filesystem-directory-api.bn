// Listing a directory stays outside the surface until bucket 0.6.16
// (language/0.6/host.md, "Outside 0.6.12"); creating one is valid since
// 0.6.12.
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    FS.ListDirectory("data")
END FUNCTION
