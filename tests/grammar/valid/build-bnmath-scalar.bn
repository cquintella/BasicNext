IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    PRINT Math.ABS(-5)
    PRINT Math.SIN(0.0)
    PRINT Math.VAL("-2.5")
    PRINT Math.TOHOUR(0 AS TIMESTAMP)
    PRINT Math.MIN(2, 9)
END FUNCTION
