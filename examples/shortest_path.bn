FUNCTION Start() AS VOID
    LET graph AS INTEGER[3][3] = [[0, 4, 9], [4, 0, 2], [9, 2, 0]]
    LET via AS INTEGER = graph[0][1] + graph[1][2]
    LET direct AS INTEGER = graph[0][2]
    IF via < direct THEN
        PRINT via
    ELSE
        PRINT direct
    END IF
END FUNCTION
