IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    LET file AS FS.File OR Error = FS.Open("Cargo.toml", FS.READ)
    IF file IS Error THEN
        RETURN
    END IF
    PRINT file.ReadLine()
    file.Close()
    DELETE file
END FUNCTION
