IMPORT BNData AS Data

FUNCTION Start() AS VOID
    LET frame AS Data.DataFrame = NEW Data.DataFrame()
    LET pair AS INTEGER[2] = [1, 2]
    LET single AS INTEGER[1] = [3]
    PRINT frame.AddIntegerColumn("A", pair)
    PRINT frame.AddIntegerColumn("A", pair)
    PRINT frame.AddIntegerColumn("B", single)
    PRINT frame.ColumnName(1)
    DELETE frame
END FUNCTION
