// BNMath.Quantile, R type 7 (math.md, "Descriptive statistics"; BDFL
// decision G-5, 2026-10-27). Expected output: quantile.expected, every
// value from R 4.5.1 quantile(x, p, type = 7), checked with == against the
// printed decimal (3.0999999999999996 is one unit below 3.1, as in R):
//   - 7, 1, 6, 2, 5, 3, 4 at p = 0, 0.1, 0.25, 0.5, 0.9, 1;
//   - 1, 2, 3, 4 at p = 0.3, 1/3 and 0.7; the INTEGER 10..50 at 0.7;
//   - a tie at the interpolation pair (2.5, 2.5, 7 at 0.25) is the tied value;
//   - INF: (1, INF) at 0.5 is INF; (-INF, INF) at 0.5 is NAN; (-INF, 1, INF)
//     at 0, 0.5 and 1 is -INF, 1.0, INF;
//   - p outside [0, 1] or NAN, an empty vector or a NAN value give NAN.

IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    LET seven AS FLOAT[7] = [7.0, 1.0, 6.0, 2.0, 5.0, 3.0, 4.0]
    LET quad AS FLOAT[4] = [1.0, 2.0, 3.0, 4.0]
    LET tens AS INTEGER[5] = [10, 20, 30, 40, 50]
    LET tied AS FLOAT[3] = [2.5, 2.5, 7.0]
    LET upper AS FLOAT[2] = [1.0, INF]
    LET both AS FLOAT[2] = [-INF, INF]
    LET spread AS FLOAT[3] = [-INF, 1.0, INF]
    LET empty AS FLOAT[0] = []
    LET withNan AS FLOAT[2] = [1.0, NAN]
    PRINT "seven", Math.Quantile(seven, 0.0), Math.Quantile(seven, 0.1), Math.Quantile(seven, 0.25), Math.Quantile(seven, 0.5), Math.Quantile(seven, 0.9), Math.Quantile(seven, 1.0)
    PRINT "quad", Math.Quantile(quad, 0.3), Math.Quantile(quad, 1.0 / 3.0), Math.Quantile(quad, 0.7)
    PRINT "integers", Math.Quantile(tens, 0.7), Math.Quantile(tied, 0.25)
    PRINT "infinite", Math.Quantile(upper, 0.5), Math.Quantile(both, 0.5), Math.Quantile(spread, 0.0), Math.Quantile(spread, 0.5), Math.Quantile(spread, 1.0)
    PRINT "nan", Math.Quantile(quad, 1.5), Math.Quantile(quad, -0.1), Math.Quantile(quad, NAN), Math.Quantile(empty, 0.5), Math.Quantile(withNan, 0.5)
END FUNCTION
