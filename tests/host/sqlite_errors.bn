IMPORT BNData AS Data
IMPORT BNSqlite AS Sqlite

FUNCTION Start() AS INTEGER
    LET conn AS Sqlite.Connection OR Error = Sqlite.Open(":memory:")
    IF conn IS Error THEN
        PRINT "OPEN_FAILED:", conn.Code
        RETURN 1
    END IF

    // Setup table with UNIQUE constraint
    LET res AS VOID OR Error = conn.Exec("CREATE TABLE users (id INT UNIQUE, name TEXT);")
    IF res IS Error THEN
        PRINT "SETUP_FAILED:", res.Code
        RETURN 1
    END IF
    res = conn.Exec("INSERT INTO users VALUES (1, 'Alice');")

    // 1. SYNTAX_ERROR (8)
    LET syntaxErr AS VOID OR Error = conn.Exec("CREAT TABLE bad_syntax (x INT);")
    IF syntaxErr IS Error THEN
        PRINT "SYNTAX_ERROR_VERIFIED:", syntaxErr.Code = Sqlite.SYNTAX_ERROR
    END IF

    // 2. SCHEMA_ERROR (9)
    LET schemaErr AS Data.DataFrame OR Error = conn.Query("SELECT * FROM missing_table;")
    IF schemaErr IS Error THEN
        PRINT "SCHEMA_ERROR_VERIFIED:", schemaErr.Code = Sqlite.SCHEMA_ERROR
    END IF

    // 3. CONSTRAINT_VIOLATION (10)
    LET constrErr AS VOID OR Error = conn.Exec("INSERT INTO users VALUES (1, 'Duplicate');")
    IF constrErr IS Error THEN
        PRINT "CONSTRAINT_VERIFIED:", constrErr.Code = Sqlite.CONSTRAINT_VIOLATION
    END IF

    // 4. MISUSE (12) - Exec on SELECT
    LET misuseExec AS VOID OR Error = conn.Exec("SELECT * FROM users;")
    IF misuseExec IS Error THEN
        PRINT "MISUSE_EXEC_VERIFIED:", misuseExec.Code = Sqlite.MISUSE
    END IF

    // 5. MISUSE (12) - Query on DDL/DML
    LET misuseQuery AS Data.DataFrame OR Error = conn.Query("DROP TABLE users;")
    IF misuseQuery IS Error THEN
        PRINT "MISUSE_QUERY_VERIFIED:", misuseQuery.Code = Sqlite.MISUSE
    END IF

    // 6. CLOSED (13) - method call on closed connection
    res = conn.Close()
    LET closedExec AS VOID OR Error = conn.Exec("SELECT 1;")
    IF closedExec IS Error THEN
        PRINT "CLOSED_EXEC_VERIFIED:", closedExec.Code = Sqlite.CLOSED
    END IF

    // 7. CLOSED (13) - double close
    LET closedClose AS VOID OR Error = conn.Close()
    IF closedClose IS Error THEN
        PRINT "CLOSED_CLOSE_VERIFIED:", closedClose.Code = Sqlite.CLOSED
    END IF

    PRINT "ERRORS_COMPLETE"
    RETURN 0
END FUNCTION
