// Runs a child that writes its pid to HOST.Args[1] and sleeps. A signal that
// ends this program must end the child too.
IMPORT HOST.Exec AS Exec

FUNCTION Start() AS VOID
    LET args AS STRING[2]
    args[0] = "-c"
    args[1] = "echo $$ > '" + HOST.Args[1] + "'; exec sleep 50"
    LET result AS Exec.Result OR Error = Exec.Run("/bin/sh", args)
    PRINT result IS Error
END FUNCTION
