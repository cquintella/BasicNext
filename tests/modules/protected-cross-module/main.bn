IMPORT Zoo AS Z

CLASS Dog EXTENDS Z.Animal
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
    PUBLIC FUNCTION Run() AS STRING
        RETURN SELF.Breath()
    END FUNCTION
    PUBLIC FUNCTION Legs() AS INTEGER
        RETURN SELF.legs
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET d AS Dog = NEW Dog()
    PRINT d.Run()
    PRINT d.Legs()
END FUNCTION
