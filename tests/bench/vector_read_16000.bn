// bni benchmark (bucket 0.6.10 F.0): fill, then read every element of a
// 16000-element vector; reading must be linear in n.
FUNCTION Start() AS VOID
    LET a AS INTEGER[16000]
    LET s AS INTEGER = 0
    FOR j AS INTEGER = 0 TO 15999
        a[j] = 1
    END FOR
    FOR k AS INTEGER = 0 TO 15999
        s = s + a[k]
    END FOR
    PRINT s
END FUNCTION
