IMPORT HOST.Exec AS Exec
IMPORT HOST.Net AS Net

FUNCTION Make(text AS STRING) AS Exec.Result OR Error
    LET args AS STRING[2]
    args[0] = "-c"
    args[1] = "printf " + text
    RETURN Exec.Run("/bin/sh", args)
END FUNCTION

FUNCTION Kept() AS STRING
    LET result AS Exec.Result OR Error = Make("kept")
    IF result IS Error THEN
        RETURN "error"
    END IF
    LET text AS STRING = result.Stdout
    RETURN text
END FUNCTION

FUNCTION Lists() AS INTEGER
    // A generous timeout: this test counts handles, and a loaded machine can take
    // more than a few milliseconds to resolve localhost.
    LET first AS Net.Addresses OR Error = Net.Resolve("localhost", 5000)
    LET second AS Net.Addresses OR Error = first
    RELEASE first
    IF second IS Error THEN
        RETURN -1
    END IF
    RETURN second.Count()
END FUNCTION

FUNCTION Start() AS VOID
    LET a AS Exec.Result OR Error = Make("one")
    LET b AS Exec.Result OR Error = a
    RELEASE a
    IF b IS Error THEN
        PRINT "error"
    ELSE
        PRINT b.Stdout
        PRINT b.ReturnCode
    END IF
    PRINT Kept()
    PRINT Lists() > 0
    LET none AS STRING[1]
    none[0] = ""
    LET failed AS Exec.Result OR Error = Exec.Run("/no/such/program", none)
    IF failed IS Error THEN
        PRINT failed.Code
    END IF
END FUNCTION
