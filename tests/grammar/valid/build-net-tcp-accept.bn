IMPORT HOST.Net AS Net

FUNCTION Start() AS VOID
    LET address AS Net.Address OR Error = Net.Address.Parse("127.0.0.1")
    IF address IS Error THEN
        PRINT "error"
    ELSE
        LET endpoint AS Net.Endpoint OR Error = Net.Endpoint.Create(address, 0)
        IF endpoint IS Error THEN
            PRINT "error"
        ELSE
            LET endpoints AS Net.Endpoint[1] = [endpoint]
            LET listener AS Net.TCPListener OR Error = Net.TCPListen(endpoints, 1)
            IF listener IS Error THEN
                PRINT "error"
            ELSE
                LET local AS Net.Endpoint OR Error = listener.LocalEndpoint()
                IF local IS Error THEN
                    PRINT "error"
                ELSE
                    LET client AS Net.TCPStream OR Error = Net.TCPConnect(local, 1000)
                    LET accepted AS Net.TCPStream OR Error = listener.Accept(1000)
                    IF client IS Error OR accepted IS Error THEN
                        PRINT "error"
                    ELSE
                        LET payload AS POINTER TO BYTE[] = NEW BYTE[1]
                        LET written AS INTEGER OR Error = client.Write(payload, 1)
                        LET received AS POINTER TO BYTE[] = NEW BYTE[1]
                        LET read AS INTEGER OR EOF OR Error = accepted.Read(received, 1)
                        PRINT written IS Error, read IS EOF
                        DELETE received
                        DELETE payload
                        client.Close()
                        accepted.Close()
                    END IF
                END IF
                listener.Close()
            END IF
        END IF
    END IF
END FUNCTION
