CLASS Parent
    PUBLIC first AS INTEGER = 17
    PUBLIC second AS INTEGER = 23

    PUBLIC FUNCTION DESTRUCTOR()
    END FUNCTION
END CLASS

CLASS Child EXTENDS Parent
    PUBLIC third AS INTEGER = 31

    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET value AS Child = NEW Child()
    PRINT value.first
    PRINT value.second
    PRINT value.third
    DELETE value
END FUNCTION
