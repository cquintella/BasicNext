// Recursion that never ends stops with STACK_OVERFLOW on both backends, after
// the output written before it (0.6.md, "Recursion depth"; known issue K53).

FUNCTION Depth(n AS INTEGER) AS INTEGER
    RETURN Depth(n + 1) + 1
END FUNCTION

FUNCTION Start() AS VOID
    PRINT "before"
    PRINT Depth(0)
END FUNCTION
