// CHAR(0) is a one-scalar STRING: bni prints 1 3; a native build stops.
FUNCTION Start() AS VOID
    LET z AS STRING OR Error = CHAR(0)
    IF z IS STRING THEN
        PRINT LEN(z), LEN("a" + z + "b")
    END IF
END FUNCTION
