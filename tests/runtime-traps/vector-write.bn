// Runtime trap: vector write out of bounds. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET values AS INTEGER[3] = [1, 2, 3]
    LET at AS INTEGER = 4
    values[at] = 9
    RETURN 0
END FUNCTION
