// BNFfi 0.6 external-module interface.
// Native libffi and dynamic loader bindings for foreign C calls.

// Error codes (language/0.6/bnffi.md).
EXPORT CONST INVALID_ARGUMENT AS INTEGER = 1
EXPORT CONST LIBRARY_NOT_FOUND AS INTEGER = 2
EXPORT CONST LIBRARY_LOAD_FAILED AS INTEGER = 3
EXPORT CONST SYMBOL_NOT_FOUND AS INTEGER = 4
EXPORT CONST INVALID_SIGNATURE AS INTEGER = 5
EXPORT CONST VALUE_OUT_OF_RANGE AS INTEGER = 6
EXPORT CONST INVALID_STRING AS INTEGER = 7
EXPORT CONST INVALID_UTF8 AS INTEGER = 8

EXPORT INTERFACE Value
END INTERFACE

EXPORT CLASS Int8 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS INT8)
    END FUNCTION

    PUBLIC FUNCTION Value() AS INT8
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS UInt8 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS BYTE)
    END FUNCTION

    PUBLIC FUNCTION Value() AS BYTE
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS Int16 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS INT16)
    END FUNCTION

    PUBLIC FUNCTION Value() AS INT16
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS UInt16 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS UINT16)
    END FUNCTION

    PUBLIC FUNCTION Value() AS UINT16
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS Int32 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS INTEGER)
    END FUNCTION

    PUBLIC FUNCTION Value() AS INTEGER
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS UInt32 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS UINT32)
    END FUNCTION

    PUBLIC FUNCTION Value() AS UINT32
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS Int64 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS INT64)
    END FUNCTION

    PUBLIC FUNCTION Value() AS INT64
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS UInt64 IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS UINT64)
    END FUNCTION

    PUBLIC FUNCTION Value() AS UINT64
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS Int IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS INTEGER)
    END FUNCTION

    PUBLIC FUNCTION Value() AS INTEGER
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS UInt IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS UINT32)
    END FUNCTION

    PUBLIC FUNCTION Value() AS UINT32
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS Long IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS INT64)
    END FUNCTION

    PUBLIC FUNCTION Value() AS INT64
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS ULong IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS UINT64)
    END FUNCTION

    PUBLIC FUNCTION Value() AS UINT64
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS SizeT IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS UINT64)
    END FUNCTION

    PUBLIC FUNCTION Value() AS UINT64
        RETURN 0
    END FUNCTION
END CLASS

EXPORT CLASS Float IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS FLOAT32)
    END FUNCTION

    PUBLIC FUNCTION Value() AS FLOAT32
        RETURN 0.0
    END FUNCTION
END CLASS

EXPORT CLASS Double IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS FLOAT)
    END FUNCTION

    PUBLIC FUNCTION Value() AS FLOAT
        RETURN 0.0
    END FUNCTION
END CLASS

EXPORT CLASS Bool IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS BOOLEAN)
    END FUNCTION

    PUBLIC FUNCTION Value() AS BOOLEAN
        RETURN FALSE
    END FUNCTION
END CLASS

EXPORT CLASS String IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(v AS STRING)
    END FUNCTION
END CLASS

EXPORT CLASS Void IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

EXPORT CLASS Handle IMPLEMENTS Value
    PRIVATE FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION ReadString() AS STRING OR Error
        RETURN ""
    END FUNCTION
END CLASS

EXPORT CLASS HandleResult IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Value() AS Handle OR NULL
        RETURN NULL
    END FUNCTION
END CLASS

EXPORT CLASS ByteArray IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO BYTE[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS Int8Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO INT8[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS Int16Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO INT16[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS Int32Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO INTEGER[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS Int64Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO INT64[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS UInt16Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO UINT16[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS UInt32Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO UINT32[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS UInt64Array IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO UINT64[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS FloatArray IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO FLOAT32[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS DoubleArray IMPLEMENTS Value
    PUBLIC FUNCTION CONSTRUCTOR(r AS POINTER TO FLOAT[])
    END FUNCTION

    PUBLIC FUNCTION ReadFrom(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION

    PUBLIC FUNCTION WriteTo(h AS Handle) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS

EXPORT CLASS Args
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION

    PUBLIC FUNCTION Add(v AS Value) AS VOID
        RETURN
    END FUNCTION

    PUBLIC FUNCTION Count() AS INTEGER
        RETURN 0
    END FUNCTION
END CLASS

EXPORT FUNCTION Call(library AS STRING, symbol AS STRING, args AS Args, result AS Value) AS VOID OR Error
    RETURN
END FUNCTION
