IMPORT BNData AS Data

FUNCTION Start() AS VOID
    LET table AS Data.DataFrame = NEW Data.DataFrame()
    LET values AS INTEGER[1] = [1]
    table.AddIntegerColumn("Id", values)
    LET rows AS INTEGER[1]
    rows[0] = -1
    LET result AS Data.DataFrame OR Error = table.Select(rows, [0])
    IF result IS Error THEN
        PRINT result.Code
    END IF
    DELETE table
END FUNCTION
