// BNMath is a standard-library module. The signatures in this file are the
// semantic API. Numeric evaluation is supplied by the reference runtime.
//
// MIN/MAX also accept one numeric vector or region; ABS/SIGN/MIN/MAX accept
// any numeric type. Those forms are checked by the frontend and are not
// extra overloads in this file.

EXPORT FUNCTION ABS(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION MIN(left AS FLOAT, right AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION MAX(left AS FLOAT, right AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION SIGN(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION FLOOR(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION CEIL(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION TRUNC(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION ROUND(value AS FLOAT, digits AS INTEGER) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION EXP(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION LOG(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION LOG10(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION LOG2(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION POW(base AS FLOAT, exponent AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION SIN(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION COS(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION TAN(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION ASIN(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION ACOS(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION ATAN(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION ATAN2(y AS FLOAT, x AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION SQRT(value AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION HYPOT(x AS FLOAT, y AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION FMA(a AS FLOAT, b AS FLOAT, c AS FLOAT) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION VAL(text AS STRING) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION MEAN(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION MEDIAN(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION QUARTILE1(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION QUARTILE3(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION MODE(values AS FLOAT[]) AS FLOAT OR NA
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION STDEV(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION VARIANCE(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION RANGE(values AS FLOAT[]) AS FLOAT
    RETURN 0.0
END FUNCTION

EXPORT FUNCTION TOHOUR(value AS TIMESTAMP) AS INTEGER
    RETURN 0
END FUNCTION

EXPORT FUNCTION TOWEEKDAY(value AS TIMESTAMP) AS INTEGER
    RETURN 0
END FUNCTION

EXPORT FUNCTION TODATE(value AS TIMESTAMP) AS DATE
    LET result AS DATE
    RETURN result
END FUNCTION

EXPORT FUNCTION TOTIME(value AS TIMESTAMP) AS TIME
    LET result AS TIME
    RETURN result
END FUNCTION

EXPORT FUNCTION TOTIMESTAMP(date AS DATE, time AS TIME) AS TIMESTAMP
    RETURN 0
END FUNCTION

EXPORT CLASS Limits
    PUBLIC STATIC MAX_INT8 AS INT8 = 127
    PUBLIC STATIC MIN_INT8 AS INT8 = -128
    PUBLIC STATIC MAX_INT16 AS INT16 = 32767
    PUBLIC STATIC MIN_INT16 AS INT16 = -32768
    PUBLIC STATIC MAX_INTEGER AS INTEGER = 2147483647
    PUBLIC STATIC MIN_INTEGER AS INTEGER = -2147483648
    PUBLIC STATIC MAX_INT32 AS INTEGER = 2147483647
    PUBLIC STATIC MIN_INT32 AS INTEGER = -2147483648
    PUBLIC STATIC MAX_INT64 AS INT64 = 9223372036854775807
    PUBLIC STATIC MIN_INT64 AS INT64 = -9223372036854775808
    PUBLIC STATIC MAX_TIMESTAMP AS TIMESTAMP = 9223372036854775807
    PUBLIC STATIC MIN_TIMESTAMP AS TIMESTAMP = -9223372036854775808
    PUBLIC STATIC MAX_BYTE AS BYTE = 255
    PUBLIC STATIC MIN_BYTE AS BYTE = 0
    PUBLIC STATIC MAX_UINT16 AS UINT16 = 65535
    PUBLIC STATIC MIN_UINT16 AS UINT16 = 0
    PUBLIC STATIC MAX_UINT32 AS UINT32 = 4294967295
    PUBLIC STATIC MIN_UINT32 AS UINT32 = 0
    PUBLIC STATIC MAX_UINT64 AS UINT64 = 18446744073709551615
    PUBLIC STATIC MIN_UINT64 AS UINT64 = 0
    PUBLIC STATIC MAX_FLOAT32 AS FLOAT32 = 0.0
    PUBLIC STATIC MIN_FLOAT32 AS FLOAT32 = 0.0
    PUBLIC STATIC MIN_POSITIVE_FLOAT32 AS FLOAT32 = 0.0
    PUBLIC STATIC MAX_FLOAT AS FLOAT = 0.0
    PUBLIC STATIC MIN_FLOAT AS FLOAT = 0.0
    PUBLIC STATIC MAX_FLOAT64 AS FLOAT = 0.0
    PUBLIC STATIC MIN_FLOAT64 AS FLOAT = 0.0
    PUBLIC STATIC MIN_POSITIVE_FLOAT AS FLOAT = 0.0
    PUBLIC STATIC MIN_POSITIVE_FLOAT64 AS FLOAT = 0.0
END CLASS
