// IS POINTER TO INTEGER on a POINTER TO VOID that holds one INTEGER.
// The test reads the allocation (K55): true exactly when the conversion
// back to POINTER TO INTEGER would succeed.

FUNCTION Start() AS VOID
    LET typed AS POINTER TO INTEGER = NEW INTEGER
    LET opaque AS POINTER TO VOID = typed
    PRINT opaque IS POINTER TO INTEGER
    RELEASE opaque
END FUNCTION
