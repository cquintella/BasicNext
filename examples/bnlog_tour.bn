// file, You can obtain one at http://mozilla.org/MPL/2.0/.

IMPORT BNLog AS Log
IMPORT HOST.Console AS CON
IMPORT HOST.FileSystem AS FS

FUNCTION Fail(step AS STRING, err AS Error) AS VOID
    PRINT "FAIL  ", step, " code=", err.Code, " message=", err.Message
END FUNCTION

FUNCTION Start() AS VOID
    LET path AS STRING = "/tmp/basicnext-bnlog-tour.jsonl"

    PRINT "=== BNLog tour: JSON to the console ==="
    LET app AS Log.Logger OR Error = Log.Logger.New("tour", "JSON", "CONSOLE")
    IF app IS Error THEN
        Fail("New console", app)
        RETURN
    END IF
    // Every record of this logger names its service unless it sets one.
    LET defaults AS Log.Event
    defaults.service = "bnlog-tour"
    LET kept AS VOID OR Error = app.SetDefaults(defaults)
    IF kept IS Error THEN
        Fail("SetDefaults", kept)
        RETURN
    END IF
    LET event AS Log.Event
    event.user = "ana"
    event.code = 200
    LET wrote AS VOID OR Error = app.Info("hello-console", event)
    IF wrote IS Error THEN
        Fail("Info", wrote)
        RETURN
    END IF
    // DEBUG is below the default minimum (INFO): not written.
    LET hidden AS VOID OR Error = app.Debug("not written", event)
    PRINT "PASS  console Info, Debug filtered: ", hidden IS Error

    PRINT "=== BNLog tour: an Apache access log ==="
    LET web AS Log.Logger OR Error = Log.Logger.New("web", "APACHE", "CONSOLE")
    IF web IS Error THEN
        Fail("New apache", web)
        RETURN
    END IF
    LET request AS Log.Apache
    request.remote = "127.0.0.1"
    request.method = "GET"
    request.path = "/tour"
    request.protocol = "HTTP/1.1"
    request.status = 200
    request.bytes = 12
    LET line AS VOID OR Error = web.Access(request)
    IF line IS Error THEN
        Fail("Access", line)
        RETURN
    END IF
    PRINT "PASS  access line"

    PRINT "=== BNLog tour: JSON to a file ==="
    LET file AS Log.Logger OR Error = Log.Logger.New("tour", "JSON", path)
    IF file IS Error THEN
        Fail("New file", file)
        RETURN
    END IF
    LET wroteFile AS VOID OR Error = file.Warn("hello-file", event)
    LET flushed AS VOID OR Error = file.Flush(1000)
    LET closed AS VOID OR Error = file.Close(1000)
    IF wroteFile IS Error OR flushed IS Error OR closed IS Error THEN
        PRINT "FAIL  file record"
        RETURN
    END IF
    PRINT "PASS  file Warn, Flush, Close  path=", path

    PRINT "=== BNLog tour: read back JSON line ==="
    LET inn AS FS.File OR Error = FS.Open(path, FS.READ)
    IF inn IS Error THEN
        Fail("Open log file", inn)
        RETURN
    END IF
    LET first AS STRING OR EOF OR Error = inn.ReadLine()
    IF first IS Error THEN
        Fail("ReadLine log", first)
    ELSE IF first IS EOF THEN
        PRINT "FAIL  expected at least one JSON line"
    ELSE
        PRINT "PASS  log line  ", first
    END IF
    inn.Close()
    RELEASE inn
    LET done AS VOID OR Error = app.Close(1000)
    PRINT "PASS  BNLog tour complete"
END FUNCTION
