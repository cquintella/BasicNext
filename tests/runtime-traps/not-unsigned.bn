// Runtime trap: NOT of an unsigned value. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET u AS UINT32 = 5
    PRINT NOT u
    RETURN 0
END FUNCTION
