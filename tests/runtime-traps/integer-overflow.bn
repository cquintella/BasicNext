// INTEGER is INT32. One past the maximum stops with NUMERIC_OVERFLOW on both
// backends (0.6.md, integer range).

FUNCTION Start() AS VOID
    LET n AS INTEGER = 2147483647
    PRINT n + 1
END FUNCTION
