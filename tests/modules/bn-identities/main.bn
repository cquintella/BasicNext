IMPORT HOST.Net AS Net
IMPORT BNLog AS Log
IMPORT BNWeb AS Web
IMPORT BNJson AS Json
IMPORT BNDispatch AS Dispatch

FUNCTION Start() AS VOID
    LET queue AS Dispatch.Queue OR Error = Dispatch.Queue.Serial()
    LET logger AS Log.Logger OR Error = Log.Logger.New("test", "JSON", "NULL")
    IF logger IS Error THEN
        RETURN
    END IF
    LET event AS Log.Event
    logger.Info("ok", event)
    logger.Close(100)
END FUNCTION
