// HOST.Args[1] names a file holding "a<NUL>b" and a newline.
// bni prints "all 4"; a native build stops in ReadAll.
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    LET f AS FS.File OR Error = FS.Open(HOST.Args[1], FS.READ)
    IF f IS FS.File THEN
        LET all AS STRING OR Error = f.ReadAll()
        IF all IS STRING THEN
            PRINT "all", LEN(all)
        END IF
        f.Close()
    END IF
END FUNCTION
