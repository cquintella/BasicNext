IMPORT HOST.Clock AS Clock

FUNCTION Start() AS VOID
    LET t1 AS TIMESTAMP = Clock.Now()
    LET m1 AS INT64 = Clock.Timer()
    LET m2 AS INT64 = Clock.Timer()
    PRINT t1 >= (0 AS INT64)
    PRINT m1 >= (0 AS INT64)
    PRINT m2 >= m1
END FUNCTION
