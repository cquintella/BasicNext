{
  "Function": {
    "prefix": "FUNCTION",
    "body": [
      "FUNCTION ${1:Name}(${2}) AS ${3:VOID}",
      "\t$0",
      "END FUNCTION"
    ],
    "description": "FUNCTION \u2026 END FUNCTION"
  },
  "While": {
    "prefix": "WHILE",
    "body": [
      "WHILE ${1:condition}",
      "\t$0",
      "END WHILE"
    ],
    "description": "WHILE \u2026 END WHILE"
  },
  "If": {
    "prefix": "IF",
    "body": [
      "IF ${1:condition} THEN",
      "\t$0",
      "END IF"
    ],
    "description": "IF \u2026 END IF"
  },
  "For": {
    "prefix": "FOR",
    "body": [
      "FOR ${1:i} = ${2:0} TO ${3:n}",
      "\t$0",
      "END FOR"
    ],
    "description": "FOR \u2026 END FOR"
  },
  "Repeat": {
    "prefix": "REPEAT",
    "body": [
      "REPEAT",
      "\t$0",
      "UNTIL ${1:condition}"
    ],
    "description": "REPEAT \u2026 UNTIL"
  },
  "Class": {
    "prefix": "CLASS",
    "body": [
      "CLASS ${1:Name}",
      "\t$0",
      "END CLASS"
    ],
    "description": "CLASS \u2026 END CLASS"
  },
  "Import Host Console": {
    "prefix": "IMPORT HOST.Console",
    "body": [
      "IMPORT HOST.Console AS ${1:CON}"
    ],
    "description": "IMPORT HOST.Console AS \u2026"
  },
  "Import Host File": {
    "prefix": "IMPORT HOST.File",
    "body": [
      "IMPORT HOST.File AS ${1:FS}"
    ],
    "description": "IMPORT HOST.File AS \u2026"
  },
  "Import Host Net": {
    "prefix": "IMPORT HOST.Net",
    "body": [
      "IMPORT HOST.Net AS ${1:NET}"
    ],
    "description": "IMPORT HOST.Net AS \u2026"
  },
  "Import Host Clock": {
    "prefix": "IMPORT HOST.Clock",
    "body": [
      "IMPORT HOST.Clock AS ${1:CLK}"
    ],
    "description": "IMPORT HOST.Clock AS \u2026"
  }
}
