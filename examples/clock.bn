IMPORT HOST.Clock AS Clock
IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    LET now AS TIMESTAMP = Clock.Now()
    LET today AS DATE = Math.TODATE(now)
    LET clock AS TIME = Math.TOTIME(now)
    PRINT "Data: ", today
    PRINT "Hora: ", clock
END FUNCTION
