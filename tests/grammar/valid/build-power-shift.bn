FUNCTION Start() AS VOID
    PRINT 2 ** 3
    PRINT 1 SHL 3
    PRINT 16 SHR 2
    PRINT NOT 0
    PRINT "ab" + "cd"
    PRINT 2.0 ** -1.0
END FUNCTION
