FUNCTION Maybe(present AS BOOLEAN) AS INTEGER OR NULL
    IF present THEN
        RETURN 4
    END IF
    RETURN NULL
END FUNCTION

FUNCTION Start() AS VOID
    LET missing AS INTEGER OR NULL = Maybe(FALSE)
    LET present AS INTEGER OR NULL = Maybe(TRUE)
    PRINT missing IS NULL
    PRINT missing IS INTEGER
    PRINT present IS NULL
    PRINT present IS INTEGER
END FUNCTION
