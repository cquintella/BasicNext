CLASS Box
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION Keep(value AS POINTER TO Box) AS POINTER TO Box
    RETURN value
END FUNCTION

FUNCTION Start() AS VOID
    LET value AS POINTER TO Box OR NULL = NULL
    IF value IS POINTER TO Box THEN
        DELETE value
    END IF
END FUNCTION
