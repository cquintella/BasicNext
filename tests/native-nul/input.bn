// INPUT of the line "a<NUL>b": bni prints 3; a native build stops.
FUNCTION Start() AS VOID
    LET s AS STRING OR EOF = INPUT()
    IF s IS STRING THEN
        PRINT LEN(s)
    END IF
END FUNCTION
