FUNCTION Start() AS VOID
    PRINT Date.Parse("2026-01-02")
    PRINT Time.Parse("03:04:05.000")
    PRINT Timestamp.Parse("2026-01-02T03:04:05Z")
    PRINT Timestamp.Format(1767323045000)
    PRINT Timestamp.Format(Timestamp.Parse("2026-01-02T03:04:05.000Z"))
END FUNCTION
