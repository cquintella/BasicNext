FUNCTION Start() AS INTEGER
    PRINT LEN(HOST.Args) - 1
    FOR i AS INTEGER = 1 TO LEN(HOST.Args) - 1
        PRINT HOST.Args[i]
    END FOR
    RETURN 0
END FUNCTION
