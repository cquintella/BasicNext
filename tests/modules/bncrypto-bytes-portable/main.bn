// The BNCrypto.Bytes subset both backends support: construct from text, read
// the length, render hex, and RELEASE. FromHex is interpret-only for now and
// is exercised by tests/modules/bncrypto-bytes.

IMPORT BNCrypto AS Crypto

FUNCTION Start() AS VOID
    LET raw AS Crypto.Bytes = Crypto.FromText("abc")
    PRINT raw.Length()
    PRINT raw.ToHex()
    RELEASE raw
END FUNCTION
