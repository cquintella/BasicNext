// Lexical 0.2: identifiers are case-sensitive.
/* Block comments do not nest. */

FUNCTION Start() AS VOID
    LET message AS STRING = "Basic Next" // This is also a comment.
    LET counter AS INTEGER = 1

    PRINT message, counter
END FUNCTION
