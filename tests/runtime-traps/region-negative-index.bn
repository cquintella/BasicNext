// Runtime trap: negative region index. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
FUNCTION Start() AS INTEGER
    LET region AS POINTER TO INTEGER[] = NEW INTEGER[2]
    LET at AS INTEGER = -1
    region[at] = 5
    RETURN 0
END FUNCTION
