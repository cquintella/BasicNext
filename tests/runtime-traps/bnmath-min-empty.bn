// Runtime trap: BNMath.MIN of an empty vector. bni and the native binary print the same
// diagnostic and exit with status 1 (bucket 0.6.2b R6).
IMPORT BNMath AS Math
FUNCTION Start() AS INTEGER
    LET size AS INTEGER = 0
    LET values AS POINTER TO INTEGER[] = NEW INTEGER[size]
    PRINT Math.MIN(values)
    RETURN 0
END FUNCTION
