IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    LET timestamp AS TIMESTAMP = 0
    LET date AS DATE = Math.TODATE(timestamp)
    LET time AS TIME = Math.TOTIME(timestamp)
    LET roundTrip AS TIMESTAMP = Math.TOTIMESTAMP(date, time)
END FUNCTION
