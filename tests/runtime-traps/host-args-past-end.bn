// Runtime trap: HOST.Args read at LEN(HOST.Args) (known issue K70: the
// native binary read argv[argc], a null pointer, and crashed).
FUNCTION Start() AS INTEGER
    LET at AS INTEGER = LEN(HOST.Args)
    PRINT HOST.Args[at]
    RETURN 0
END FUNCTION
