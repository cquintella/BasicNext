// STOP outside Start still reports INVALID_EXIT_CODE at FUNCTION Start.
// The value is an INT64 so a narrowing to the process status cannot hide it.

FUNCTION Helper() AS VOID
    LET code AS INT64 = 256
    STOP code
END FUNCTION

FUNCTION Start() AS INTEGER
    Helper()
    RETURN 0
END FUNCTION
