// The body of a FOR EACH is a block: a binding declared inside is not
// visible after END FOR (0.6.md, "Scopes and bindings"): NAME_NOT_FOUND.
FUNCTION Start() AS VOID
    FOR EACH c AS STRING IN "ab"
        LET y AS STRING = c
        PRINT y
    END FOR
    PRINT y
END FUNCTION
