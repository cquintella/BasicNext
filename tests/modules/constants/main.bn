IMPORT Limits AS L

FUNCTION Start() AS VOID
    PRINT L.MinI, " ", TYPEOF(L.MinI)
    PRINT L.Hex, " ", TYPEOF(L.Hex)
    PRINT L.Low, " ", TYPEOF(L.Low)
    PRINT L.Big, " ", TYPEOF(L.Big)
    PRINT L.Max, " ", TYPEOF(L.Max)
    PRINT L.Mask, " ", TYPEOF(L.Mask)
    PRINT L.Neg, " ", TYPEOF(L.Neg)
    PRINT L.PI, " ", L.TAU
END FUNCTION
