CLASS Animal
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
    PUBLIC FUNCTION Speak() AS STRING
        RETURN "..."
    END FUNCTION
END CLASS

CLASS Dog EXTENDS Animal
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION
    PUBLIC FUNCTION Speak() AS STRING
        RETURN "woof"
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET d AS Dog = NEW Dog()
    PRINT d.Speak()
END FUNCTION
