// A capability import BNLog writes through is used with no member access:
// a file destination needs HOST.FileSystem and "CONSOLE" needs HOST.Console.
IMPORT BNLog AS Log
IMPORT HOST.FileSystem AS FS
IMPORT HOST.Console AS Console

FUNCTION Start() AS INTEGER
    LET file AS Log.Logger OR Error = Log.Logger.New("app", "JSON", "app.jsonl")
    LET console AS Log.Logger OR Error = Log.Logger.New("app", "JSON", "CONSOLE")
    IF file IS Error OR console IS Error THEN
        RETURN 1
    END IF
    file.Close(1000)
    console.Close(1000)
    RETURN 0
END FUNCTION
