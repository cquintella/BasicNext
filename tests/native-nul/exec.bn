// A child that writes "a<NUL>b" (Unix): bni prints "stdout 3"; a native
// build stops in Exec.Run.
IMPORT HOST.Exec AS Exec

FUNCTION Start() AS VOID
    LET args AS STRING[2] = ["-c", "printf 'a\\000b'"]
    LET r AS Exec.Result OR Error = Exec.Run("/bin/sh", args)
    IF r IS Exec.Result THEN
        PRINT "stdout", LEN(r.Stdout)
    END IF
END FUNCTION
