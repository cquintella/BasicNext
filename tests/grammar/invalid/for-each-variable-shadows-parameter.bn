// Parameters count as declared at the top of the body, so a FOR EACH
// variable with a parameter's name is DUPLICATE_NAME (0.6.md, "Scopes and
// bindings").
FUNCTION Spell(c AS STRING) AS VOID
    FOR EACH c AS STRING IN "ab"
        PRINT c
    END FOR
END FUNCTION

FUNCTION Start() AS VOID
    Spell("x")
END FUNCTION
