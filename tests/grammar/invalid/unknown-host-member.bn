// NAME_NOT_FOUND names the member and where it was looked up (it printed
// "Name 'type 'HOST.Console' has no member 'CLS'' was not found").
IMPORT HOST.Console AS Console

FUNCTION Start() AS INTEGER
    Console.CLS()
    RETURN 0
END FUNCTION
