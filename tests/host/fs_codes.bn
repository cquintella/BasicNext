// The portable HOST.FileSystem error codes (language/0.6/host.md, "File
// system errors").
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    PRINT FS.INVALID_ARGUMENT, FS.NOT_FOUND, FS.PERMISSION_DENIED, FS.IS_DIRECTORY, FS.CLOSED
    PRINT FS.WRONG_FAMILY, FS.INVALID_UTF8, FS.IO_FAILED, FS.POLICY_DENIED
END FUNCTION
