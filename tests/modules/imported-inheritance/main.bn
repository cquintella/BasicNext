IMPORT Pets AS Pets

CLASS Dog EXTENDS Pets.Animal
    PUBLIC FUNCTION CONSTRUCTOR()
        SUPER()
    END FUNCTION

    PUBLIC FUNCTION Speak() AS STRING
        RETURN SUPER.Speak() + " dog"
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET pet AS Pets.Animal = NEW Dog()
    PRINT pet.name, pet.Speak()
END FUNCTION
