// HOST.Clock is used only through IMPORT HOST.Clock (0.6.md, "Which
// capabilities need IMPORT"): NAME_NOT_FOUND names the missing IMPORT.

FUNCTION Start() AS VOID
    PRINT HOST.Clock.Now() > 0
END FUNCTION
