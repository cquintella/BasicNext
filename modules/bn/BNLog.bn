// BNLog external-module interface (language/0.6/bnlog.md, "API (0.6.5)").
// The members are supplied by the runtime; the bodies below only satisfy
// their declared types and never run.

// Error codes (language/0.6/bnlog.md "Errors").
EXPORT CONST INVALID_ARGUMENT AS INTEGER = 1
EXPORT CONST DUPLICATE AS INTEGER = 2
EXPORT CONST LIMIT AS INTEGER = 3
EXPORT CONST CLOSED AS INTEGER = 4
EXPORT CONST IO_FAILED AS INTEGER = 5
EXPORT CONST CAPABILITY_REQUIRED AS INTEGER = 6
EXPORT CONST TIMEOUT AS INTEGER = 7
EXPORT CONST UNAVAILABLE AS INTEGER = 8

EXPORT CLASS Level
    PUBLIC STATIC ERROR AS INTEGER = 0
    PUBLIC STATIC WARN AS INTEGER = 1
    PUBLIC STATIC INFO AS INTEGER = 2
    PUBLIC STATIC HTTP AS INTEGER = 3
    PUBLIC STATIC VERBOSE AS INTEGER = 4
    PUBLIC STATIC DEBUG AS INTEGER = 5
    PUBLIC STATIC SILLY AS INTEGER = 6
END CLASS

// The fields of an application record; a field left at "" or 0 takes the
// logger's default (SetDefaults) or is absent.
EXPORT STRUCT Event
    service AS STRING
    request_id AS STRING
    route AS STRING
    user AS STRING
    detail AS STRING
    code AS INTEGER
END STRUCT

// The fields of an access record (Apache Combined Log Format).
EXPORT STRUCT Apache
    remote AS STRING
    method AS STRING
    path AS STRING
    protocol AS STRING
    status AS INTEGER
    bytes AS INTEGER
    referrer AS STRING
    agent AS STRING
END STRUCT

EXPORT CLASS Logger
    PUBLIC STATIC FUNCTION New(label AS STRING, format AS STRING, destination AS STRING) AS Logger OR Error
        RETURN NEW Logger()
    END FUNCTION
    PUBLIC FUNCTION Error(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Warn(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Info(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Http(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Verbose(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Debug(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Silly(message AS STRING, event AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Access(request AS Apache) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION SetLevel(minimum AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION SetDefaults(defaults AS Event) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION SetAccessDefaults(defaults AS Apache) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Flush(timeoutMs AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
    PUBLIC FUNCTION Close(timeoutMs AS INTEGER) AS VOID OR Error
        RETURN
    END FUNCTION
END CLASS
