IMPORT BNCompress AS Compress
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    // 1. Bytes creation & conversions
    LET raw AS Compress.Bytes = Compress.FromText("Hello, Basic Next Compression!")
    PRINT "Length: " + (raw.Length() AS STRING)
    LET hex AS STRING = raw.ToHex()
    PRINT "Hex: " + hex
    LET textRes AS STRING OR Error = raw.ToText()
    IF textRes IS STRING THEN
        PRINT "ToText: " + textRes
    END IF

    // 2. Deflate & Inflate
    LET defRes AS Compress.Bytes OR Error = Compress.Deflate(raw)
    IF defRes IS Compress.Bytes THEN
        PRINT "Deflated length: " + (defRes.Length() AS STRING)
        LET infRes AS Compress.Bytes OR Error = Compress.Inflate(defRes)
        IF infRes IS Compress.Bytes THEN
            LET infText AS STRING OR Error = infRes.ToText()
            IF infText IS STRING THEN
                PRINT "Inflated: " + infText
            END IF
        END IF
    END IF

    // 3. Gzip & Gunzip
    LET gzRes AS Compress.Bytes OR Error = Compress.Gzip(raw)
    IF gzRes IS Compress.Bytes THEN
        PRINT "Gzip length: " + (gzRes.Length() AS STRING)
        LET gunzRes AS Compress.Bytes OR Error = Compress.Gunzip(gzRes)
        IF gunzRes IS Compress.Bytes THEN
            LET gunzText AS STRING OR Error = gunzRes.ToText()
            IF gunzText IS STRING THEN
                PRINT "Gunzipped: " + gunzText
            END IF
        END IF
    END IF

    // 4. Convenience string functions
    LET dtRes AS Compress.Bytes OR Error = Compress.DeflateText("Fast convenience string compression")
    IF dtRes IS Compress.Bytes THEN
        LET itRes AS STRING OR Error = Compress.InflateText(dtRes)
        IF itRes IS STRING THEN
            PRINT "DeflateText roundtrip: " + itRes
        END IF
    END IF

    LET gtRes AS Compress.Bytes OR Error = Compress.GzipText("Fast gzip string convenience")
    IF gtRes IS Compress.Bytes THEN
        LET gztRes AS STRING OR Error = Compress.GunzipText(gtRes)
        IF gztRes IS STRING THEN
            PRINT "GzipText roundtrip: " + gztRes
        END IF
    END IF

    // 5. ZIP Archive create, write stored + deflated, and read
    LET zipFile AS STRING = "test_bncompress.zip"
    LET archiveRes AS Compress.ZipArchive OR Error = Compress.ZipArchive.Create(zipFile)
    IF archiveRes IS Compress.ZipArchive THEN
        archiveRes.AddStoredText("mimetype", "application/epub+zip")
        archiveRes.AddText("chapter1.txt", "Chapter 1 content inside ZIP archive.")
        LET binData AS Compress.Bytes = Compress.FromText("Binary data content")
        archiveRes.AddBytes("data.bin", binData)
        archiveRes.Close()
        PRINT "Archive created and closed successfully"
    END IF

    LET readZipRes AS Compress.ZipArchive OR Error = Compress.ZipArchive.Open(zipFile)
    IF readZipRes IS Compress.ZipArchive THEN
        LET count AS INTEGER = readZipRes.EntryCount()
        PRINT "Entry count: " + (count AS STRING)
        FOR i AS INTEGER = 0 TO count - 1
            LET nameRes AS STRING OR Error = readZipRes.EntryName(i)
            IF nameRes IS STRING THEN
                PRINT "Entry " + (i AS STRING) + ": " + nameRes
            END IF
        END FOR

        LET mimeRes AS STRING OR Error = readZipRes.ExtractText("mimetype")
        IF mimeRes IS STRING THEN
            PRINT "Extracted mimetype: " + mimeRes
        END IF

        LET ch1Res AS STRING OR Error = readZipRes.ExtractText("chapter1.txt")
        IF ch1Res IS STRING THEN
            PRINT "Extracted chapter1: " + ch1Res
        END IF

        LET binRes AS Compress.Bytes OR Error = readZipRes.ExtractBytes("data.bin")
        IF binRes IS Compress.Bytes THEN
            LET binText AS STRING OR Error = binRes.ToText()
            IF binText IS STRING THEN
                PRINT "Extracted data.bin: " + binText
            END IF
        END IF

        readZipRes.Close()
    END IF

    // Clean up zip
    FS.DeleteFile(zipFile)

    // 6. Error handling verification
    LET badHex AS Compress.Bytes OR Error = Compress.FromHex("not_a_valid_hex")
    IF badHex IS Error THEN
        PRINT "Bad hex properly rejected as Error"
    END IF

    LET badZip AS Compress.ZipArchive OR Error = Compress.ZipArchive.Open("non_existent_archive_12345.zip")
    IF badZip IS Error THEN
        PRINT "Nonexistent zip properly rejected as Error"
    END IF

    PRINT "BNCompress tests completed"
END FUNCTION
