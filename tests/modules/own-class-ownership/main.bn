IMPORT shapes AS S

FUNCTION Start() AS VOID
    S.Juggle()
    LET b AS S.Box = NEW S.Box("x")
    LET c AS S.Box = b.Copy()
    PRINT c.label, b.label
    PRINT S.Describe(S.Find("y"))
    PRINT S.Describe(S.Find(""))
    PRINT S.Pair()
    PRINT "end"
END FUNCTION
