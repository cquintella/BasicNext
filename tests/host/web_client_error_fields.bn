// A BNWeb.Client failure carries all four Error fields on both backends.
IMPORT BNWeb AS Web

FUNCTION Start() AS VOID
    LET client AS Web.Client = NEW Web.Client()
    // Only 10.0.0.0/8 is allowed, so the loopback is refused before any
    // connection (a client without a policy connects to any destination).
    LET policy AS Web.EgressPolicy OR Error = Web.EgressPolicy.New("http", "10.0.0.0/8", "9", 0, 1000)
    IF policy IS Error THEN
        PRINT "policy error", policy.Code
        RETURN
    END IF
    LET response AS Web.Response OR Error = client.RequestWithPolicy("GET", "http://127.0.0.1:9/", "", policy)
    IF response IS Error THEN
        PRINT "code", response.Code = Web.EGRESS_DENIED
        PRINT "operation", response.Operation
        PRINT "message", response.Message
        PRINT "cause", response.Cause
    ELSE
        PRINT "unexpected success"
    END IF
END FUNCTION
