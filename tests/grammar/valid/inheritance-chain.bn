CLASS Animal
    PUBLIC species AS STRING = "animal"
END CLASS

CLASS Mammal EXTENDS Animal
END CLASS

CLASS Dog EXTENDS Mammal
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET animal AS Animal = NEW Dog()
    PRINT animal.species
END FUNCTION
