IMPORT HOST.Random AS R

FUNCTION Start() AS VOID
    R.Seed(42)
    LET first AS FLOAT = R.Random()
    LET second AS FLOAT = R.Random()
    R.Seed(42)
    PRINT R.Random() = first, R.Random() = second, first >= 0.0, first < 1.0
END FUNCTION
