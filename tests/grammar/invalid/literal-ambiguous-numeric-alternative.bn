// Neither INT32 nor a single integer alternative: the literal's width is
// ambiguous, so the store is a TYPE_MISMATCH (write `1 AS INT16`).
FUNCTION Start() AS VOID
    LET e AS INT8 OR INT16 = 1
END FUNCTION
