// F11 tickets Close per element + RELEASE aggregate — no lifetime-kill
IMPORT BNDispatch AS Dispatch

ASYNC FUNCTION Worker(n AS INTEGER) AS INTEGER OR Error
    RETURN n
END FUNCTION

FUNCTION Start() AS VOID OR Error
    LET queue AS Dispatch.Queue OR Error = Dispatch.Queue.Concurrent(2)
    IF queue IS Error THEN
        RETURN queue
    END IF
    LET tickets AS Dispatch.Ticket[2]
    LET i AS INTEGER = 0
    WHILE i < 2
        LET t AS Dispatch.Ticket OR Error = ASYNC queue Worker(i)
        IF t IS Error THEN
            RETURN t
        END IF
        tickets[i] = t
        i = i + 1
    END WHILE
    i = 0
    WHILE i < 2
        LET r AS INTEGER OR Error = AWAIT tickets[i](60000)
        IF r IS Error THEN
            RETURN r
        END IF
        i = i + 1
    END WHILE
    i = 0
    WHILE i < 2
        tickets[i].Close()
        i = i + 1
    END WHILE
    RELEASE tickets
    PRINT "PASS F11 tickets Close+RELEASE"
END FUNCTION
