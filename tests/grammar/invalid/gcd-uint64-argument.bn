// A UINT64 value may not fit INT64, so BNMath.Gcd does not take it
// (math.md, "Integer divisors"): TYPE_MISMATCH; write AS INT64.
IMPORT BNMath AS Math

FUNCTION Start() AS VOID
    LET count AS UINT64 = 12
    PRINT Math.Gcd(count, 18)
END FUNCTION
