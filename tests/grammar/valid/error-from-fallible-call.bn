// An Error is received from a fallible call, never constructed; once
// narrowed it flows through LET, parameters, and returns (error.md,
// "No default value").
FUNCTION Describe(e AS Error) AS STRING
    RETURN "code " + (e.Code AS STRING) + ": " + e.Message
END FUNCTION

FUNCTION Pass(e AS Error) AS Error
    RETURN e
END FUNCTION

FUNCTION Start() AS VOID
    LET found AS INTEGER OR Error = ASC("")
    IF found IS Error THEN
        LET e AS Error = found
        PRINT Describe(e)
        LET again AS Error = Pass(e)
        PRINT again.Code = e.Code
    END IF
END FUNCTION
