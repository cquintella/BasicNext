// RELEASE takes a local binding or a parameter, as Swift `consume`
// (0.6.md, "`RELEASE`"); a field lets go by assigning NULL.
CLASS Item
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

CLASS Holder
    PUBLIC slot AS Item OR NULL = NULL
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET h AS Holder = NEW Holder()
    h.slot = NEW Item()
    RELEASE h.slot
END FUNCTION
