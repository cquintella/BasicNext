IMPORT BNData AS Data

FUNCTION Start() AS VOID
    LET frame AS Data.DataFrame = NEW Data.DataFrame()
    LET names AS STRING[2] = ["A", "B"]
    LET ages AS INTEGER[2] = [1, 2]
    frame.AddStringColumn("Name", names)
    frame.AddIntegerColumn("Age", ages)
    PRINT frame.RowCount(), frame.ColumnCount(), frame.ColumnName(1)
    DELETE frame
END FUNCTION
