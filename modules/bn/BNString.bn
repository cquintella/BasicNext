// BNString — official extras module (Carlos 2026-09-12 via Quorra).
// Java-like CLASS String over the STRING primary + CLASS Tokenizer on that API.
// Implementation: LEN + character index + loops only (no native bn_rt binding).
// Primary STRING (LEN/index) stays intact; this module does not replace it.
//
 // Fail-closed: empty Tokenizer sep and CharAt OOB return NULL (user code cannot
// NEW Error in 0.4.7). Prefer OR Error when Error is constructible.
// LowCaps/HiCaps: Unicode case via language builtins TOLOWER/TOUPPER
// (bn_rt_str_to_lower / bn_rt_str_to_upper — Rust Unicode mapping, not ASCII).
//
// Access:
//   IMPORT BNString AS S
//   LET s AS S.String = NEW S.String("hi")
//
// Precompiled module objects (.bno / compile cache): not in toolchain yet —
// intent for 0.5.x; ship source `.bn` now (see modules/README.md).

FUNCTION IsAsciiSpace(ch AS STRING) AS BOOLEAN
    LET code AS INTEGER OR Error = ASC(ch)
    IF code IS Error THEN
        RETURN FALSE
    END IF
    IF code = 32 OR code = 9 OR code = 10 OR code = 13 THEN
        RETURN TRUE
    END IF
    RETURN FALSE
END FUNCTION

EXPORT CLASS Tokenizer
    PRIVATE text AS STRING = ""
    PRIVATE sep AS STRING = ""
    PRIVATE pos AS INTEGER = 0
    PRIVATE done AS BOOLEAN = FALSE

    PUBLIC FUNCTION CONSTRUCTOR(text AS STRING, sep AS STRING)
        SELF.text = text
        SELF.sep = sep
        SELF.pos = 0
        SELF.done = FALSE
    END FUNCTION

    // Empty sep → NULL (fail-closed). Prefer OR Error when constructible.
    PUBLIC STATIC FUNCTION New(text AS STRING, sep AS STRING) AS Tokenizer OR NULL
        IF LEN(sep) = 0 THEN
            RETURN NULL
        END IF
        RETURN NEW Tokenizer(text, sep)
    END FUNCTION

    PUBLIC FUNCTION Reset() AS VOID
        SELF.pos = 0
        SELF.done = FALSE
    END FUNCTION

    PUBLIC FUNCTION Next() AS STRING OR EOF
        IF SELF.done THEN
            RETURN EOF
        END IF
        LET n AS INTEGER = LEN(SELF.text)
        LET sepLen AS INTEGER = LEN(SELF.sep)
        IF SELF.pos > n THEN
            SELF.done = TRUE
            RETURN EOF
        END IF
        // Empty remainder after a trailing separator → one empty field, then EOF.
        IF SELF.pos = n THEN
            SELF.done = TRUE
            RETURN ""
        END IF
        LET i AS INTEGER = SELF.pos
        WHILE i <= n - sepLen
            LET matched AS BOOLEAN = TRUE
            LET k AS INTEGER = 0
            WHILE k < sepLen
                IF SELF.text[i + k] <> SELF.sep[k] THEN
                    matched = FALSE
                    EXIT WHILE
                END IF
                k = k + 1
            END WHILE
            IF matched THEN
                LET part AS STRING = ""
                LET j AS INTEGER = SELF.pos
                WHILE j < i
                    part = part + SELF.text[j]
                    j = j + 1
                END WHILE
                SELF.pos = i + sepLen
                RETURN part
            END IF
            i = i + 1
        END WHILE
        // No more separator: rest of string.
        LET rest AS STRING = ""
        LET j2 AS INTEGER = SELF.pos
        WHILE j2 < n
            rest = rest + SELF.text[j2]
            j2 = j2 + 1
        END WHILE
        SELF.done = TRUE
        RETURN rest
    END FUNCTION
END CLASS

EXPORT CLASS String
    PRIVATE value AS STRING = ""

    PUBLIC FUNCTION CONSTRUCTOR(s AS STRING)
        SELF.value = s
    END FUNCTION

    PUBLIC FUNCTION Len() AS INTEGER
        RETURN LEN(SELF.value)
    END FUNCTION

    // Synonym of Len() (Carlos 2026-09-12).
    PUBLIC FUNCTION Length() AS INTEGER
        RETURN SELF.Len()
    END FUNCTION

    // Unicode lowercase (TOLOWER → bn_rt / Rust to_lowercase). Length may change.
    PUBLIC FUNCTION LowCaps() AS String
        RETURN NEW String(TOLOWER(SELF.value))
    END FUNCTION


    // Unicode uppercase (TOUPPER → bn_rt / Rust to_uppercase). Length may change.
    PUBLIC FUNCTION HiCaps() AS String
        RETURN NEW String(TOUPPER(SELF.value))
    END FUNCTION


    // One Unicode scalar at i as STRING length 1; NULL if out of range.
    PUBLIC FUNCTION CharAt(i AS INTEGER) AS STRING OR NULL
        IF i < 0 OR i >= LEN(SELF.value) THEN
            RETURN NULL
        END IF
        RETURN SELF.value[i]
    END FUNCTION

    PUBLIC FUNCTION Concat(other AS STRING) AS String
        RETURN NEW String(SELF.value + other)
    END FUNCTION

    PUBLIC FUNCTION Contains(needle AS STRING) AS BOOLEAN
        LET idx AS INTEGER OR NA = SELF.IndexOf(needle)
        IF idx IS NA THEN
            RETURN FALSE
        END IF
        RETURN TRUE
    END FUNCTION

    PUBLIC FUNCTION IndexOf(needle AS STRING) AS INTEGER OR NA
        LET n AS INTEGER = LEN(SELF.value)
        LET m AS INTEGER = LEN(needle)
        IF m = 0 THEN
            RETURN 0
        END IF
        IF m > n THEN
            RETURN NA
        END IF
        LET i AS INTEGER = 0
        WHILE i <= n - m
            LET matched AS BOOLEAN = TRUE
            LET k AS INTEGER = 0
            WHILE k < m
                IF SELF.value[i + k] <> needle[k] THEN
                    matched = FALSE
                    EXIT WHILE
                END IF
                k = k + 1
            END WHILE
            IF matched THEN
                RETURN i
            END IF
            i = i + 1
        END WHILE
        RETURN NA
    END FUNCTION

    PUBLIC FUNCTION Trim() AS String
        LET n AS INTEGER = LEN(SELF.value)
        LET start AS INTEGER = 0
        WHILE start < n
            LET ch AS STRING = SELF.value[start]
            IF IsAsciiSpace(ch) THEN
                start = start + 1
            ELSE
                EXIT WHILE
            END IF
        END WHILE
        LET endPos AS INTEGER = n
        WHILE endPos > start
            LET ch2 AS STRING = SELF.value[endPos - 1]
            IF IsAsciiSpace(ch2) THEN
                endPos = endPos - 1
            ELSE
                EXIT WHILE
            END IF
        END WHILE
        LET out AS STRING = ""
        LET j AS INTEGER = start
        WHILE j < endPos
            out = out + SELF.value[j]
            j = j + 1
        END WHILE
        RETURN NEW String(out)
    END FUNCTION

    // Tokenizer belongs to String (Carlos): not a loose external module API.
    PUBLIC FUNCTION Tokenizer(sep AS STRING) AS Tokenizer OR NULL
        RETURN Tokenizer.New(SELF.value, sep)
    END FUNCTION

    PUBLIC FUNCTION ToString() AS STRING
        RETURN SELF.value
    END FUNCTION
END CLASS
