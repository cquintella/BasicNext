// HOST.Env: Get and Has on set variables and absent variables.
IMPORT HOST.Env AS Env

FUNCTION Start() AS VOID
    LET setVar AS STRING OR Error = Env.Get("BN_TEST_ENV")
    IF setVar IS Error THEN
        PRINT "ERROR", setVar.Code
    ELSE
        PRINT setVar
    END IF

    LET emptyVar AS STRING OR Error = Env.Get("BN_TEST_EMPTY")
    IF emptyVar IS Error THEN
        PRINT "ERROR", emptyVar.Code
    ELSE
        PRINT LEN(emptyVar)
    END IF

    PRINT Env.Has("BN_TEST_ENV"), Env.Has("BN_NONEXISTENT_VAR")
END FUNCTION
