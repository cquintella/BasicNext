// IS on an imported alternative member uses the member's own name (K64).
IMPORT BNLog AS Log

FUNCTION Start() AS VOID
    LET made AS Log.Logger OR Error = Log.Logger.New("app", "JSON", "NULL")
    PRINT made IS Log.Logger
    PRINT made IS Error
END FUNCTION
