// An open vector parameter is not copied, so writing its element would
// change the caller's vector; the parameter is constant (0.6.md, "Parameter
// immutability and place mutation", "Open parameter").
FUNCTION Reset(values AS INTEGER[]) AS VOID
    values[0] = 0
END FUNCTION

FUNCTION Start() AS VOID
    LET data AS INTEGER[3] = [1, 2, 3]
    Reset(data)
    PRINT data[0]
END FUNCTION
