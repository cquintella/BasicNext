{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Basic Next",
    "scopeName": "source.bn",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#end-blocks"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#builtins"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.bn",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.bn",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.bn",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.bn",
                    "match": "\\\\[\"\\\\]"
                }
            ]
        },
        "end-blocks": {
            "patterns": [
                {
                    "name": "meta.block.end.function.bn",
                    "match": "\\b(END)\\s+(FUNCTION)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "storage.type.function.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.while.bn",
                    "match": "\\b(END)\\s+(WHILE)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "keyword.control.loop.while.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.if.bn",
                    "match": "\\b(END)\\s+(IF)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "keyword.control.conditional.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.for.bn",
                    "match": "\\b(END)\\s+(FOR)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "keyword.control.loop.for.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.class.bn",
                    "match": "\\b(END)\\s+(CLASS)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "storage.type.class.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.struct.bn",
                    "match": "\\b(END)\\s+(STRUCT)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "storage.type.struct.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.interface.bn",
                    "match": "\\b(END)\\s+(INTERFACE)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "storage.type.interface.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.constructor.bn",
                    "match": "\\b(END)\\s+(CONSTRUCTOR)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "storage.type.constructor.bn"
                        }
                    }
                },
                {
                    "name": "meta.block.end.destructor.bn",
                    "match": "\\b(END)\\s+(DESTRUCTOR)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.end.bn"
                        },
                        "2": {
                            "name": "storage.type.destructor.bn"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "storage.type.function.bn",
                    "match": "\\b(FUNCTION|ASYNC)\\b"
                },
                {
                    "name": "keyword.control.loop.while.bn",
                    "match": "\\b(WHILE)\\b"
                },
                {
                    "name": "keyword.control.loop.for.bn",
                    "match": "\\b(FOR|STEP|EACH)\\b"
                },
                {
                    "name": "keyword.control.loop.repeat.bn",
                    "match": "\\b(REPEAT|UNTIL)\\b"
                },
                {
                    "name": "keyword.control.conditional.bn",
                    "match": "\\b(IF|THEN|ELSE)\\b"
                },
                {
                    "name": "keyword.control.flow.bn",
                    "match": "\\b(EXIT|CONTINUE|RETURN|STOP)\\b"
                },
                {
                    "name": "keyword.control.await.bn",
                    "match": "\\b(AWAIT)\\b"
                },
                {
                    "name": "keyword.control.end.bn",
                    "match": "\\b(END)\\b"
                },
                {
                    "name": "storage.type.class.bn",
                    "match": "\\b(CLASS)\\b"
                },
                {
                    "name": "storage.type.struct.bn",
                    "match": "\\b(STRUCT)\\b"
                },
                {
                    "name": "storage.type.interface.bn",
                    "match": "\\b(INTERFACE)\\b"
                },
                {
                    "name": "storage.type.constructor.bn",
                    "match": "\\b(CONSTRUCTOR)\\b"
                },
                {
                    "name": "storage.type.destructor.bn",
                    "match": "\\b(DESTRUCTOR)\\b"
                },
                {
                    "name": "keyword.declaration.bn",
                    "match": "\\b(LET|CONST|AS|IMPLEMENTS|EXTENDS|IMPORT|EXPORT|PUBLIC|PRIVATE|STATIC|IN|IS|RELEASE|WEAK)\\b"
                },
                {
                    "name": "keyword.operator.new.bn",
                    "match": "\\b(NEW)\\b"
                },
                {
                    "name": "invalid.illegal.deprecated.delete.bn",
                    "match": "\\b(DELETE)\\b"
                },
                {
                    "name": "variable.language.this.bn",
                    "match": "\\b(SELF|SUPER)\\b"
                },
                {
                    "name": "keyword.other.reserved.bn",
                    "match": "\\b(PARALLEL|SYSTEM)\\b"
                }
            ]
        },
        "types": {
            "name": "storage.type.bn",
            "match": "\\b(BYTE|INT8|INT16|INT32|INT64|UINT16|UINT32|UINT64|FLOAT32|FLOAT64|INTEGER|FLOAT|TIMESTAMP|DATE|TIME|TIMEZONE|STRING|BOOLEAN|VOID|POINTER|TO)\\b"
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.bn",
                    "match": "\\b(TRUE|FALSE|NULL|NA|NAN|INF|EOF)\\b"
                },
                {
                    "name": "constant.numeric.hex.bn",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.binary.bn",
                    "match": "\\b0b[01]+\\b"
                },
                {
                    "name": "constant.numeric.decimal.bn",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "name": "keyword.operator.logical.bn",
            "match": "\\b(AND|OR|NOT|XOR|SHL|SHR|DIV)\\b"
        },
        "builtins": {
            "name": "support.function.bn",
            "match": "\\b(PRINT|INPUT|LEN|SIZEOF|HOST)\\b"
        }
    }
}
