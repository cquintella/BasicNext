IMPORT HOST.Clock AS Clock

FUNCTION Start() AS VOID
    LET now AS TIMESTAMP = Clock.Now()
    LET started AS INT64 = Clock.Timer()
    LET later AS INT64 = Clock.Timer()
    PRINT now > 0, later >= started
END FUNCTION
