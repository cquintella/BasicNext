// Author: Carlos Quintella
// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this
// file, You can obtain one at http://mozilla.org/MPL/2.0/.
//
// BN Scramble: an original ASCII cavern shooter for a 32x24 board, in the
// spirit of the ZX81 side-scroller Scramble. Mechanics are taken from
// published descriptions. No listing was copied.
//
// What was found
//   Mikro-Gen, "Scramble", ZX81 16K cassette, £3.95. Advertised in
//   Sinclair User issue 3 (June 1982), page 40, and reviewed in ZX Computing
//   issue 5 (February 1983), page 40, and Personal Computer Games issue 5
//   (April 1984), page 42 ("Cavern Carnage", Peter Connor): rugged terrain,
//   missiles, and a smart bomb, with no sound and no colour.
//     https://zx81stuff.org.uk/zx81/tape/Scramble
//     https://spectrumcomputing.co.uk/entry/31786/ZX81/Scramble
//   The tape is machine code. The BASIC shell (title, key/joystick prompt,
//   speed, score) is transcribed, graphics and all, at
//     https://www.timexsinclair.com/computer_media/zx-scramble/index.html
//   Gameplay lives in the REM payload (RAND USR 18628). That payload was
//   not copied. A plain-text BASIC type-in of the cavern game was not
//   found. Melbourne House / Beam Software, "The Complete Sinclair ZX81
//   Basic Course" (1981), includes a different program also named
//   SCRAMBLE; zx81stuff renders it on a canvas and it was not used:
//     https://zx81stuff.org.uk/zx81/tape/CompleteBasicCourse
//   The same publisher's instruction leaflet (Spectrum release) is the
//   clearest rule sheet for this family of games: four stages, the point
//   table, fuel, and the 2/4/0 keys. This port follows that sheet.
//     https://spectrumcomputing.co.uk/pub/sinclair/games-info/s/Scramble(Mikro-Gen).txt
//   Konami's arcade Scramble (1981) is the design those ports imitate.
//
// Rules used here
//   Constant scroll through missiles, a cavern, meteors, then a fortress.
//   4 ships, bonus ship at 10000. Fuel starts at 100 and burns each frame;
//   an empty tank forces the ship down. Bombing a fuel dump adds 20 fuel
//   and 150 points. Ground rocket 30, airborne rocket 50, UFO 50, UFO base
//   100, fortress base 2500 (and the fuel burn speeds up). Meteors are
//   indestructible. One smart bomb per ship clears rockets, UFOs, and UFO
//   bases in view. Laser and bomb both kill those targets. Only a bomb
//   collects fuel. Touching rock, a rocket, a UFO, a dump, or a base costs
//   a ship.
//
// Controls (one character, one frame; a line is a burst of frames)
//   4 or w   up          2 or s   down
//   0 or f   laser       5 b 6 7 8 9 z x c v n m   bomb
//   3 or t   smart bomb  . or anything else  coast
//   q        quit the line (interactive)
//   Empty line: coast one frame.
//   ZX81/Spectrum keys were 4 up, 2 down, 0 fire, bottom row bomb.
//   Brake/thrust from later Spectrum notes are not separate keys: the
//   cavern scrolls every frame, as in the arcade.
//
// Why input is line-based
//   HOST.Console can Cls, Beep, and PrintAt. PrintAt, NumCols, and NumRows
//   raise HOST_CAPABILITY_UNAVAILABLE when stdout is not a terminal, and a
//   host stop is not an Error the program can catch. There is no INKEY$,
//   no key-available test, and no timed read. INPUT() waits for a whole
//   line. This program redraws with Cls plus PRINT, which works on a pipe,
//   and plays one frame per character. --pace N waits N milliseconds
//   between frames with HOST.Clock Timer so a typed burst is visible.
//
// Run
//   bni run examples/bn_scramble.bn
//   bni run examples/bn_scramble.bn -- --demo
//   bni run examples/bn_scramble.bn -- --demo --frames 32 --pace 40
//   bni run examples/bn_scramble.bn -- --demo --quiet
//   bni check examples/bn_scramble.bn

IMPORT HOST.Console AS Console
IMPORT HOST.Clock AS Clock
IMPORT BNMath AS Math

CONST COLS = 32
CONST ROWS = 20
CONST SHIP_COL = 4
CONST ZONE = 80
CONST KIND_FUEL = 1
CONST KIND_ROCKET = 2
CONST KIND_UFO = 3
CONST KIND_METEOR = 4
CONST KIND_BASE = 5
CONST KIND_SITE = 6
CONST PTS_GROUND = 30
CONST PTS_AIR = 50
CONST PTS_UFO = 50
CONST PTS_SITE = 100
CONST PTS_FUEL = 150
CONST PTS_BASE = 2500
CONST FUEL_PACK = 20
CONST BONUS_AT = 10000
// Ship holds row 10. Frame 1 bombs the grounded rocket on column 11
// (30 points). Frame 9 bombs the fuel dump on column 18 (+20 fuel, 150).
// Frame 16 fires through the rocket that climbs across row 10 (50).
CONST DEMO_SCRIPT = ".5.......5......0..............."

FUNCTION SleepMs(ms AS INTEGER) AS VOID
    IF ms <= 0 THEN
        RETURN
    END IF
    LET start AS INT64 = Clock.Timer()
    LET wait AS INT64 = (ms AS INT64) * 1000000
    WHILE Clock.Timer() - start < wait
    END WHILE
END FUNCTION

FUNCTION Digits(n AS INTEGER, width AS INTEGER) AS STRING
    LET value AS INTEGER = n
    IF value < 0 THEN
        value = 0
    END IF
    LET text AS STRING = value AS STRING
    WHILE LEN(text) < width
        text = "0" + text
    END WHILE
    WHILE LEN(text) > width
        LET cut AS STRING = ""
        FOR i AS INTEGER = 1 TO LEN(text) - 1
            cut = cut + text[i]
        END FOR
        text = cut
    END WHILE
    RETURN text
END FUNCTION

FUNCTION Fit(text AS STRING, width AS INTEGER) AS STRING
    LET out AS STRING = text
    IF LEN(out) > width THEN
        LET cut AS STRING = ""
        FOR i AS INTEGER = 0 TO width - 1
            cut = cut + out[i]
        END FOR
        out = cut
    END IF
    WHILE LEN(out) < width
        out = out + " "
    END WHILE
    RETURN out
END FUNCTION

FUNCTION Usage() AS VOID
    PRINT "BN Scramble, a 32x24 ASCII cavern run."
    PRINT "  bni run examples/bn_scramble.bn"
    PRINT "  bni run examples/bn_scramble.bn -- --demo [--frames N] [--pace MS] [--quiet]"
    PRINT "Keys: 4/w up, 2/s down, 0/f laser, 5/b bomb, 3/t smart, q quit."
END FUNCTION

CLASS Scramble
    PRIVATE ceil AS INTEGER[32]
    PRIVATE floor AS INTEGER[32]
    PRIVATE kind AS INTEGER[32]
    PRIVATE pos AS INTEGER[32]
    PRIVATE dir AS INTEGER[32]
    PRIVATE score AS INTEGER = 0
    PRIVATE ships AS INTEGER = 4
    PRIVATE fuel AS INTEGER = 100
    PRIVATE rate AS INTEGER = 1
    PRIVATE shipY AS INTEGER = 10
    PRIVATE origin AS INTEGER = 0
    PRIVATE safe AS INTEGER = 0
    PRIVATE shot AS BOOLEAN = FALSE
    PRIVATE shotX AS INTEGER = 0
    PRIVATE shotY AS INTEGER = 0
    PRIVATE bomb AS BOOLEAN = FALSE
    PRIVATE bombX AS INTEGER = 0
    PRIVATE bombY AS INTEGER = 0
    PRIVATE smart AS INTEGER = 1
    PRIVATE bonus AS BOOLEAN = FALSE
    PRIVATE over AS BOOLEAN = FALSE
    PRIVATE note AS STRING = ""
    PRIVATE noteLeft AS INTEGER = 0
    PRIVATE frame AS INTEGER = 0
    PRIVATE hit AS BOOLEAN = FALSE

    PUBLIC FUNCTION CONSTRUCTOR()
        FOR x AS INTEGER = 0 TO COLS - 1
            SELF.Fill(x, x)
        END FOR
    END FUNCTION

    PUBLIC FUNCTION Over() AS BOOLEAN
        RETURN SELF.over
    END FUNCTION

    PUBLIC FUNCTION Step(command AS STRING) AS VOID
        IF SELF.over THEN
            RETURN
        END IF
        SELF.hit = FALSE
        IF SELF.noteLeft > 0 THEN
            SELF.noteLeft -= 1
        END IF
        SELF.Burn()
        SELF.Steer(command)
        SELF.MoveShot()
        SELF.MoveBomb()
        SELF.Arm(command)
        SELF.Scroll()
        SELF.Launch()
        SELF.Rise()
        IF SELF.safe > 0 THEN
            SELF.safe -= 1
        ELSE
            SELF.Collide()
        END IF
        SELF.frame += 1
    END FUNCTION

    PUBLIC FUNCTION Draw(clear AS BOOLEAN, gap AS BOOLEAN) AS VOID
        IF clear THEN
            Console.Cls()
        END IF
        PRINT SELF.Status()
        FOR y AS INTEGER = 0 TO ROWS - 1
            PRINT SELF.RowText(y)
        END FOR
        PRINT SELF.FuelLine()
        PRINT SELF.Banner()
        PRINT Fit("4UP 2DN 0FIRE 5BOMB 3SMART Q", COLS)
        IF gap THEN
            PRINT
        END IF
    END FUNCTION

    PUBLIC FUNCTION Report(demo AS BOOLEAN) AS STRING
        LET mode AS STRING = "PLAY"
        IF demo THEN
            mode = "DEMO"
        END IF
        LET status AS STRING = "RUN"
        IF SELF.over THEN
            status = "OVER"
        END IF
        LET line AS STRING = "SCRAMBLE " + mode
        line = line + " frames=" + (SELF.frame AS STRING)
        line = line + " score=" + (SELF.score AS STRING)
        line = line + " ships=" + (SELF.ships AS STRING)
        line = line + " fuel=" + (SELF.fuel AS STRING)
        line = line + " status=" + status + " result=OK"
        RETURN line
    END FUNCTION

    PRIVATE FUNCTION Burn() AS VOID
        IF SELF.fuel > SELF.rate THEN
            SELF.fuel -= SELF.rate
        ELSE
            SELF.fuel = 0
        END IF
    END FUNCTION

    PRIVATE FUNCTION Steer(command AS STRING) AS VOID
        LET key AS STRING = SELF.Key(command)
        IF SELF.fuel = 0 THEN
            IF SELF.shipY < ROWS - 1 THEN
                SELF.shipY += 1
            END IF
            RETURN
        END IF
        IF key = "4" OR key = "w" THEN
            IF SELF.shipY > 0 THEN
                SELF.shipY -= 1
            END IF
        ELSE IF key = "2" OR key = "s" THEN
            IF SELF.shipY < ROWS - 1 THEN
                SELF.shipY += 1
            END IF
        END IF
    END FUNCTION

    PRIVATE FUNCTION Arm(command AS STRING) AS VOID
        LET key AS STRING = SELF.Key(command)
        IF key = "0" OR key = "f" THEN
            IF NOT SELF.shot THEN
                SELF.shot = TRUE
                SELF.shotX = SHIP_COL
                SELF.shotY = SELF.shipY
            END IF
        ELSE IF key = "5" OR key = "b" OR key = "6" OR key = "7" OR key = "8" OR key = "9" THEN
            SELF.ArmBomb()
        ELSE IF key = "z" OR key = "x" OR key = "c" OR key = "v" OR key = "n" OR key = "m" THEN
            SELF.ArmBomb()
        ELSE IF key = "3" OR key = "t" THEN
            SELF.SmartBomb()
        END IF
    END FUNCTION

    PRIVATE FUNCTION ArmBomb() AS VOID
        IF SELF.bomb THEN
            RETURN
        END IF
        SELF.bomb = TRUE
        SELF.bombX = SHIP_COL
        SELF.bombY = SELF.shipY
    END FUNCTION

    PRIVATE FUNCTION Key(command AS STRING) AS STRING
        IF LEN(command) = 0 THEN
            RETURN "."
        END IF
        RETURN TOLOWER(command[0])
    END FUNCTION

    PRIVATE FUNCTION MoveShot() AS VOID
        IF NOT SELF.shot THEN
            RETURN
        END IF
        LET hop AS INTEGER = 0
        WHILE hop < 2 AND SELF.shot
            SELF.shotX += 1
            IF SELF.Strike(SELF.shotX, SELF.shotY, FALSE) THEN
                SELF.shot = FALSE
            END IF
            hop += 1
        END WHILE
    END FUNCTION

    PRIVATE FUNCTION MoveBomb() AS VOID
        IF NOT SELF.bomb THEN
            RETURN
        END IF
        // Straight down the screen. The cavern scrolls left, so a bomb
        // meets a dump that was ahead of the ship when it was released.
        SELF.bombY += 1
        IF SELF.Strike(SELF.bombX, SELF.bombY, TRUE) THEN
            SELF.bomb = FALSE
        END IF
    END FUNCTION

    // TRUE when the projectile stops. A bomb is the only weapon that
    // collects a fuel dump; a laser flies through the dump.
    PRIVATE FUNCTION Strike(x AS INTEGER, y AS INTEGER, bomb AS BOOLEAN) AS BOOLEAN
        IF x < 0 OR y < 0 OR x >= COLS OR y >= ROWS THEN
            RETURN TRUE
        END IF
        IF y < SELF.ceil[x] OR y >= ROWS - SELF.floor[x] THEN
            RETURN TRUE
        END IF
        IF SELF.kind[x] = KIND_METEOR AND y = SELF.pos[x] THEN
            RETURN TRUE
        END IF
        IF SELF.kind[x] = KIND_UFO AND y = SELF.pos[x] THEN
            SELF.Kill(x, PTS_UFO, "UFO 50")
            RETURN TRUE
        END IF
        IF SELF.kind[x] = KIND_ROCKET AND SELF.dir[x] = 1 AND y = SELF.pos[x] THEN
            SELF.Kill(x, PTS_AIR, "AIR ROCKET 50")
            RETURN TRUE
        END IF
        IF y <> SELF.Surface(x) THEN
            RETURN FALSE
        END IF
        IF SELF.kind[x] = KIND_FUEL THEN
            IF bomb THEN
                SELF.kind[x] = 0
                SELF.fuel += FUEL_PACK
                IF SELF.fuel > 100 THEN
                    SELF.fuel = 100
                END IF
                LET awarded AS BOOLEAN = SELF.AddScore(PTS_FUEL)
                IF NOT awarded THEN
                    SELF.Flash("FUEL +20")
                END IF
            END IF
            RETURN bomb
        END IF
        IF SELF.kind[x] = KIND_ROCKET AND SELF.dir[x] = 0 THEN
            SELF.Kill(x, PTS_GROUND, "GROUND ROCKET 30")
            RETURN TRUE
        END IF
        IF SELF.kind[x] = KIND_SITE THEN
            SELF.Kill(x, PTS_SITE, "UFO BASE 100")
            RETURN TRUE
        END IF
        IF SELF.kind[x] = KIND_BASE THEN
            SELF.Kill(x, PTS_BASE, "BASE 2500")
            IF SELF.rate < 4 THEN
                SELF.rate += 1
            END IF
            RETURN TRUE
        END IF
        RETURN FALSE
    END FUNCTION

    PRIVATE FUNCTION Kill(x AS INTEGER, points AS INTEGER, text AS STRING) AS VOID
        SELF.kind[x] = 0
        SELF.dir[x] = 0
        SELF.pos[x] = 0
        LET awarded AS BOOLEAN = SELF.AddScore(points)
        IF NOT awarded THEN
            SELF.Flash(text)
        END IF
    END FUNCTION

    PRIVATE FUNCTION AddScore(points AS INTEGER) AS BOOLEAN
        SELF.score += points
        IF SELF.bonus OR SELF.score < BONUS_AT THEN
            RETURN FALSE
        END IF
        SELF.bonus = TRUE
        IF SELF.ships < 9 THEN
            SELF.ships += 1
        END IF
        IF SELF.smart < 9 THEN
            SELF.smart += 1
        END IF
        SELF.Flash("BONUS SHIP")
        RETURN TRUE
    END FUNCTION

    PRIVATE FUNCTION Flash(text AS STRING) AS VOID
        SELF.note = text
        SELF.noteLeft = 8
    END FUNCTION

    PRIVATE FUNCTION SmartBomb() AS VOID
        IF SELF.smart <= 0 THEN
            SELF.Flash("NO SMART BOMB")
            RETURN
        END IF
        SELF.smart -= 1
        LET gained AS INTEGER = 0
        FOR x AS INTEGER = 0 TO COLS - 1
            IF SELF.kind[x] = KIND_UFO THEN
                gained += PTS_UFO
                SELF.kind[x] = 0
            ELSE IF SELF.kind[x] = KIND_ROCKET THEN
                IF SELF.dir[x] = 1 THEN
                    gained += PTS_AIR
                ELSE
                    gained += PTS_GROUND
                END IF
                SELF.kind[x] = 0
                SELF.dir[x] = 0
            ELSE IF SELF.kind[x] = KIND_SITE THEN
                gained += PTS_SITE
                SELF.kind[x] = 0
            END IF
        END FOR
        LET awarded AS BOOLEAN = SELF.AddScore(gained)
        IF NOT awarded THEN
            SELF.Flash("SMART BOMB")
        END IF
    END FUNCTION

    PRIVATE FUNCTION Scroll() AS VOID
        FOR x AS INTEGER = 0 TO COLS - 2
            SELF.ceil[x] = SELF.ceil[x + 1]
            SELF.floor[x] = SELF.floor[x + 1]
            SELF.kind[x] = SELF.kind[x + 1]
            SELF.pos[x] = SELF.pos[x + 1]
            SELF.dir[x] = SELF.dir[x + 1]
        END FOR
        SELF.Fill(COLS - 1, SELF.origin + COLS)
        SELF.origin += 1
    END FUNCTION

    PRIVATE FUNCTION Launch() AS VOID
        FOR x AS INTEGER = 16 TO 24
            IF SELF.kind[x] = KIND_ROCKET AND SELF.dir[x] = 0 THEN
                SELF.dir[x] = 1
                SELF.pos[x] = SELF.Surface(x)
            END IF
        END FOR
    END FUNCTION

    PRIVATE FUNCTION Rise() AS VOID
        FOR x AS INTEGER = 0 TO COLS - 1
            IF SELF.kind[x] = KIND_ROCKET AND SELF.dir[x] = 1 THEN
                SELF.pos[x] -= 1
                IF SELF.pos[x] <= SELF.ceil[x] THEN
                    SELF.kind[x] = 0
                    SELF.dir[x] = 0
                    SELF.pos[x] = 0
                END IF
            ELSE IF SELF.kind[x] = KIND_UFO THEN
                SELF.pos[x] += SELF.dir[x]
                IF SELF.pos[x] <= SELF.ceil[x] THEN
                    SELF.pos[x] = SELF.ceil[x] + 1
                    SELF.dir[x] = 1
                ELSE IF SELF.pos[x] >= SELF.Surface(x) THEN
                    SELF.pos[x] = SELF.Surface(x) - 1
                    SELF.dir[x] = -1
                END IF
            END IF
        END FOR
    END FUNCTION

    PRIVATE FUNCTION Collide() AS VOID
        LET y AS INTEGER = SELF.shipY
        IF y < SELF.ceil[SHIP_COL] OR y >= ROWS - SELF.floor[SHIP_COL] THEN
            SELF.Crash()
            RETURN
        END IF
        IF SELF.kind[SHIP_COL] = KIND_METEOR AND y = SELF.pos[SHIP_COL] THEN
            SELF.Crash()
            RETURN
        END IF
        IF SELF.kind[SHIP_COL] = KIND_UFO AND y = SELF.pos[SHIP_COL] THEN
            SELF.Crash()
            RETURN
        END IF
        IF SELF.kind[SHIP_COL] = KIND_ROCKET AND SELF.dir[SHIP_COL] = 1 AND y = SELF.pos[SHIP_COL] THEN
            SELF.Crash()
            RETURN
        END IF
        IF y = SELF.Surface(SHIP_COL) THEN
            LET item AS INTEGER = SELF.kind[SHIP_COL]
            IF item = KIND_FUEL OR item = KIND_ROCKET OR item = KIND_SITE OR item = KIND_BASE THEN
                SELF.Crash()
            END IF
        END IF
    END FUNCTION

    PRIVATE FUNCTION Crash() AS VOID
        SELF.hit = TRUE
        SELF.shot = FALSE
        SELF.bomb = FALSE
        SELF.ships -= 1
        IF SELF.ships <= 0 THEN
            SELF.ships = 0
            SELF.over = TRUE
            SELF.Flash("GAME OVER")
            SELF.noteLeft = 99
            RETURN
        END IF
        FOR x AS INTEGER = SHIP_COL - 1 TO SHIP_COL + 3
            SELF.kind[x] = 0
            SELF.dir[x] = 0
            SELF.pos[x] = 0
            SELF.ceil[x] = 2
            SELF.floor[x] = 3
        END FOR
        SELF.shipY = 8
        SELF.safe = 8
        IF SELF.fuel < 60 THEN
            SELF.fuel = 60
        END IF
        IF SELF.smart < 1 THEN
            SELF.smart = 1
        END IF
        SELF.Flash("SHIP LOST")
    END FUNCTION

    PRIVATE FUNCTION Surface(x AS INTEGER) AS INTEGER
        RETURN ROWS - SELF.floor[x] - 1
    END FUNCTION

    PRIVATE FUNCTION Fill(x AS INTEGER, n AS INTEGER) AS VOID
        LET z AS INTEGER = (n DIV ZONE) % 4
        SELF.ceil[x] = SELF.Ceiling(n, z)
        SELF.floor[x] = SELF.Flooring(n, z)
        SELF.kind[x] = 0
        SELF.pos[x] = 0
        SELF.dir[x] = 0
        IF SELF.Surface(x) <= SELF.ceil[x] + 1 THEN
            RETURN
        END IF
        IF z = 3 AND (n % ZONE) = ZONE - 2 THEN
            SELF.kind[x] = KIND_BASE
            RETURN
        END IF
        IF z = 1 AND (n % 16) = 8 THEN
            SELF.kind[x] = KIND_SITE
            RETURN
        END IF
        IF (z = 0 OR z = 3) AND (n % 11) = 0 THEN
            SELF.kind[x] = KIND_ROCKET
            RETURN
        END IF
        IF z = 1 AND (n % 8) = 0 THEN
            SELF.PlaceUfo(x, n)
            RETURN
        END IF
        IF z = 2 AND (n % 6) = 0 THEN
            SELF.PlaceMeteor(x, n)
            RETURN
        END IF
        IF z = 2 AND (n % 15) = 0 THEN
            SELF.kind[x] = KIND_ROCKET
            RETURN
        END IF
        IF (n % 9) = 0 THEN
            SELF.kind[x] = KIND_FUEL
        END IF
    END FUNCTION

    PRIVATE FUNCTION PlaceUfo(x AS INTEGER, n AS INTEGER) AS VOID
        LET top AS INTEGER = SELF.ceil[x] + 1
        LET bot AS INTEGER = SELF.Surface(x) - 1
        SELF.kind[x] = KIND_UFO
        SELF.pos[x] = top + ((bot - top) DIV 2)
        IF (n % 2) = 0 THEN
            SELF.dir[x] = -1
        ELSE
            SELF.dir[x] = 1
        END IF
    END FUNCTION

    PRIVATE FUNCTION PlaceMeteor(x AS INTEGER, n AS INTEGER) AS VOID
        LET top AS INTEGER = SELF.ceil[x] + 1
        LET bot AS INTEGER = SELF.Surface(x) - 1
        LET span AS INTEGER = bot - top + 1
        IF span < 1 THEN
            RETURN
        END IF
        SELF.kind[x] = KIND_METEOR
        SELF.pos[x] = top + (n % span)
    END FUNCTION

    // Zone 0 missiles: low ceiling, gentle floor.
    // Zone 1 cavern: ceiling and floor close in.
    // Zone 2 meteors: open sky, rocks in the gap.
    // Zone 3 fortress: lower ceiling, high floor, a base at the end.
    PRIVATE FUNCTION Ceiling(n AS INTEGER, z AS INTEGER) AS INTEGER
        LET w AS INTEGER = n % 12
        IF z = 0 THEN
            RETURN 2 + (w DIV 6)
        ELSE IF z = 1 THEN
            RETURN 4 + (w % 5)
        ELSE IF z = 2 THEN
            RETURN 3
        END IF
        RETURN 3 + (w DIV 3)
    END FUNCTION

    PRIVATE FUNCTION Flooring(n AS INTEGER, z AS INTEGER) AS INTEGER
        LET w AS INTEGER = (n + 3) % 12
        IF z = 0 THEN
            RETURN 3 + (w DIV 6)
        ELSE IF z = 1 THEN
            RETURN 4 + ((w + 1) % 5)
        ELSE IF z = 2 THEN
            RETURN 3 + (w DIV 6)
        END IF
        RETURN 5
    END FUNCTION

    PRIVATE FUNCTION ZoneName() AS STRING
        LET z AS INTEGER = ((SELF.origin + SHIP_COL) DIV ZONE) % 4
        IF z = 0 THEN
            RETURN "Z1 MISSILES"
        ELSE IF z = 1 THEN
            RETURN "Z2 CAVERN"
        ELSE IF z = 2 THEN
            RETURN "Z3 METEORS"
        END IF
        RETURN "Z4 FORTRESS"
    END FUNCTION

    PRIVATE FUNCTION Status() AS STRING
        LET line AS STRING = "SC " + Digits(SELF.score, 5)
        line = line + " SH " + Digits(SELF.ships, 1)
        line = line + " SM " + Digits(SELF.smart, 1)
        line = line + " " + SELF.ZoneName()
        RETURN Fit(line, COLS)
    END FUNCTION

    PRIVATE FUNCTION FuelLine() AS STRING
        LET cells AS INTEGER = 21
        LET filled AS INTEGER = (SELF.fuel * cells) DIV 100
        LET bar AS STRING = ""
        FOR i AS INTEGER = 0 TO cells - 1
            IF i < filled THEN
                bar = bar + "#"
            ELSE
                bar = bar + "-"
            END IF
        END FOR
        RETURN Fit("FUEL [" + bar + "] " + Digits(SELF.fuel, 3), COLS)
    END FUNCTION

    PRIVATE FUNCTION Banner() AS STRING
        IF SELF.noteLeft > 0 THEN
            RETURN Fit(SELF.note, COLS)
        END IF
        RETURN Fit(SELF.ZoneName(), COLS)
    END FUNCTION

    PRIVATE FUNCTION RowText(y AS INTEGER) AS STRING
        LET line AS STRING = ""
        FOR x AS INTEGER = 0 TO COLS - 1
            line = line + SELF.Glyph(x, y)
        END FOR
        RETURN line
    END FUNCTION

    PRIVATE FUNCTION Glyph(x AS INTEGER, y AS INTEGER) AS STRING
        IF x = SHIP_COL AND y = SELF.shipY THEN
            IF SELF.hit OR SELF.over THEN
                RETURN "X"
            END IF
            RETURN ">"
        END IF
        IF SELF.shot AND x = SELF.shotX AND y = SELF.shotY THEN
            RETURN "-"
        END IF
        IF SELF.bomb AND x = SELF.bombX AND y = SELF.bombY THEN
            RETURN "o"
        END IF
        IF SELF.kind[x] = KIND_METEOR AND y = SELF.pos[x] THEN
            RETURN "*"
        END IF
        IF SELF.kind[x] = KIND_UFO AND y = SELF.pos[x] THEN
            RETURN "O"
        END IF
        IF SELF.kind[x] = KIND_ROCKET AND SELF.dir[x] = 1 AND y = SELF.pos[x] THEN
            RETURN "!"
        END IF
        IF y = SELF.Surface(x) THEN
            IF SELF.kind[x] = KIND_FUEL THEN
                RETURN "F"
            ELSE IF SELF.kind[x] = KIND_ROCKET AND SELF.dir[x] = 0 THEN
                RETURN "^"
            ELSE IF SELF.kind[x] = KIND_SITE THEN
                RETURN "U"
            ELSE IF SELF.kind[x] = KIND_BASE THEN
                RETURN "B"
            END IF
        END IF
        IF y < SELF.ceil[x] OR y >= ROWS - SELF.floor[x] THEN
            RETURN "#"
        END IF
        RETURN "."
    END FUNCTION
END CLASS

FUNCTION PlayLine(game AS Scramble, line AS STRING) AS VOID
    IF LEN(line) = 0 THEN
        game.Step(".")
        RETURN
    END IF
    FOR i AS INTEGER = 0 TO LEN(line) - 1
        IF game.Over() THEN
            EXIT FOR
        END IF
        LET key AS STRING = TOLOWER(line[i])
        IF key = "q" THEN
            EXIT FOR
        END IF
        game.Step(key)
    END FOR
END FUNCTION

FUNCTION RunDemo(game AS Scramble, frames AS INTEGER, pace AS INTEGER, show AS BOOLEAN) AS VOID
    LET script AS STRING = DEMO_SCRIPT
    LET n AS INTEGER = frames
    IF n < 1 THEN
        n = 1
    END IF
    LET f AS INTEGER = 0
    WHILE f < n AND NOT game.Over()
        LET key AS STRING = "."
        IF f < LEN(script) THEN
            key = script[f]
        END IF
        game.Step(key)
        IF show THEN
            game.Draw(FALSE, TRUE)
            SleepMs(pace)
        END IF
        f += 1
    END WHILE
    PRINT game.Report(TRUE)
END FUNCTION

FUNCTION RunPlay(game AS Scramble, pace AS INTEGER) AS VOID
    PRINT "BN Scramble. Type a string of keys and press Enter. q quits."
    WHILE NOT game.Over()
        game.Draw(TRUE, FALSE)
        LET raw AS STRING OR EOF = INPUT()
        IF raw IS EOF THEN
            EXIT WHILE
        ELSE IF raw = "q" OR raw = "Q" THEN
            EXIT WHILE
        ELSE
            PlayLine(game, raw)
            IF pace > 0 THEN
                game.Draw(TRUE, FALSE)
                SleepMs(pace)
            END IF
        END IF
    END WHILE
    game.Draw(TRUE, FALSE)
    PRINT game.Report(FALSE)
END FUNCTION

FUNCTION Start() AS INTEGER
    LET demo AS BOOLEAN = FALSE
    LET frames AS INTEGER = 32
    LET pace AS INTEGER = 0
    LET show AS BOOLEAN = TRUE
    LET i AS INTEGER = 1
    WHILE i < LEN(HOST.Args)
        LET arg AS STRING = HOST.Args[i]
        IF arg = "--help" OR arg = "-h" THEN
            Usage()
            RETURN 0
        ELSE IF arg = "--demo" THEN
            demo = TRUE
        ELSE IF arg = "--quiet" THEN
            show = FALSE
        ELSE IF arg = "--frames" OR arg = "--pace" THEN
            IF i + 1 >= LEN(HOST.Args) THEN
                Usage()
                RETURN 1
            END IF
            i += 1
            LET n AS INTEGER = Math.VAL(HOST.Args[i]) AS INTEGER
            IF arg = "--frames" THEN
                frames = n
            ELSE
                pace = n
            END IF
        ELSE
            Usage()
            RETURN 1
        END IF
        i += 1
    END WHILE

    LET game AS Scramble = NEW Scramble()
    IF demo THEN
        RunDemo(game, frames, pace, show)
    ELSE
        RunPlay(game, pace)
    END IF
    RELEASE game
    RETURN 0
END FUNCTION
