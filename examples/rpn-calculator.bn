// Reverse Polish notation calculator.
// Enter one token per line: digits 0 to 9, +, -, *, /, =, or Q.

CLASS RpnCalculator

    PRIVATE stack AS FLOAT[256]
    PRIVATE top AS INTEGER = 0

    PUBLIC CONSTRUCTOR()
    END CONSTRUCTOR

    PUBLIC FUNCTION Process(token AS STRING) AS VOID
        IF token = "=" THEN
            ShowResult()
        ELSE IF token = "+" OR token = "-" OR token = "*" OR token = "/" THEN
            Apply(token)
        ELSE
            PushNumber(token)
        END IF
    END FUNCTION

    PRIVATE FUNCTION PushNumber(token AS STRING) AS VOID
        LET value AS FLOAT OR Error = Float.TryParse(token)

        IF value IS Error THEN
            PRINT value.Message
        ELSE
            Push(value)
        END IF
    END FUNCTION

    PRIVATE FUNCTION Push(value AS FLOAT) AS VOID
        IF top = 256 THEN
            PRINT "Stack overflow"
        ELSE
            stack[top] = value
            top += 1
        END IF
    END FUNCTION

    PRIVATE FUNCTION Pop() AS FLOAT
        top -= 1
        RETURN stack[top]
    END FUNCTION

    PRIVATE FUNCTION Apply(symbol AS STRING) AS VOID
        IF top < 2 THEN
            PRINT "Two values are required"
        ELSE
            LET right AS FLOAT = Pop()
            LET left AS FLOAT = Pop()

            IF symbol = "+" THEN
                Push(left + right)
            ELSE IF symbol = "-" THEN
                Push(left - right)
            ELSE IF symbol = "*" THEN
                Push(left * right)
            ELSE IF right = 0.0 THEN
                PRINT "Division by zero"
                Push(left)
                Push(right)
            ELSE
                Push(left / right)
            END IF
        END IF
    END FUNCTION

    PRIVATE FUNCTION ShowResult() AS VOID
        IF top <> 1 THEN
            PRINT "The expression is incomplete"
        ELSE
            PRINT stack[0]
        END IF
    END FUNCTION

END CLASS

FUNCTION Start() AS VOID
    LET calculator AS RpnCalculator = NEW RpnCalculator()
    LET running AS BOOLEAN = TRUE

    PRINT "RPN calculator: 3, 4, +, 2, *, =. Enter Q to quit."

    WHILE running
        LET token AS STRING OR EOF = INPUT()

        IF token IS EOF THEN
            running = FALSE
        ELSE IF token = "Q" THEN
            running = FALSE
        ELSE
            calculator.Process(token)
        END IF
    END WHILE

    DELETE calculator
END FUNCTION
