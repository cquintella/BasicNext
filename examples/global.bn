CLASS Library
    PUBLIC STATIC shared AS INTEGER
    PUBLIC STATIC anotherShared AS STRING
END CLASS

FUNCTION lesser(num1 AS INTEGER, num2 AS INTEGER) AS BOOLEAN
    RETURN num1 < num2
END FUNCTION

FUNCTION Start() AS VOID
    Library.shared = 10
    PRINT lesser(Library.shared, 20)
END FUNCTION
