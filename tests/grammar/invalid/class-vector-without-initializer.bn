// A vector of a class has no default: `LET v AS Box[2]` needs `=` (0.6.md,
// defaults; BDFL, 2026-10-07).


CLASS Box
    PUBLIC FUNCTION CONSTRUCTOR()
    END FUNCTION
END CLASS

FUNCTION Start() AS VOID
    LET v AS Box[2]
END FUNCTION
