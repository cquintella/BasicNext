// Ed25519 and ECDSA P-256. Both sign deterministically, so the Ed25519 key and
// signature below are byte-exact against python-cryptography. P-256 signatures
// are compared by verification rather than by bytes.

IMPORT BNCrypto AS Crypto

FUNCTION Start() AS VOID
    LET seed AS Crypto.Bytes = Crypto.FromText("0123456789abcdef0123456789abcdef")
    LET edKey AS Crypto.Key OR Error = Crypto.ImportKey(seed, Crypto.ALG_ED25519)
    LET p256Key AS Crypto.Key OR Error = Crypto.ImportKey(seed, Crypto.ALG_ECDSA_P256)
    LET message AS Crypto.Bytes = Crypto.FromText("abc")
    LET other AS Crypto.Bytes = Crypto.FromText("abd")

    IF edKey IS Error THEN
        PRINT "ed-key-failed"
    ELSE
        LET publicKey AS Crypto.Bytes OR Error = Crypto.Ed25519PublicKey(edKey)
        IF publicKey IS Error THEN
            PRINT "ed-key-failed"
        ELSE
            PRINT publicKey.ToHex()
            LET signature AS Crypto.Bytes OR Error = Crypto.Ed25519Sign(edKey, message)
            IF signature IS Error THEN
                PRINT "ed-sign-failed"
            ELSE
                PRINT signature.ToHex()
                PRINT Crypto.Ed25519Verify(publicKey, message, signature)
                PRINT Crypto.Ed25519Verify(publicKey, other, signature)
            END IF
        END IF
    END IF

    IF p256Key IS Error THEN
        PRINT "p256-key-failed"
    ELSE
        LET p256Public AS Crypto.Bytes OR Error = Crypto.EcdsaP256PublicKey(p256Key)
        IF p256Public IS Error THEN
            PRINT "p256-key-failed"
        ELSE
            PRINT p256Public.Length()
            LET p256Signature AS Crypto.Bytes OR Error = Crypto.EcdsaP256Sign(p256Key, message)
            IF p256Signature IS Error THEN
                PRINT "p256-sign-failed"
            ELSE
                PRINT Crypto.EcdsaP256Verify(p256Public, message, p256Signature)
                PRINT Crypto.EcdsaP256Verify(p256Public, other, p256Signature)
            END IF
        END IF
    END IF
END FUNCTION
