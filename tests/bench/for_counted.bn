// bni benchmark (bucket 0.6.10 F.0): a counted FOR of 2 000 000 additions.
FUNCTION Start() AS VOID
    LET s AS INTEGER = 0
    FOR i AS INTEGER = 1 TO 2000000
        s = s + 1
    END FOR
    PRINT s
END FUNCTION
