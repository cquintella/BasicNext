// The same text read from a file, not recognized as a header.
IMPORT HOST.FileSystem AS FS

FUNCTION Start() AS VOID
    LET f AS FS.File OR Error = FS.Open(HOST.Args[1], FS.READ)
    IF f IS FS.File THEN
        LET all AS STRING OR Error = f.ReadAll()
        IF all IS STRING THEN
            PRINT LEN(all)
        END IF
        f.Close()
    END IF
END FUNCTION
